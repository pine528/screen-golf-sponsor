// Screen Golf Sponsor Marketplace - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication
// ============================================

enum UserRole {
  BRAND
  ATHLETE
  ADMIN
  FAN
  FINANCE // 재무/출금 관리 권한
  SUPPORT // 고객지원 (읽기 전용)
  AUDITOR // 감사 (읽기 전용)
  AGENCY // 에이전시 (선수 대리 관리)
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  pointBalance Int      @default(0) @map("point_balance")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  brand                Brand?
  athlete              Athlete?
  admin                Admin?
  fan                  Fan?
  agency               Agency?
  auditLogs            AuditLog[]
  pointLedgers         PointLedger[]
  pointWallet          PointWallet?
  pointLedgerTxs       PointLedgerTx[]   @relation("PointLedgerTxs")
  redemptionOrders     RedemptionOrder[]
  pointTransfersFrom   PointTransfer[]   @relation("PointTransferFrom")
  pointTransfersTo     PointTransfer[]   @relation("PointTransferTo")
  pointTopups          PointTopup[]
  donationsSent        Donation[]        @relation("DonationFrom")
  pointWithdrawals     PointWithdrawal[] @relation("PointWithdrawals")
  processedWithdrawals PointWithdrawal[] @relation("ProcessedPointWithdrawals")
  communityPosts       AthleteCommunityPost[] @relation("CommunityPosts")
  communityComments    CommunityComment[]     @relation("CommunityComments")
  communityLikes       CommunityLike[]        @relation("CommunityLikes")
  fanBrandSuggestions  FanBrandSuggestion[]   @relation("FanBrandSuggestions")
  temperatureEvents    FanTemperatureEvent[]  @relation("FanTemperatureEvents")

  // 본인인증 정보
  realName               String?   @map("real_name")
  phone                  String?   @unique
  birthDate              DateTime? @map("birth_date")
  certificationUniqueKey String?   @unique @map("cert_unique_key")
  certifiedAt            DateTime? @map("certified_at")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// ============================================
// Brand (Advertiser)
// ============================================

model Brand {
  id           String    @id @default(uuid())
  userId       String    @unique @map("user_id")
  name         String
  bizNo        String?   @map("biz_no")
  category     String
  contactEmail String    @map("contact_email")
  contactPhone String?   @map("contact_phone")
  contactName  String?   @map("contact_name")
  website      String?
  description  String?
  address      String?
  kycStatus    KycStatus @default(NOT_SUBMITTED) @map("kyc_status")
  kycDocuments Json?     @map("kyc_documents")
  penaltyScore Int       @default(0) @map("penalty_score")
  // AI 심층매칭 v3 — 승인된 Brand Profile snapshot (§9.1). approved=true인 값만 매칭 Feature로 사용
  matchProfile Json?     @map("match_profile")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user              User                         @relation(fields: [userId], references: [id])
  bids              Bid[]
  contracts         Contract[]
  proposals         Proposal[]
  deliverables      Deliverable[]
  campaigns         Campaign[]
  payments          Payment[]
  favoritedBy       FavoriteBrand[]
  billingProfile    BillingProfile?
  creativeApprovals BrandEventCreativeApproval[]

  // ROI Settings
  keywords          String[] @default([])
  competitors       String[] @default([])
  blockedCategories String[] @default([]) @map("blocked_categories")

  // ROI Report Dashboard relations
  logoTemplates  LogoTemplate[]
  logoDetections LogoDetection[]
  roiExposures   RoiExposure[]

  // Full Funnel relations
  promoCodes    PromoCode[]
  trackingLinks TrackingLink[]
  miniStores    MiniStore[]
  funnelEvents  FunnelEvent[]
  funnelOrders  FunnelOrder[]
  pixelInstall  PixelInstall?

  @@map("brands")
}

// ============================================
// Athlete (Player)
// ============================================

model Athlete {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  name              String
  realName          String?   @map("real_name")
  tour              String
  profileImageUrl   String?   @map("profile_image_url")
  bio               String?
  socialLinks       Json?     @map("social_links")
  primarySponsors   Json?     @map("primary_sponsors")
  blockedCategories String[]  @map("blocked_categories")
  // SPONPIK 론칭 4. 권장 데이터 항목 — 구조화 필드
  height            Int? // 신장 (cm)
  region            String? // 출신/거주 지역
  debutYear         Int?      @map("debut_year") // 데뷔 연도 (예: 2018)
  affiliation       String? // 소속팀/소속사 (tour와 별개의 소속) — 프로필 '소속' 항목
  // SPONPIK 선수 프로필 구조화 — bio 줄글을 항목별로 분리 (소속=affiliation / 학력 / 수상 / 경력)
  education         String? // 학력 (예: 공주대 교육대학원 석사 · 중등 2급 정교사(체육))
  awards            String? // 수상 (예: 대전광역시장배 준우승 · KPGA 프론티어투어 4위)
  career            String? // 경력 (예: 전 GDR아카데미 대전스마트시티점 프로)
  // 2026-07 선수화면 개편 — 엑셀 프로필 양식 기반 확장 필드
  birthDate         String?   @map("birth_date") // 생년월일 표기 (예: 1996.07.30)
  birthplace        String? // 출신지역 (region=거주지와 구분)
  weight            Int? // 체중 (kg)
  tourQualification String?   @map("tour_qualification") // 투어 자격 (예: KPGA TOUR PRO, KLPGA 정회원)
  activityFields    Json?     @map("activity_fields") // 현재 활동분야 {tour1,gtour,lesson,proAm,sns,youtube,tour2,etc}
  highlights        Json? // 주요 이력 bullet 배열 (string[])
  snsStats          Json?     @map("sns_stats") // {instagramFollowers, youtubeChannel, youtubeSubs} (원문 문자열)
  sponsorSlots      Json?     @map("sponsor_slots") // 엑셀 후원가능 슬롯 {슬롯명: bool} (9월 대회 경매용)
  sizes             Json? // {hat, top, glove, shoe} (협찬 제작용)
  // 추천 선수 노출 (2026-07 항목2 — 운영 지정 리스트만 추천 캐러셀/메인 노출)
  isRecommended     Boolean   @default(false) @map("is_recommended")
  recommendOrder    Int?      @map("recommend_order") // 추천 정렬 (낮을수록 먼저)
  // 선수가 직접 프로필을 수정한 시각 (운영 일괄 작업은 반영하지 않음 — 목록의 UPDATE 뱃지 기준)
  profileUpdatedAt  DateTime? @map("profile_updated_at")
  sportType         String?   @map("sport_type") // 종목 (Sport.code 참조; 1차: GOLF/SCREEN_GOLF)
  sportId           String?   @map("sport_id")
  isActive          Boolean   @default(true) @map("is_active") // 운영 활성/비활성 (관리자 토글, docx 4. status)
  kycStatus         KycStatus @default(NOT_SUBMITTED) @map("kyc_status")
  kycDocuments      Json?     @map("kyc_documents")
  bankAccount       Json?     @map("bank_account")
  taxInfo           Json?     @map("tax_info")
  agencyId          String?   @map("agency_id")
  agencyAssignedAt  DateTime? @map("agency_assigned_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user                User                   @relation(fields: [userId], references: [id])
  agency              Agency?                @relation(fields: [agencyId], references: [id])
  sport               Sport?                 @relation(fields: [sportId], references: [id])
  slotInstances       SlotInstance[]
  contracts           Contract[]
  applicationItems    ApplicationItem[]
  digitalInventories  AthleteDigitalInventory[]
  digitalApplications DigitalApplication[]
  communityPosts      AthleteCommunityPost[]
  brandSuggestions    FanBrandSuggestion[]
  temperatureEvents   FanTemperatureEvent[]
  offerProducts       AthleteOfferProduct[]
  directPickItems     DirectPickItem[]
  offerAthletes       OfferAthlete[]
  tempSnapshots       FanTemperatureSnapshot[]
  fanContributions    FanContribution[]
  fanLetters          FanLetter[]
  fanStores           FanStore[]
  proposals           Proposal[]
  deliverables        Deliverable[]
  eventParticipations EventParticipation[]
  payoutItems         PayoutItem[]
  favoritedBy         FavoriteAthlete[]
  withdrawalRequests  WithdrawalRequest[]
  donationsReceived   Donation[]
  agencyRequests      AgencyAthleteRequest[]
  eventResults        AthleteEventResult[] // GTOUR 등 외부 경기결과 (docx 3-6)

  // Full Funnel relations
  promoCodes    PromoCode[]
  trackingLinks TrackingLink[]
  funnelEvents  FunnelEvent[]
  funnelOrders  FunnelOrder[]

  // SNS 연동 (Phase 2)
  youtubeChannel YoutubeChannel?
  mentions       AthleteMention[]

  // ROI 자동/수동 수집 (docx §6 C-1, C-3 미구현 항목 보강)
  mediaExposures    AthleteMediaExposure[]
  followerSnapshots AthleteFollowerSnapshot[]
  newsArticles      AthleteNewsArticle[]

  // 2026-07 개편 Phase 1 — 슬롯 인벤토리·후원상품
  athleteSlots        AthleteSlot[]
  sponsorshipProducts SponsorshipProduct[]

  @@map("athletes")
}

// ============================================
// Agency (에이전시 - 선수 대리 관리)
// ============================================

model Agency {
  id           String    @id @default(uuid())
  userId       String    @unique @map("user_id")
  name         String
  bizNo        String?   @map("biz_no")
  contactEmail String    @map("contact_email")
  contactPhone String?   @map("contact_phone")
  contactName  String?   @map("contact_name")
  website      String?
  description  String?
  kycStatus    KycStatus @default(NOT_SUBMITTED) @map("kyc_status")
  kycDocuments Json?     @map("kyc_documents")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user            User                   @relation(fields: [userId], references: [id])
  athletes        Athlete[]
  athleteRequests AgencyAthleteRequest[]

  @@map("agencies")
}

// ============================================
// Agency-Athlete Connection Request
// ============================================

enum AgencyAthleteRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AgencyAthleteRequest {
  id             String                     @id @default(uuid())
  agencyId       String                     @map("agency_id")
  athleteId      String                     @map("athlete_id")
  status         AgencyAthleteRequestStatus @default(PENDING)
  message        String?
  rejectedReason String?                    @map("rejected_reason")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  respondedAt    DateTime?                  @map("responded_at")

  agency  Agency  @relation(fields: [agencyId], references: [id])
  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@index([athleteId, status])
  @@index([agencyId, status])
  @@map("agency_athlete_requests")
}

// ============================================
// Admin
// ============================================

model Admin {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  name        String
  department  String?
  permissions Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("admins")
}

// ============================================
// Fan (General User)
// ============================================

model Fan {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  nickname  String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                      User                       @relation(fields: [userId], references: [id])
  favoriteAthletes          FavoriteAthlete[]
  favoriteBrands            FavoriteBrand[]
  brandRegistrationRequests BrandRegistrationRequest[]

  @@map("fans")
}

// ============================================
// Fan Favorites
// ============================================

model FavoriteAthlete {
  id        String   @id @default(uuid())
  fanId     String   @map("fan_id")
  athleteId String   @map("athlete_id")
  createdAt DateTime @default(now()) @map("created_at")

  fan     Fan     @relation(fields: [fanId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([fanId, athleteId])
  @@map("favorite_athletes")
}

model FavoriteBrand {
  id        String   @id @default(uuid())
  fanId     String   @map("fan_id")
  brandId   String   @map("brand_id")
  createdAt DateTime @default(now()) @map("created_at")

  fan   Fan   @relation(fields: [fanId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([fanId, brandId])
  @@map("favorite_brands")
}

// ============================================
// Brand Registration Request (Fan -> Brand)
// ============================================

enum BrandRegistrationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model BrandRegistrationRequest {
  id           String                  @id @default(uuid())
  fanId        String                  @map("fan_id")
  brandName    String                  @map("brand_name")
  contactEmail String                  @map("contact_email")
  contactPhone String?                 @map("contact_phone")
  website      String?
  note         String?
  status       BrandRegistrationStatus @default(SUBMITTED)
  adminNote    String?                 @map("admin_note")
  reviewedBy   String?                 @map("reviewed_by")
  reviewedAt   DateTime?               @map("reviewed_at")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  fan Fan @relation(fields: [fanId], references: [id])

  @@map("brand_registration_requests")
}

// ============================================
// Sport (종목 카테고리 - SPONPIK 1차: 골프/스크린골프, 향후 확장)
// ============================================

model Sport {
  id           String   @id @default(uuid())
  code         String   @unique // GOLF / SCREEN_GOLF / BASEBALL / SOCCER / VOLLEYBALL ...
  name         String // "골프", "스크린골프", "야구", "축구", "배구" ...
  parentCode   String?  @map("parent_code") // 상위 카테고리 (예: SCREEN_GOLF -> GOLF)
  description  String?
  iconUrl      String?  @map("icon_url")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  athletes Athlete[]
  events   Event[]

  @@index([parentCode])
  @@index([isActive, displayOrder])
  @@map("sports")
}

// ============================================
// Event (Tournament/Broadcast)
// ============================================

model Event {
  id               String      @id @default(uuid())
  tour             String
  name             String
  description      String?
  dateStart        DateTime    @map("date_start")
  dateEnd          DateTime    @map("date_end")
  broadcastEpisode String?     @map("broadcast_episode")
  multiplier       Float       @default(1.0)
  venue            String?
  status           EventStatus @default(UPCOMING)
  // SPONPIK 론칭 3-2/3-3 — 대회 카테고리/예선/표시순서/관리자 활성화 토글
  category         String? // 정규투어 / 시드전 / 드림투어 / 점프투어 / 챔피언스 / 친선전 등
  qualifyingDate   DateTime?   @map("qualifying_date") // 예선 일자
  displayOrder     Int         @default(0) @map("display_order") // 노출 우선순위 (낮을수록 상단)
  isActive         Boolean     @default(true) @map("is_active") // 관리자 활성화 토글
  activeDays       Int?        @map("active_days") // 슬롯 활성화 N일 (관리자 우선)
  sportId          String?     @map("sport_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  // v2 Tournament Rules (JSON)
  // {
  //   chestReservedSide: "LEFT"|"RIGHT"|"NONE",
  //   sleeveReservedSide: "LEFT"|"RIGHT"|"NONE",
  //   reservedSlotCodes: string[],
  //   disabledSlotCodes: string[],
  //   phase2UnlockPolicy: "ALL_PHASE1_EFFECTIVE_SLOTS_FILLED",
  //   phase2UnlockMode: "AUTO"|"ADMIN_APPROVE",
  //   phase2EligibleMinDaysBefore: number,
  //   creativeApprovalRequired: boolean,
  //   prohibitedCategories: string[],
  //   maxSlotsPerBrandPerPlayer: number
  // }
  tournamentRules Json? @map("tournament_rules")

  slotInstances     SlotInstance[]
  participations    EventParticipation[]
  creativeApprovals BrandEventCreativeApproval[]
  vodAssets         VodAsset[]
  sport             Sport?                       @relation(fields: [sportId], references: [id])

  @@index([isActive, displayOrder])
  @@index([sportId, dateStart])
  @@map("events")
}

enum EventStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

model EventParticipation {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  athleteId String   @map("athlete_id")
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  event   Event   @relation(fields: [eventId], references: [id])
  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@unique([eventId, athleteId])
  @@map("event_participations")
}

// ============================================
// Slot Template & Instance
// ============================================

// ⚠️ 값 순서는 운영 DB(pg_enum)와 동일해야 함 — db push가 enum 재생성을 시도하지 않도록
//    새 값은 반드시 "맨 끝에" 추가할 것 (ALTER TYPE ADD VALUE는 끝에 붙음)
enum BodyPart {
  // Legacy (backward compatibility)
  SHIRT_CHEST_LEFT
  SHIRT_CHEST_RIGHT
  SHIRT_SLEEVE_LEFT
  SHIRT_SLEEVE_RIGHT
  CAP_SIDE_LEFT
  CAP_BACK
  PANTS_BELT
  SHIRT_BACK
  // CAP (모자)
  CAP_FRONT
  CAP_BRIM_TOP
  CAP_SIDE_L
  CAP_SIDE_R
  // TOP (상의)
  CHEST_L
  CHEST_R
  COLLAR_L
  COLLAR_R
  SLEEVE_L
  SLEEVE_R
  BACK_SHOULDER_L
  BACK_SHOULDER_R
  // PANTS (하의) - Phase 2
  PANTS_HIP_SIDE_FACING
  PANTS_THIGH_SIDE_FACING
  // v2.0 개정 — 어깨라인(쇄골) 좌/우 (A+)
  SHOULDER_LINE_L
  SHOULDER_LINE_R
}

// ⚠️ 값 순서는 운영 DB(pg_enum)와 동일해야 함 — 새 값은 맨 끝에만 추가
enum SlotGrade {
  S
  A
  B
  C
  A_PLUS // A+ (프리미엄 확장 — v2.0 어깨라인)
}

enum SlotCategory {
  CAP
  TOP
  PANTS
}

enum MaterialRule {
  PRINTED_ONLY
  EMBROIDERY_OK
  ANY
}

model SlotTemplate {
  id                         String       @id @default(uuid())
  code                       String       @unique
  name                       String
  bodyPart                   BodyPart     @map("body_part")
  sizeMaxWMm                 Int          @map("size_max_w_mm")
  sizeMaxHMm                 Int          @map("size_max_h_mm")
  perimeterMaxMm             Int          @map("perimeter_max_mm")
  recommendedWMm             Int?         @map("recommended_w_mm")
  recommendedHMm             Int?         @map("recommended_h_mm")
  forbiddenNotes             String?      @map("forbidden_notes")
  materialRules              MaterialRule @default(PRINTED_ONLY) @map("material_rules")
  requiresVerificationPhotos Boolean      @default(true) @map("requires_verification_photos")
  requiredAngles             String[]     @default(["front"]) @map("required_angles")
  categoryExclusivityGroup   String?      @map("category_exclusivity_group")
  defaultReservePrice        Int          @default(100000) @map("default_reserve_price")
  eventOverrideAllowed       Boolean      @default(true) @map("event_override_allowed")
  duration                   Int?         @map("duration") // 노출 시간 (초)
  estimatedImpressions       Int?         @map("estimated_impressions") // 예상 노출 (회)
  isActive                   Boolean      @default(true) @map("is_active")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  // v2 Phase Policy Fields
  phase              Int           @default(1) // 1: 기본 오픈, 2: 조건부 확장
  category           SlotCategory? @map("slot_category") // CAP, TOP, PANTS
  grade              SlotGrade? // S, A, B, C
  nameKr             String?       @map("name_kr") // 한국어 이름
  nameEn             String?       @map("name_en") // 영어 이름
  uiHeadline         String?       @map("ui_headline") // UI 헤드라인 (10-14자)
  uiCopy             String?       @map("ui_copy") // UI 설명 (1문장)
  tags               String[]      @default([]) // 태그 배열
  openRule           String?       @map("open_rule") // 오픈 규칙 설명
  exclusivityGroup   String?       @map("exclusivity_group") // 배타적 그룹 (CHEST, SLEEVE, etc.)
  tournamentReserved Boolean       @default(false) @map("tournament_reserved") // 대회 설정으로 점유 가능 여부
  recSizeMm          String?       @map("rec_size_mm") // 권장 사이즈 (예: "60x30")
  material           String? // 재질 규격
  reserveMinKrw      Int?          @map("reserve_min_krw") // 최소 예약가 (원)
  reserveRecKrw      Int?          @map("reserve_rec_krw") // 권장 예약가 (원)
  reserveReason      String?       @map("reserve_reason") // 예약가 산정 사유
  // 개편 Phase 1 — 슬롯 도식(착장 마커) 좌표 (%) — Phase 2 슬롯 인벤토리 도식용
  displayX           Float?        @map("display_x")
  displayY           Float?        @map("display_y")

  slotInstances SlotInstance[]
  athleteSlots  AthleteSlot[]

  @@map("slot_templates")
}

// 슬롯 판매 방식 (선수가 슬롯별로 선택)
enum SlotSaleMode {
  AUCTION // 경매 방식
  DIRECT // 직접(즉시) 구매 방식
  INQUIRY // 후원가능 슬롯만 오픈 → 스폰픽 협의로 확정 (카카오 상담)
}

enum SlotStatus {
  OPEN
  IN_AUCTION
  RESERVED // 즉시구매 진행 중 (선수 서명 대기)
  SOLD
  CLOSED
}

model SlotInstance {
  id              String       @id @default(uuid())
  eventId         String       @map("event_id")
  athleteId       String       @map("athlete_id")
  slotTemplateId  String       @map("slot_template_id")
  reservePrice    Int          @map("reserve_price")
  status          SlotStatus   @default(OPEN)
  overrideSpecs   Json?        @map("override_specs")
  // SPONPIK 론칭 — 슬롯 표시 보조 필드 (관리자 우선 정책)
  slotName        String?      @map("slot_name") // 노출용 슬롯명 (없으면 SlotTemplate.name 사용)
  slotOrder       Int?         @map("slot_order") // 정렬 순서 (낮을수록 상단)
  isActive        Boolean      @default(true) @map("is_active") // 운영자 비활성화 토글
  // Sale Mode Fields
  enableAuction   Boolean      @default(true) @map("enable_auction")
  enableDirectBuy Boolean      @default(false) @map("enable_direct_buy")
  directBuyPrice  Decimal?     @map("direct_buy_price") @db.Decimal(18, 0)
  auctionMinBid   Decimal?     @map("auction_min_bid") @db.Decimal(18, 0)
  auctionEndAt    DateTime?    @map("auction_end_at")
  // 판매 방식 (선수 선택): AUCTION 경매 / DIRECT 즉시구매 / INQUIRY 슬롯만 오픈 후 스폰픽 협의
  saleMode        SlotSaleMode @default(AUCTION) @map("sale_mode")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  event        Event        @relation(fields: [eventId], references: [id])
  athlete      Athlete      @relation(fields: [athleteId], references: [id])
  slotTemplate SlotTemplate @relation(fields: [slotTemplateId], references: [id])
  auction      Auction?

  @@unique([eventId, athleteId, slotTemplateId])
  @@map("slot_instances")
}

// ============================================
// Auction & Bidding
// ============================================

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  UNSOLD
}

model Auction {
  id                  String        @id @default(uuid())
  slotInstanceId      String        @unique @map("slot_instance_id")
  startAt             DateTime      @map("start_at")
  endAt               DateTime      @map("end_at")
  originalEndAt       DateTime      @map("original_end_at")
  softCloseSec        Int           @default(120) @map("soft_close_sec")
  maxExtensionSec     Int           @default(600) @map("max_extension_sec")
  totalExtended       Int           @default(0) @map("total_extended")
  minBidIncrement     Int           @default(10000) @map("min_bid_increment")
  // §12.5 첫 유효입찰 이후에도 즉시구매를 유지할지 (관리자 예외 설정)
  allowBuyNowAfterBid Boolean       @default(false) @map("allow_buy_now_after_bid")
  currentPrice        Int           @default(0) @map("current_price")
  status              AuctionStatus @default(SCHEDULED)
  winningBidId        String?       @map("winning_bid_id")
  isFeatured          Boolean       @default(false) @map("is_featured")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  slotInstance SlotInstance @relation(fields: [slotInstanceId], references: [id])
  bids         Bid[]
  contract     Contract?

  @@map("auctions")
}

model Bid {
  id           String   @id @default(uuid())
  auctionId    String   @map("auction_id")
  brandId      String   @map("brand_id")
  maxBid       Int      @map("max_bid")
  currentProxy Int      @map("current_proxy")
  autoBid      Boolean  @default(true) @map("auto_bid")
  isWinning    Boolean  @default(false) @map("is_winning")
  frozenAmount Decimal? @map("frozen_amount") @db.Decimal(18, 0) // 동결 금액 (최고 입찰자만)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  auction Auction @relation(fields: [auctionId], references: [id])
  brand   Brand   @relation(fields: [brandId], references: [id])

  @@unique([auctionId, brandId])
  @@map("bids")
}

// ============================================
// Contract & Creative Assets
// ============================================

enum ContractStatus {
  PENDING_SIGNATURE
  ACTIVE
  ASSET_PENDING
  ASSET_APPROVED
  VERIFICATION_PENDING
  VERIFIED
  COMPLETED
  CANCELLED
}

model Contract {
  id              String         @id @default(uuid())
  auctionId       String         @unique @map("auction_id")
  brandId         String         @map("brand_id")
  athleteId       String         @map("athlete_id")
  priceFinal      Int            @map("price_final")
  status          ContractStatus @default(PENDING_SIGNATURE)
  brandSignedAt   DateTime?      @map("brand_signed_at")
  athleteSignedAt DateTime?      @map("athlete_signed_at")
  signedAt        DateTime?      @map("signed_at")
  assetDeadline   DateTime?      @map("asset_deadline")
  reservedUntil   DateTime?      @map("reserved_until") // Direct Buy 예약 만료 시간
  terms           Json?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  auction           Auction              @relation(fields: [auctionId], references: [id])
  brand             Brand                @relation(fields: [brandId], references: [id])
  athlete           Athlete              @relation(fields: [athleteId], references: [id])
  assets            CreativeAsset[]
  verification      Verification?
  settlement        Settlement?
  payments          Payment[]
  escrow            Escrow?
  fulfillment       ContractFulfillment?
  campaignContracts CampaignContract[]
  exposureRecords   ExposureRecord[]

  @@map("contracts")
}

enum AssetStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model CreativeAsset {
  id            String      @id @default(uuid())
  contractId    String      @map("contract_id")
  fileUrl       String      @map("file_url")
  fileName      String?     @map("file_name")
  fileType      String?     @map("file_type")
  fileSizeBytes Int?        @map("file_size_bytes")
  status        AssetStatus @default(SUBMITTED)
  reviewNotes   String?     @map("review_notes")
  reviewedBy    String?     @map("reviewed_by")
  reviewedAt    DateTime?   @map("reviewed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  contract Contract @relation(fields: [contractId], references: [id])

  @@map("creative_assets")
}

// ============================================
// Pre-Bid Creative Approval (v2)
// 입찰 전 사전 크리에이티브 승인
// ============================================

enum PreApprovalStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model BrandEventCreativeApproval {
  id            String            @id @default(uuid())
  brandId       String            @map("brand_id")
  eventId       String            @map("event_id")
  fileUrl       String            @map("file_url")
  fileName      String?           @map("file_name")
  fileType      String?           @map("file_type")
  fileSizeBytes Int?              @map("file_size_bytes")
  status        PreApprovalStatus @default(SUBMITTED)
  reviewNotes   String?           @map("review_notes")
  reviewedBy    String?           @map("reviewed_by")
  reviewedAt    DateTime?         @map("reviewed_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@unique([brandId, eventId])
  @@map("brand_event_creative_approvals")
}

// ============================================
// Verification (Attachment Proof)
// ============================================

enum VerificationStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

model Verification {
  id              String             @id @default(uuid())
  contractId      String             @unique @map("contract_id")
  photoUrls       String[]           @map("photo_urls")
  angles          String[]
  status          VerificationStatus @default(SUBMITTED)
  verifiedBy      String?            @map("verified_by")
  verifiedAt      DateTime?          @map("verified_at")
  rejectionReason String?            @map("rejection_reason")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  contract Contract @relation(fields: [contractId], references: [id])

  @@map("verifications")
}

// ============================================
// Settlement (Payment)
// ============================================

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

model Settlement {
  id              String           @id @default(uuid())
  contractId      String           @unique @map("contract_id")
  grossAmount     Int              @map("gross_amount")
  platformFee     Int              @map("platform_fee")
  platformFeeRate Float            @map("platform_fee_rate")
  payoutAmount    Int              @map("payout_amount")
  status          SettlementStatus @default(PENDING)
  paidAt          DateTime?        @map("paid_at")
  paymentRef      String?          @map("payment_ref")
  invoiceUrl      String?          @map("invoice_url")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  contract Contract @relation(fields: [contractId], references: [id])

  @@map("settlements")
}

// ============================================
// Campaign (Brand Campaign Management)
// ============================================

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  EXPIRED // 종료일 경과 자동 만료
  GENERATION_FAILED // 자산 자동 생성 실패 (wireframe TABLE 4)
}

model Campaign {
  id                String         @id @default(uuid())
  brandId           String         @map("brand_id")
  name              String
  description       String?
  budget            Int
  spentAmount       Int            @default(0) @map("spent_amount")
  targetCategories  String[]       @map("target_categories")
  excludedAthletes  String[]       @map("excluded_athletes")
  preferredAthletes String[]       @map("preferred_athletes")
  dateStart         DateTime?      @map("date_start")
  dateEnd           DateTime?      @map("date_end")
  status            CampaignStatus @default(DRAFT)

  // KPI 목표
  goalImpressions Int? @map("goal_impressions")
  goalClicks      Int? @map("goal_clicks")
  goalConversions Int? @map("goal_conversions")

  // 예산 추적
  budgetAllocated  Int  @default(0) @map("budget_allocated")
  dailyBudgetLimit Int? @map("daily_budget_limit")

  // 실적 캐시
  actualImpressions Int @default(0) @map("actual_impressions")
  actualClicks      Int @default(0) @map("actual_clicks")

  // 선호 설정
  preferredTours   String[] @map("preferred_tours")
  minAthleteRating Float?   @map("min_athlete_rating")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand     Brand              @relation(fields: [brandId], references: [id])
  contracts CampaignContract[]

  // ROI Report Dashboard relations
  vodAssets     VodAsset[]
  roiExposures  RoiExposure[]
  mediaMentions MediaMention[]
  roiReports    RoiReport[]

  // Full Funnel relations
  promoCodes    PromoCode[]
  trackingLinks TrackingLink[]
  miniStore     MiniStore?
  funnelEvents  FunnelEvent[]
  funnelOrders  FunnelOrder[]

  // Phase 3: Performance-based pricing
  pricingModel CampaignPricingModel @default(FIXED) @map("pricing_model")
  cpaRate      Decimal?             @map("cpa_rate") @db.Decimal(18, 0)
  cpsRate      Decimal?             @map("cps_rate") @db.Decimal(5, 4)

  @@map("campaigns")
}

model CampaignContract {
  id              String   @id @default(uuid())
  campaignId      String   @map("campaign_id")
  contractId      String   @map("contract_id")
  allocatedBudget Int      @map("allocated_budget")
  createdAt       DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id])

  @@unique([campaignId, contractId])
  @@index([contractId])
  @@map("campaign_contracts")
}

// ============================================
// Exposure & Media Value (노출/미디어밸류)
// ============================================

enum ExposureType {
  BROADCAST // 방송 노출
  EVENT_LIVE // 현장 이벤트
  SOCIAL_MEDIA // 소셜 미디어
  PHOTO_PRESS // 사진/보도
  OTHER // 기타
}

model ExposureRecord {
  id                String       @id @default(uuid())
  contractId        String       @map("contract_id")
  exposureType      ExposureType @map("exposure_type")
  impressions       Int          @default(0)
  viewDurationSec   Int?         @map("view_duration_sec")
  reachCount        Int?         @map("reach_count")
  ratePerImpression Decimal?     @map("rate_per_impression") @db.Decimal(10, 4)
  mediaValue        Decimal?     @map("media_value") @db.Decimal(18, 0)
  sourceUrl         String?      @map("source_url")
  description       String?
  recordedAt        DateTime     @map("recorded_at")
  recordedBy        String?      @map("recorded_by")
  createdAt         DateTime     @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id])

  @@index([contractId, recordedAt])
  @@index([exposureType, recordedAt])
  @@map("exposure_records")
}

model MediaValueRate {
  id                String       @id @default(uuid())
  exposureType      ExposureType @map("exposure_type")
  bodyPart          BodyPart?    @map("body_part")
  ratePerImpression Decimal      @map("rate_per_impression") @db.Decimal(10, 4)
  effectiveFrom     DateTime     @map("effective_from")
  effectiveTo       DateTime?    @map("effective_to")
  description       String?
  createdAt         DateTime     @default(now()) @map("created_at")

  @@unique([exposureType, bodyPart, effectiveFrom])
  @@index([effectiveFrom])
  @@map("media_value_rates")
}

// ============================================
// Forbidden Categories
// ============================================

model ForbiddenCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("forbidden_categories")
}

// ============================================
// Category Mapping
// ============================================

model CategoryMapping {
  id               String   @id @default(uuid())
  categoryCode     String   @map("category_code")
  exclusivityGroup String   @map("exclusivity_group")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([categoryCode, exclusivityGroup])
  @@map("category_mappings")
}

// ============================================
// Audit Log
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  metadata   Json? // 추가 메타데이터 (요청 정보, 변경 사유 등)
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ============================================
// Admin Action Log (운영자 액션 멱등성/감사)
// ============================================

model AdminActionLog {
  id             String   @id @default(uuid())
  actorId        String   @map("actor_id") // admin user id
  action         String // ESCROW_RELEASE_MANUAL, ESCROW_REFUND_MANUAL, CONTRACT_CANCEL_MANUAL
  targetType     String   @map("target_type") // ESCROW, CONTRACT
  targetId       String   @map("target_id")
  idempotencyKey String?  @unique @map("idempotency_key")
  requestBody    Json?    @map("request_body")
  result         Json?
  reason         String? // 사유
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_action_logs")
}

// ============================================
// System Settings
// ============================================

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================================
// Notification
// ============================================

enum NotificationType {
  BID_PLACED
  BID_OUTBID
  AUCTION_WON
  AUCTION_LOST
  AUCTION_ENDING_SOON
  CONTRACT_CREATED
  ASSET_SUBMITTED
  ASSET_APPROVED
  ASSET_REJECTED
  VERIFICATION_SUBMITTED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  SETTLEMENT_COMPLETED
  KYC_APPROVED
  KYC_REJECTED
  ADMIN_ALERT
  BRAND_REGISTRATION_SUBMITTED
  BRAND_REGISTRATION_APPROVED
  BRAND_REGISTRATION_REJECTED
  FAN_VOTE_SUBMITTED
  FAN_VOTE_APPROVED
  FAN_VOTE_SETTLED
  FAN_VOTE_WIN
  FAN_VOTE_DELETED
  REDEMPTION_FULFILLED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_PAID
  AGENCY_CONNECTION_REQUEST
  AGENCY_CONNECTION_APPROVED
  AGENCY_CONNECTION_REJECTED
  AGENCY_CONNECTION_CANCELLED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  data      Json?
  payload   Json? // 추가 페이로드 (링크, 액션 버튼 등)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ============================================
// Fee Policy (수수료 정책 관리)
// ============================================

enum FeePolicyType {
  PLATFORM_FEE // 플랫폼 일반 수수료
  SPONSOR_FEE // 스폰서십 수수료
  TRANSACTION_FEE // 거래 수수료
  // FanVote 관련 (레거시)
  FAN_VOTE_OPEN // 팬 투표 개설
  FAN_VOTE_ENTRY // 팬 투표 참여
  FAN_VOTE_SETTLE // 팬 투표 정산
}

model FeePolicy {
  id   String        @id @default(uuid())
  type FeePolicyType

  // 수수료 계산 파라미터
  ratePercent Decimal @map("rate_percent") @db.Decimal(5, 4) // 예: 0.0200 = 2%
  minAmount   Decimal @map("min_amount") @db.Decimal(18, 0) // 최소 금액
  maxAmount   Decimal @map("max_amount") @db.Decimal(18, 0) // 최대 금액

  // Entry Fee 전용: 플랫폼/개설자 배분율
  platformSharePercent Decimal? @map("platform_share_percent") @db.Decimal(5, 4) // 0.7000 = 70%
  creatorSharePercent  Decimal? @map("creator_share_percent") @db.Decimal(5, 4) // 0.3000 = 30%

  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  description   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([type, effectiveFrom])
  @@index([type, isActive, effectiveFrom])
  @@map("fee_policies")
}

// ============================================
// Point System (원장 기반 포인트 시스템)
// ============================================

enum PointTxReason {
  ADMIN_GRANT
  REDEEM_GOODS
  REDEEM_CANCEL_REFUND
  POINT_TRANSFER_SEND // 포인트 전송 (차감)
  POINT_TRANSFER_RECEIVE // 포인트 수신 (적립)
  POINT_TOPUP // 포인트 충전
  POINT_TOPUP_REFUND // 포인트 충전 환불
  DONATION_SEND // 후원 발송 (팬)
  DONATION_RECEIVE // 후원 수신 (선수)
  DONATION_FEE // 후원 수수료 (플랫폼)
  POINT_WITHDRAWAL // 포인트 출금
  // FanVote 레거시 (기존 데이터 호환용 - 삭제 금지)
  VOTE_ENTRY_FEE // 투표 참여비 (레거시)
  VOTE_WIN_PAYOUT // 투표 당첨금 (레거시)
  VOTE_CREATE_FEE // 투표 생성비 (레거시)
  VOTE_OPEN_FEE // 투표 개설비 (레거시)
  VOTE_POT_REMAINDER // 정산 잔여금 (레거시)
  VOTE_CREATOR_PRIZE // 개설자 상금 (레거시)
  VOTE_ENTRY_PLATFORM // 참여비 플랫폼몫 (레거시)
  VOTE_ENTRY_CREATOR // 참여비 개설자몫 (레거시)
  VOTE_SETTLEMENT_FEE // 정산 수수료 (레거시)
  VOTE_REFUND // 투표 환불 (레거시)
  // 리워드풀 기반 무료 투표 시스템
  VOTE_MICRO_REWARD // 참여 시 마이크로 보상
  VOTE_FINAL_REWARD // 정산 시 정답 보상
  REWARD_POOL_DEPOSIT // 풀 충전 (스폰서 수익)
  REWARD_POOL_RETURN // 잔여분 풀 반환
  // 사용자 투표 생성
  VOTE_CREATE_SEED // 투표 생성 시드머니 (차감)
  VOTE_CREATE_SEED_REFUND // 투표 취소 시 시드머니 환불
  // 팬 참여 (커뮤니티·팬레터·브랜드 추천)
  FAN_ENGAGE_REWARD // 팬 참여 활동 적립
}

model PointWallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(18, 0)
  version   Int      @default(0) // 낙관적 락
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_wallets")
}

model PointLedgerTx {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  delta        Decimal       @db.Decimal(18, 0) // +: 적립, -: 차감
  balanceAfter Decimal       @db.Decimal(18, 0)
  reason       PointTxReason
  refType      String        @map("ref_type")
  refId        String        @map("ref_id")
  description  String?
  /// 원장 상태 (§7.4) — PENDING | AVAILABLE | RESERVED | USED | REVERSED | EXPIRED
  status       String        @default("AVAILABLE")
  /// 적립 확정일 + 유효기간 (기본 12개월). 사용·차감 거래는 null
  expiresAt    DateTime?     @map("expires_at")
  confirmedAt  DateTime?     @map("confirmed_at")
  /// 정정·회수 시 원거래 참조 (삭제 대신 상태 전이)
  originalTxId String?       @map("original_tx_id")
  athleteId    String?       @map("athlete_id")
  createdAt    DateTime      @default(now()) @map("created_at")

  user User @relation(name: "PointLedgerTxs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, refType, refId], name: "unique_point_tx")
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("point_ledger_txs")
}

// ============================================
// Point Topup (포인트 충전 - 현금 결제)
// ============================================

enum PointTopupStatus {
  CREATED // 결제 세션 생성됨
  PENDING // PG 결제 진행 중
  PAID // 결제 완료, 포인트 지급됨
  FAILED // 결제 실패
  CANCELED // 사용자 취소
  REFUNDED // 환불 완료
}

model PointTopup {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  // 결제 정보
  amount        Decimal          @db.Decimal(18, 0) // 결제 금액 (원)
  pointsToGrant Decimal          @map("points_to_grant") @db.Decimal(18, 0) // 지급 포인트
  currency      String           @default("KRW")
  status        PointTopupStatus @default(CREATED)

  // PG 연동 정보
  provider           PaymentProvider @default(TOSS)
  providerPaymentKey String?         @unique @map("provider_payment_key")
  providerOrderId    String          @unique @map("provider_order_id")

  // 결제 URL
  checkoutUrl       String?   @map("checkout_url")
  checkoutExpiresAt DateTime? @map("checkout_expires_at")

  // 완료 정보
  paidAt       DateTime? @map("paid_at")
  failedAt     DateTime? @map("failed_at")
  failReason   String?   @map("fail_reason")
  refundedAt   DateTime? @map("refunded_at")
  refundReason String?   @map("refund_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([providerOrderId])
  @@map("point_topups")
}

// Legacy model - to be migrated
model PointLedger {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  amount        Int
  balance       Int
  type          String // VOTE_REWARD, REFERRAL, REDEMPTION, EXPIRED 등
  description   String?
  referenceId   String?  @map("reference_id")
  referenceType String?  @map("reference_type")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("point_ledgers")
}

// ============================================
// Payment System (결제 시스템)
// ============================================

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  VIRTUAL_ACCOUNT
}

model Payment {
  id              String        @id @default(uuid())
  brandId         String        @map("brand_id")
  contractId      String?       @map("contract_id")
  amount          Int
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  pgProvider      String?       @map("pg_provider")
  pgTransactionId String?       @map("pg_transaction_id")
  pgResponse      Json?         @map("pg_response")
  paidAt          DateTime?     @map("paid_at")
  failedAt        DateTime?     @map("failed_at")
  failReason      String?       @map("fail_reason")
  refundedAt      DateTime?     @map("refunded_at")
  refundAmount    Int?          @map("refund_amount")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  brand    Brand     @relation(fields: [brandId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])

  @@map("payments")
}

// ============================================
// Wallet & Escrow System (내부 원장/에스크로)
// ============================================

enum WalletOwnerType {
  BRAND
  ATHLETE
  PLATFORM
}

enum PaymentProvider {
  TOSS
  STRIPE
}

enum TopupPaymentStatus {
  CREATED // Checkout 세션 생성됨
  PENDING // PG로 리다이렉트됨
  PAID // 결제 확인 완료
  FAILED // 결제 실패
  CANCELED // 사용자 취소
  REFUNDED // 환불 완료
  CHARGEBACK // 차지백 발생
}

// Phase 10-2: Refund enums
enum RefundStatus {
  NONE // 환불 없음
  PARTIAL // 부분 환불
  FULL // 전액 환불
}

enum RefundRequestStatus {
  REQUESTED // 관리자가 환불 요청 생성
  APPROVED // 승인됨 (PG 호출 대기)
  REJECTED // 거절됨
  PROCESSING // PG API 호출 중
  REFUNDED // 환불 완료
  FAILED // PG 환불 실패
}

model Wallet {
  id           String          @id @default(uuid())
  ownerType    WalletOwnerType @map("owner_type")
  ownerId      String          @map("owner_id")
  balance      Decimal         @default(0) @db.Decimal(18, 0) // 원 단위 정수, 최대 10^18
  frozenAmount Decimal         @default(0) @map("frozen_amount") @db.Decimal(18, 0)
  version      Int             @default(0) // 낙관적 락용 버전
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  ledgerTxs          LedgerTx[]
  withdrawalRequests WithdrawalRequest[]
  topupPayments      TopupPayment[]
  refundRequests     RefundRequest[]
  // Note: ownerId references Brand or Athlete depending on ownerType
  // No FK constraint - polymorphic relation handled in application code

  @@unique([ownerType, ownerId])
  @@map("wallets")
}

enum LedgerTxType {
  DEPOSIT // 충전
  WITHDRAW // 출금
  ESCROW_HOLD // 에스크로 홀드
  ESCROW_RELEASE // 에스크로 릴리스 (선수에게)
  ESCROW_REFUND // 에스크로 환불 (브랜드에게)
  PLATFORM_FEE // 플랫폼 수수료
  ADJUSTMENT // 수동 조정
  DIRECT_BUY_RESERVE // 즉시구매 예약 동결
  DIRECT_BUY_RESERVE_RELEASE // 즉시구매 예약 해제
  AUCTION_BID_RESERVE // 경매 입찰 동결
  AUCTION_BID_RESERVE_RELEASE // 경매 입찰 해제 (outbid/낙찰/만료)
  TOPUP_DEPOSIT // 충전 결제 완료 시 CREDIT
  TOPUP_REFUND // 충전 환불 시 DEBIT
}

enum LedgerTxStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model LedgerTx {
  id           String         @id @default(uuid())
  walletId     String         @map("wallet_id")
  type         LedgerTxType
  amount       Decimal        @db.Decimal(18, 0) // 양수: 입금, 음수: 출금
  balanceAfter Decimal        @map("balance_after") @db.Decimal(18, 0)
  status       LedgerTxStatus @default(COMPLETED)
  refType      String?        @map("ref_type") // CONTRACT, ESCROW, PAYOUT 등
  refId        String?        @map("ref_id")
  description  String?
  createdAt    DateTime       @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@unique([walletId, type, refType, refId]) // 동일 ref에 대한 중복 트랜잭션 방지
  @@index([walletId, createdAt])
  @@map("ledger_txs")
}

model TopupPayment {
  id          String @id @default(uuid())
  walletId    String @map("wallet_id")
  brandUserId String @map("brand_user_id")
  brandId     String @map("brand_id")

  amount   Decimal            @db.Decimal(18, 0)
  currency String             @default("KRW")
  status   TopupPaymentStatus @default(CREATED)

  provider           PaymentProvider
  providerPaymentKey String?         @unique @map("provider_payment_key")
  providerOrderId    String?         @unique @map("provider_order_id")

  checkoutUrl       String?   @map("checkout_url")
  checkoutExpiresAt DateTime? @map("checkout_expires_at")

  paidAt     DateTime? @map("paid_at")
  failedAt   DateTime? @map("failed_at")
  canceledAt DateTime? @map("canceled_at")

  failureReason String? @map("failure_reason")
  failureCode   String? @map("failure_code")
  rawPayload    Json?   @map("raw_payload")

  idempotencyKey String @map("idempotency_key")

  // Phase 10-2: Refund fields
  refundedAmount Decimal      @default(0) @map("refunded_amount") @db.Decimal(18, 0)
  refundStatus   RefundStatus @default(NONE) @map("refund_status")
  lastRefundAt   DateTime?    @map("last_refund_at")
  chargebackAt   DateTime?    @map("chargeback_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wallet         Wallet          @relation(fields: [walletId], references: [id])
  refundRequests RefundRequest[]

  @@unique([walletId, idempotencyKey])
  @@index([brandUserId, status, createdAt])
  @@index([provider, providerPaymentKey])
  @@map("topup_payments")
}

// Phase 10-2: Refund Request Model
model RefundRequest {
  id             String @id @default(uuid())
  topupPaymentId String @map("topup_payment_id")
  walletId       String @map("wallet_id")

  amount Decimal             @db.Decimal(18, 0)
  reason String
  status RefundRequestStatus @default(REQUESTED)

  providerRefundId String? @unique @map("provider_refund_id")

  requestedBy String    @map("requested_by")
  requestedAt DateTime  @default(now()) @map("requested_at")
  processedBy String?   @map("processed_by")
  processedAt DateTime? @map("processed_at")

  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  rejectedBy      String?   @map("rejected_by")
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason")

  failureReason String? @map("failure_reason")
  rawPayload    Json?   @map("raw_payload")

  idempotencyKey String @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  topupPayment TopupPayment @relation(fields: [topupPaymentId], references: [id])
  wallet       Wallet       @relation(fields: [walletId], references: [id])

  @@unique([topupPaymentId, idempotencyKey])
  @@index([walletId, status, createdAt])
  @@map("refund_requests")
}

// ============================================
// Phase 10-3: Webhook Event Logging & Reconciliation
// ============================================

enum WebhookEventStatus {
  RECEIVED // Webhook 수신, 처리 시작
  PROCESSED // 정상 처리 완료
  IGNORED // 무시 (중복, 관련 없는 이벤트)
  FAILED // 처리 실패
}

model WebhookEventLog {
  id                 String             @id @default(uuid())
  provider           PaymentProvider
  eventType          String             @map("event_type")
  eventId            String             @map("event_id")
  providerPaymentKey String?            @map("provider_payment_key")
  status             WebhookEventStatus @default(RECEIVED)
  errorMessage       String?            @map("error_message")
  rawPayload         Json?              @map("raw_payload")
  receivedAt         DateTime           @default(now()) @map("received_at")
  processedAt        DateTime?          @map("processed_at")
  createdAt          DateTime           @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([provider, eventType, createdAt])
  @@index([status, createdAt])
  @@map("webhook_event_logs")
}

enum ReconciliationScope {
  FULL
  CRITICAL_ONLY
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model ReconciliationRun {
  id           String                  @id @default(uuid())
  scope        ReconciliationScope
  fromDate     DateTime                @map("from_date")
  toDate       DateTime                @map("to_date")
  totalChecked Int                     @default(0) @map("total_checked")
  issuesFound  Int                     @default(0) @map("issues_found")
  status       ReconciliationRunStatus @default(RUNNING)
  errorMessage String?                 @map("error_message")
  startedAt    DateTime                @default(now()) @map("started_at")
  completedAt  DateTime?               @map("completed_at")
  createdAt    DateTime                @default(now()) @map("created_at")

  issues ReconciliationIssue[]

  @@index([status, startedAt])
  @@map("reconciliation_runs")
}

enum ReconciliationIssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReconciliationIssueType {
  TOPUP_PAID_NO_LEDGER // PAID 인데 LedgerTx 없음
  LEDGER_TOPUP_NO_PAID // LedgerTx 있는데 PAID 아님
  REFUND_REFUNDED_NO_LEDGER // REFUNDED 인데 LedgerTx 없음
  LEDGER_REFUND_NO_REQUEST // LedgerTx 있는데 REFUNDED 아님
  REFUNDED_AMOUNT_MISMATCH // refundedAmount 불일치
  WALLET_NEGATIVE // 잔액/동결 음수
  VERSION_CONFLICT_SPIKE // 버전 충돌 급증
}

enum ReconciliationIssueStatus {
  OPEN
  ACKED // 확인됨
  RESOLVED
  IGNORED
}

model ReconciliationIssue {
  id              String                      @id @default(uuid())
  runId           String                      @map("run_id")
  severity        ReconciliationIssueSeverity
  issueType       ReconciliationIssueType     @map("issue_type")
  relatedTopupId  String?                     @map("related_topup_id")
  relatedRefundId String?                     @map("related_refund_id")
  relatedWalletId String?                     @map("related_wallet_id")
  detail          Json?
  status          ReconciliationIssueStatus   @default(OPEN)
  resolvedBy      String?                     @map("resolved_by")
  resolvedAt      DateTime?                   @map("resolved_at")
  resolvedNote    String?                     @map("resolved_note")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  run ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, severity])
  @@index([issueType, status])
  @@index([status, createdAt])
  @@map("reconciliation_issues")
}

enum EscrowStatus {
  HELD // 브랜드 결제 완료, 홀드 중
  RELEASED // 선수에게 지급 완료
  REFUNDED // 브랜드에게 환불 완료
  PARTIALLY_RELEASED // 일부 지급 (분쟁 등)
}

model Escrow {
  id              String       @id @default(uuid())
  contractId      String       @unique @map("contract_id") // 계약당 1개만
  brandId         String       @map("brand_id")
  athleteId       String       @map("athlete_id")
  grossAmount     Decimal      @map("gross_amount") @db.Decimal(18, 0) // 총 금액
  platformFee     Decimal      @map("platform_fee") @db.Decimal(18, 0) // 플랫폼 수수료
  platformFeeRate Decimal      @map("platform_fee_rate") @db.Decimal(5, 4) // 수수료율 (예: 0.1000 = 10%)
  athletePayout   Decimal      @map("athlete_payout") @db.Decimal(18, 0) // 선수 지급액
  status          EscrowStatus @default(HELD)
  heldAt          DateTime     @default(now()) @map("held_at")
  releasedAt      DateTime?    @map("released_at")
  refundedAt      DateTime?    @map("refunded_at")
  refundReason    String?      @map("refund_reason") // 환불 사유
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  contract    Contract     @relation(fields: [contractId], references: [id])
  payoutItems PayoutItem[]

  @@index([status])
  @@index([brandId])
  @@index([athleteId])
  @@map("escrows")
}

enum PayoutBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PayoutBatch {
  id          String            @id @default(uuid())
  status      PayoutBatchStatus @default(PENDING)
  totalAmount Decimal           @map("total_amount") @db.Decimal(18, 0)
  itemCount   Int               @map("item_count")
  processedAt DateTime?         @map("processed_at")
  bankFileUrl String?           @map("bank_file_url")
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  items PayoutItem[]

  @@map("payout_batches")
}

model PayoutItem {
  id            String    @id @default(uuid())
  batchId       String    @map("batch_id")
  escrowId      String    @unique @map("escrow_id") // 에스크로당 1개 지급만
  athleteId     String    @map("athlete_id")
  amount        Decimal   @db.Decimal(18, 0)
  bankName      String?   @map("bank_name")
  bankAccount   String?   @map("bank_account")
  accountHolder String?   @map("account_holder")
  status        String    @default("PENDING")
  processedAt   DateTime? @map("processed_at")
  failReason    String?   @map("fail_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  batch   PayoutBatch @relation(fields: [batchId], references: [id])
  escrow  Escrow      @relation(fields: [escrowId], references: [id])
  athlete Athlete     @relation(fields: [athleteId], references: [id])

  @@map("payout_items")
}

// ============================================
// Point Shop (포인트 샵)
// ============================================

enum ShopItemStatus {
  ACTIVE
  PAUSED
  SOLDOUT
}

enum RedemptionStatus {
  REQUESTED
  CANCELED
  FULFILLED
}

model ShopItem {
  id               String         @id @default(uuid())
  title            String
  description      String?
  imageUrl         String?        @map("image_url")
  pricePoints      Decimal        @map("price_points") @db.Decimal(18, 0)
  stock            Int            @default(0)
  status           ShopItemStatus @default(ACTIVE)
  requiresShipping Boolean        @default(false) @map("requires_shipping")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  orders RedemptionOrder[]

  @@map("shop_items")
}

model RedemptionOrder {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  itemId           String           @map("item_id")
  quantity         Int              @default(1)
  totalPoints      Decimal          @map("total_points") @db.Decimal(18, 0)
  status           RedemptionStatus @default(REQUESTED)
  idempotencyKey   String?          @unique @map("idempotency_key")
  shippingName     String?          @map("shipping_name")
  shippingPhone    String?          @map("shipping_phone")
  shippingAddress1 String?          @map("shipping_address1")
  shippingAddress2 String?          @map("shipping_address2")
  memo             String?
  fulfilledAt      DateTime?        @map("fulfilled_at")
  fulfilledBy      String?          @map("fulfilled_by")
  canceledAt       DateTime?        @map("canceled_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  user User     @relation(fields: [userId], references: [id])
  item ShopItem @relation(fields: [itemId], references: [id])

  @@index([userId, status, createdAt])
  @@map("redemption_orders")
}

// ============================================
// FAQ System (고객지원/FAQ)
// ============================================

enum FaqCategory {
  GENERAL // 일반
  ACCOUNT // 계정
  BIDDING // 입찰
  CONTRACT // 계약
  PAYMENT // 결제
  POINTS // 포인트
  SHOP // 포인트샵
  ATHLETE // 선수 전용
  BRAND // 브랜드 전용
}

model FaqItem {
  id          String      @id @default(uuid())
  category    FaqCategory
  question    String
  answer      String      @db.Text
  orderIndex  Int         @default(0) @map("order_index")
  isPublished Boolean     @default(true) @map("is_published")
  viewCount   Int         @default(0) @map("view_count")
  createdBy   String      @map("created_by")
  updatedBy   String?     @map("updated_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([category, isPublished, orderIndex])
  @@index([isPublished])
  @@map("faq_items")
}

// ============================================
// Penalty System (페널티/참여 제한)
// ============================================

enum PenaltyType {
  ASSET_DEADLINE_MISSED // 에셋 마감 미준수
  CONTRACT_VIOLATION // 계약 위반
  VERIFICATION_FAILURE // 검수 실패
  INAPPROPRIATE_CONTENT // 부적절한 콘텐츠
  ADMIN_MANUAL // 관리자 수동 부여
}

enum PenaltyStatus {
  ACTIVE // 유효
  EXPIRED // 만료됨
  REMOVED // 수동 제거됨
}

model Penalty {
  id           String        @id @default(uuid())
  athleteId    String?       @map("athlete_id")
  brandId      String?       @map("brand_id")
  userId       String        @map("user_id")
  type         PenaltyType
  status       PenaltyStatus @default(ACTIVE)
  points       Int           @default(10)
  reason       String
  refType      String?       @map("ref_type") // CONTRACT, AUCTION, etc.
  refId        String?       @map("ref_id") // 관련 엔티티 ID
  expiresAt    DateTime?     @map("expires_at")
  removedAt    DateTime?     @map("removed_at")
  removedBy    String?       @map("removed_by")
  removeReason String?       @map("remove_reason")
  createdBy    String        @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([athleteId, status])
  @@index([brandId, status])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("penalties")
}

// ============================================
// Report/Dispute System (신고/분쟁 관리)
// ============================================

enum ReportType {
  CONTRACT_DISPUTE // 계약 분쟁
  INAPPROPRIATE_CONTENT // 부적절한 콘텐츠
  FRAUD_SUSPICION // 사기 의심
  SERVICE_ISSUE // 서비스 문제
  OTHER // 기타
}

enum ReportStatus {
  OPEN // 접수됨
  IN_REVIEW // 검토 중
  PENDING_INFO // 정보 대기
  ESCALATED // 에스컬레이션
  RESOLVED // 해결됨
  DISMISSED // 기각됨
}

enum ReportPriority {
  LOW // 낮음
  MEDIUM // 보통
  HIGH // 높음
  CRITICAL // 긴급
}

model Report {
  id             String         @id @default(uuid())
  reporterUserId String         @map("reporter_user_id")
  type           ReportType
  status         ReportStatus   @default(OPEN)
  priority       ReportPriority @default(MEDIUM)
  targetType     String         @map("target_type") // CONTRACT, BRAND, ATHLETE, USER
  targetId       String         @map("target_id")
  title          String
  description    String         @db.Text
  evidenceUrls   String[]       @map("evidence_urls")
  assignedTo     String?        @map("assigned_to")
  resolution     String?        @db.Text
  resolvedBy     String?        @map("resolved_by")
  resolvedAt     DateTime?      @map("resolved_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  comments ReportComment[]
  history  ReportHistory[]

  @@index([status, priority, createdAt])
  @@index([reporterUserId])
  @@index([targetType, targetId])
  @@index([assignedTo, status])
  @@map("reports")
}

model ReportComment {
  id         String   @id @default(uuid())
  reportId   String   @map("report_id")
  userId     String   @map("user_id")
  content    String   @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@map("report_comments")
}

model ReportHistory {
  id        String   @id @default(uuid())
  reportId  String   @map("report_id")
  userId    String   @map("user_id")
  action    String // STATUS_CHANGE, PRIORITY_CHANGE, ASSIGNED, COMMENT_ADDED
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@map("report_history")
}

// ============================================
// Fulfillment System (이행 추적)
// ============================================

enum FulfillmentStatus {
  NOT_STARTED // 시작 전
  DESIGNING // 디자인 중
  PRODUCING // 제작 중
  SHIPPING // 배송 중
  DELIVERED // 배송 완료
  ATTACHED // 부착 완료
}

model ContractFulfillment {
  id         String            @id @default(uuid())
  contractId String            @unique @map("contract_id")
  status     FulfillmentStatus @default(NOT_STARTED)

  // 배송 정보
  carrier        String? // 택배사
  trackingNumber String?   @map("tracking_number")
  shippedAt      DateTime? @map("shipped_at")
  deliveredAt    DateTime? @map("delivered_at")

  // 부착 증빙
  attachmentPhotoUrls String[]  @map("attachment_photo_urls")
  attachedAt          DateTime? @map("attached_at")

  // 메모/노트
  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contract Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  history  FulfillmentHistory[]

  @@index([status])
  @@map("contract_fulfillments")
}

model FulfillmentHistory {
  id            String             @id @default(uuid())
  fulfillmentId String             @map("fulfillment_id")
  fromStatus    FulfillmentStatus? @map("from_status")
  toStatus      FulfillmentStatus  @map("to_status")
  changedBy     String             @map("changed_by")
  notes         String?            @db.Text
  photoUrls     String[]           @map("photo_urls")
  createdAt     DateTime           @default(now()) @map("created_at")

  fulfillment ContractFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  @@index([fulfillmentId, createdAt])
  @@map("fulfillment_history")
}

// ============================================
// Withdrawal System (선수 출금)
// ============================================

enum WithdrawalStatus {
  REQUESTED // 요청됨 (frozenAmount 증가)
  APPROVED // 승인됨 (은행 이체 대기)
  REJECTED // 거부됨 (frozenAmount 해제)
  PAID // 지급 완료 (은행 이체 완료)
}

enum WithdrawalBatchStatus {
  CREATED // 배치 생성됨
  EXPORTED // CSV 내보내기 완료
  COMPLETED // 일괄 지급 완료
  CANCELED // 취소됨
}

model WithdrawalBatch {
  id               String                @id @default(uuid())
  status           WithdrawalBatchStatus @default(CREATED)
  totalAmount      Decimal               @map("total_amount") @db.Decimal(18, 0)
  itemCount        Int                   @map("item_count")
  createdByAdminId String                @map("created_by_admin_id")
  exportedAt       DateTime?             @map("exported_at")
  completedAt      DateTime?             @map("completed_at")
  proofUrl         String?               @map("proof_url")
  note             String?
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  withdrawals WithdrawalRequest[]

  @@index([status, createdAt])
  @@map("withdrawal_batches")
}

model WithdrawalRequest {
  id        String           @id @default(uuid())
  walletId  String           @map("wallet_id")
  athleteId String           @map("athlete_id")
  amount    Decimal          @db.Decimal(18, 0)
  status    WithdrawalStatus @default(REQUESTED)

  // 은행 정보 (요청 시점의 스냅샷)
  bankName          String @map("bank_name")
  bankAccountMasked String @map("bank_account_masked")
  accountHolder     String @map("account_holder")

  // 암호화된 계좌 정보 (AES-256-GCM)
  bankAccountEncrypted String? @map("bank_account_encrypted")
  bankAccountIv        String? @map("bank_account_iv")
  bankAccountTag       String? @map("bank_account_tag")
  bankAccountLast4     String? @map("bank_account_last4")

  // 처리 정보
  requestedReason String? @map("requested_reason")
  adminNote       String? @map("admin_note")
  payoutReference String? @map("payout_reference")

  // 증빙 정보
  proofUrl        String?   @map("proof_url")
  proofUploadedAt DateTime? @map("proof_uploaded_at")

  // 처리 관리자 ID (역할별)
  approvedByAdminId String? @map("approved_by_admin_id")
  rejectedByAdminId String? @map("rejected_by_admin_id")
  paidByAdminId     String? @map("paid_by_admin_id")

  // 배치 연결
  batchId String? @map("batch_id")

  // 멱등성
  idempotencyKey String? @unique @map("idempotency_key")

  // 타임스탬프
  approvedAt  DateTime? @map("approved_at")
  rejectedAt  DateTime? @map("rejected_at")
  paidAt      DateTime? @map("paid_at")
  processedBy String?   @map("processed_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  wallet  Wallet           @relation(fields: [walletId], references: [id])
  athlete Athlete          @relation(fields: [athleteId], references: [id])
  batch   WithdrawalBatch? @relation(fields: [batchId], references: [id])

  @@index([walletId, status, createdAt])
  @@index([athleteId, status])
  @@index([status, createdAt])
  @@index([batchId])
  @@map("withdrawal_requests")
}

// ============================================
// Phase H: Season Rewards
// ============================================

enum SeasonStatus {
  DRAFT
  UPCOMING
  ACTIVE
  ENDED
  REWARDS_DISTRIBUTED
}

model Season {
  id          String       @id @default(uuid())
  name        String
  description String?
  startsAt    DateTime     @map("starts_at")
  endsAt      DateTime     @map("ends_at")
  status      SeasonStatus @default(DRAFT)

  // 보상 티어 설정 (JSON: [{rank: 1-3, rewardPoints: 10000}, ...])
  rewardTiers        Json @default("[]") @map("reward_tiers")
  participationBonus Int  @default(0) @map("participation_bonus")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participants SeasonParticipant[]
  badges       SeasonBadge[]

  @@index([status, startsAt])
  @@map("seasons")
}

model SeasonParticipant {
  id       String @id @default(uuid())
  seasonId String @map("season_id")
  userId   String @map("user_id")

  // 참여 통계
  voteParticipations Int     @default(0) @map("vote_participations")
  correctPredictions Int     @default(0) @map("correct_predictions")
  totalPointsEarned  Decimal @default(0) @map("total_points_earned") @db.Decimal(18, 0)

  // 랭킹
  currentRank Int? @map("current_rank")

  // 보상 배포
  rewardDistributedAt DateTime? @map("reward_distributed_at")
  rewardPoints        Decimal?  @map("reward_points") @db.Decimal(18, 0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  season      Season             @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  badgeAwards SeasonBadgeAward[]

  @@unique([seasonId, userId])
  @@index([seasonId, totalPointsEarned(sort: Desc)])
  @@index([seasonId, currentRank])
  @@map("season_participants")
}

enum BadgeType {
  SEASON_GOLD
  SEASON_SILVER
  SEASON_BRONZE
  SEASON_TOP10
  SEASON_TOP100
  PARTICIPATION
  VOTE_MASTER
  SHOP_VIP
  STREAK
}

model SeasonBadge {
  id          String    @id @default(uuid())
  seasonId    String    @map("season_id")
  badgeType   BadgeType @map("badge_type")
  name        String
  description String?
  iconUrl     String?   @map("icon_url")
  requirement Json? // 획득 조건 JSON

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  season Season             @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  awards SeasonBadgeAward[]

  @@unique([seasonId, badgeType])
  @@map("season_badges")
}

model SeasonBadgeAward {
  id            String   @id @default(uuid())
  participantId String   @map("participant_id")
  badgeId       String   @map("badge_id")
  awardedAt     DateTime @default(now()) @map("awarded_at")

  // Relations
  participant SeasonParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  badge       SeasonBadge       @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([participantId, badgeId])
  @@map("season_badge_awards")
}

// ============================================
// Phase 11-2A: Billing / Statements / Tax Invoice
// ============================================

model BillingProfile {
  id      String @id @default(uuid())
  brandId String @unique @map("brand_id")

  businessName       String  @map("business_name") // 상호
  businessNumber     String  @map("business_number") // 사업자등록번호
  representativeName String  @map("representative_name") // 대표자명
  businessType       String? @map("business_type") // 업태
  businessCategory   String? @map("business_category") // 업종

  billingEmail  String  @map("billing_email")
  billingPhone  String? @map("billing_phone")
  address       String
  addressDetail String? @map("address_detail")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand              Brand               @relation(fields: [brandId], references: [id])
  taxInvoiceRequests TaxInvoiceRequest[]

  @@map("billing_profiles")
}

enum DocumentExportType {
  STATEMENT_CSV
  STATEMENT_PDF
  TAX_INVOICE_PDF
}

model DocumentExportLog {
  id         String             @id @default(uuid())
  userId     String             @map("user_id")
  brandId    String             @map("brand_id")
  exportType DocumentExportType @map("export_type")
  fromDate   DateTime           @map("from_date")
  toDate     DateTime           @map("to_date")
  itemCount  Int                @map("item_count")
  ipAddress  String?            @map("ip_address")
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([brandId, createdAt])
  @@map("document_export_logs")
}

enum TaxInvoiceStatus {
  REQUESTED
  APPROVED
  ISSUED
  REJECTED
}

model TaxInvoiceRequest {
  id               String   @id @default(uuid())
  billingProfileId String   @map("billing_profile_id")
  fromDate         DateTime @map("from_date")
  toDate           DateTime @map("to_date")
  supplyAmount     Decimal  @map("supply_amount") @db.Decimal(18, 0)
  taxAmount        Decimal  @map("tax_amount") @db.Decimal(18, 0)
  totalAmount      Decimal  @map("total_amount") @db.Decimal(18, 0)

  status          TaxInvoiceStatus @default(REQUESTED)
  requestedAt     DateTime         @default(now()) @map("requested_at")
  approvedBy      String?          @map("approved_by")
  approvedAt      DateTime?        @map("approved_at")
  rejectedBy      String?          @map("rejected_by")
  rejectedAt      DateTime?        @map("rejected_at")
  rejectionReason String?          @map("rejection_reason")
  issuedBy        String?          @map("issued_by")
  issuedAt        DateTime?        @map("issued_at")
  invoiceNumber   String?          @unique @map("invoice_number")

  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  billingProfile BillingProfile @relation(fields: [billingProfileId], references: [id])

  @@index([status, requestedAt])
  @@map("tax_invoice_requests")
}

// ============================================
// Point Transfer (포인트 전송)
// ============================================

model PointTransfer {
  id         String   @id @default(uuid())
  fromUserId String   @map("from_user_id")
  toUserId   String   @map("to_user_id")
  amount     Decimal  @db.Decimal(18, 0)
  message    String?
  createdAt  DateTime @default(now()) @map("created_at")

  fromUser User @relation("PointTransferFrom", fields: [fromUserId], references: [id])
  toUser   User @relation("PointTransferTo", fields: [toUserId], references: [id])

  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
  @@map("point_transfers")
}

// ============================================
// Donation (팬→선수 후원)
// ============================================

model Donation {
  id          String   @id @default(uuid())
  donorUserId String   @map("donor_user_id")
  athleteId   String   @map("athlete_id")
  amount      Decimal  @db.Decimal(18, 0) // 총 후원 금액
  platformFee Decimal  @map("platform_fee") @db.Decimal(18, 0) // 수수료 (2%)
  netAmount   Decimal  @map("net_amount") @db.Decimal(18, 0) // 선수 수령액
  message     String?
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  createdAt   DateTime @default(now()) @map("created_at")

  donorUser User    @relation("DonationFrom", fields: [donorUserId], references: [id])
  athlete   Athlete @relation(fields: [athleteId], references: [id])

  @@index([donorUserId, createdAt])
  @@index([athleteId, createdAt])
  @@map("donations")
}

// ============================================
// Point Withdrawal (포인트 출금 - 선수용)
// ============================================

enum PointWithdrawalStatus {
  REQUESTED // 출금 요청
  APPROVED // 승인됨
  REJECTED // 거부됨
  PAID // 지급 완료
}

model PointWithdrawal {
  id                String                @id @default(uuid())
  userId            String                @map("user_id")
  amount            Decimal               @db.Decimal(18, 0) // 출금 요청 금액 (포인트)
  bankName          String                @map("bank_name")
  bankAccountNumber String                @map("bank_account_number")
  bankAccountMasked String                @map("bank_account_masked") // 마스킹된 계좌번호
  accountHolder     String                @map("account_holder")
  status            PointWithdrawalStatus @default(REQUESTED)
  requestedReason   String?               @map("requested_reason")
  adminNote         String?               @map("admin_note")
  payoutReference   String?               @map("payout_reference") // 이체 참조번호
  processedBy       String?               @map("processed_by") // 처리한 관리자 ID
  createdAt         DateTime              @default(now()) @map("created_at")
  approvedAt        DateTime?             @map("approved_at")
  rejectedAt        DateTime?             @map("rejected_at")
  paidAt            DateTime?             @map("paid_at")

  user  User  @relation("PointWithdrawals", fields: [userId], references: [id])
  admin User? @relation("ProcessedPointWithdrawals", fields: [processedBy], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("point_withdrawals")
}

// ============================================
// Vote V2 - 리워드풀 기반 무료 투표 시스템
// ============================================

enum VoteV2Status {
  OPEN // 투표 진행중
  CLOSED // 마감됨 (정산 대기)
  SETTLED // 정산 완료
  CANCELED // 취소됨
}

enum VoteFundingSource {
  REWARD_POOL // 리워드풀에서 예산 할당 (관리자 생성)
  USER_POINTS // 사용자 본인 포인트 (사용자 생성)
}

model RewardPool {
  id               String   @id @default(uuid())
  balanceEp        BigInt   @default(0) @map("balance_ep") // 총 잔액 (EP)
  reservedEp       BigInt   @default(0) @map("reserved_ep") // 진행중 투표 예약액
  availableTodayEp BigInt   @default(0) @map("available_today_ep") // 오늘 사용 가능 한도
  multiplierM      Decimal  @default(1.00) @map("multiplier_m") @db.Decimal(4, 2) // 배수 (0.20~1.00)
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("reward_pools")
}

model VoteV2 {
  id             String            @id @default(uuid())
  templateCode   String            @map("template_code") // T1-YesNo, T2-MC, T3-TopN, T4-Exact
  title          String
  description    String?
  options        Json              @default("[]") // [{id: string, label: string}]
  status         VoteV2Status      @default(OPEN)
  fundingSource  VoteFundingSource @default(REWARD_POOL) @map("funding_source") // 예산 원천
  rewardBudgetEp BigInt            @default(0) @map("reward_budget_ep") // 템플릿 기반 예산
  escrowEp       BigInt            @default(0) @map("escrow_ep") // 현재 에스크로 잔액
  maxPerWinnerEp BigInt            @default(50000) @map("max_per_winner_ep") // 1인당 상한
  target         Json              @default("{}") // {tournamentId?, matchId?, playerId?}
  outcomeSource  String            @default("official_api") @map("outcome_source")
  correctAnswer  Json?             @map("correct_answer") // 정답 (정산 시 설정)
  closeAt        DateTime          @map("close_at") // 마감 시간
  settleAt       DateTime?         @map("settle_at") // 정산 시간
  createdBy      String?           @map("created_by") // 생성자 ID
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  participations VoteParticipationV2[]

  @@index([status, closeAt])
  @@index([createdBy])
  @@map("votes_v2")
}

model VoteParticipationV2 {
  voteId            String   @map("vote_id")
  userId            String   @map("user_id")
  answer            Json     @default("{}") // 사용자 답변
  isCorrect         Boolean? @map("is_correct") // 정답 여부 (정산 후 설정)
  microRewardPaidEp BigInt   @default(0) @map("micro_reward_paid_ep") // 참여 시 소액 보상
  finalRewardPaidEp BigInt   @default(0) @map("final_reward_paid_ep") // 정산 시 최종 보상
  createdAt         DateTime @default(now()) @map("created_at")

  vote VoteV2 @relation(fields: [voteId], references: [id], onDelete: Cascade)

  @@id([voteId, userId])
  @@index([userId, createdAt])
  @@map("vote_participations_v2")
}

// ============================================
// ROI Report Dashboard - VOD & Logo Detection
// ============================================

enum VodStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  MODIFIED
}

enum EvidenceType {
  SCREENSHOT
  CLIP
  HIGHLIGHT
}

enum MediaType {
  NEWS
  YOUTUBE
  INSTAGRAM
  OTHER
}

enum RoiReportType {
  DAILY
  WEEKLY
  MONTHLY
  CAMPAIGN_FINAL
}

enum RoiReportStatus {
  GENERATING
  COMPLETED
  FAILED
}

// VOD 자산 관리
model VodAsset {
  id            String    @id @default(uuid())
  campaignId    String    @map("campaign_id")
  eventId       String?   @map("event_id")
  source        String // YOUTUBE, UPLOAD, PARTNER
  sourceUrl     String?   @map("source_url")
  storageKey    String    @map("storage_key")
  fileName      String?   @map("file_name")
  duration      Int // 초 단위
  fps           Float     @default(30)
  resolution    String? // 1920x1080
  fileSizeBytes BigInt?   @map("file_size_bytes")
  status        VodStatus @default(PENDING)
  errorMessage  String?   @map("error_message")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  campaign     Campaign      @relation(fields: [campaignId], references: [id])
  event        Event?        @relation(fields: [eventId], references: [id])
  frames       VodFrame[]
  roiExposures RoiExposure[]

  @@index([campaignId])
  @@index([status])
  @@map("vod_assets")
}

// 프레임 추출 결과
model VodFrame {
  id           String   @id @default(uuid())
  vodAssetId   String   @map("vod_asset_id")
  frameNumber  Int      @map("frame_number")
  timestamp    Float // 초 단위
  thumbnailKey String   @map("thumbnail_key")
  createdAt    DateTime @default(now()) @map("created_at")

  vodAsset   VodAsset        @relation(fields: [vodAssetId], references: [id], onDelete: Cascade)
  detections LogoDetection[]

  @@index([vodAssetId, timestamp])
  @@map("vod_frames")
}

// 로고 템플릿 (브랜드별)
model LogoTemplate {
  id        String   @id @default(uuid())
  brandId   String   @map("brand_id")
  name      String // Primary, Secondary, Mono 등
  fileKey   String   @map("file_key")
  fileUrl   String?  @map("file_url")
  checksum  String?
  variant   String? // COLOR, MONO, INVERSE 등
  embedding Json? // CLIP 임베딩 벡터 (512차원 float 배열)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId])
  @@map("logo_templates")
}

// AI 로고 검출 결과
model LogoDetection {
  id             String   @id @default(uuid())
  frameId        String   @map("frame_id")
  brandId        String   @map("brand_id")
  logoTemplateId String?  @map("logo_template_id")
  confidence     Float // 0~1 신뢰도
  bboxX          Int      @map("bbox_x")
  bboxY          Int      @map("bbox_y")
  bboxW          Int      @map("bbox_w")
  bboxH          Int      @map("bbox_h")
  bboxArea       Int      @map("bbox_area")
  areaRatio      Float    @map("area_ratio") // 화면 대비 비율
  blurScore      Float?   @map("blur_score") // 선명도 점수
  occlusionScore Float?   @map("occlusion_score") // 가림 점수
  slotType       String?  @map("slot_type") // 슬롯 타입 매핑
  rawResponse    Json?    @map("raw_response") // AI API 원본 응답
  createdAt      DateTime @default(now()) @map("created_at")

  frame VodFrame @relation(fields: [frameId], references: [id], onDelete: Cascade)
  brand Brand    @relation(fields: [brandId], references: [id])

  @@index([frameId])
  @@index([brandId])
  @@map("logo_detections")
}

// 노출 구간 (병합된 결과)
model RoiExposure {
  id            String       @id @default(uuid())
  vodAssetId    String       @map("vod_asset_id")
  campaignId    String       @map("campaign_id")
  brandId       String       @map("brand_id")
  slotType      String?      @map("slot_type")
  startTs       Float        @map("start_ts") // 시작 타임스탬프 (초)
  endTs         Float        @map("end_ts") // 종료 타임스탬프 (초)
  duration      Float // 노출 시간 (초)
  frameCount    Int          @default(0) @map("frame_count")
  avgConfidence Float        @map("avg_confidence")
  avgAreaRatio  Float        @map("avg_area_ratio")
  maxAreaRatio  Float?       @map("max_area_ratio")
  isValid       Boolean      @default(false) @map("is_valid")
  invalidReason String?      @map("invalid_reason")
  reviewStatus  ReviewStatus @default(PENDING) @map("review_status")
  reviewedBy    String?      @map("reviewed_by")
  reviewedAt    DateTime?    @map("reviewed_at")
  reviewNotes   String?      @map("review_notes")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  vodAsset      VodAsset          @relation(fields: [vodAssetId], references: [id], onDelete: Cascade)
  campaign      Campaign          @relation(fields: [campaignId], references: [id])
  brand         Brand             @relation(fields: [brandId], references: [id])
  evidenceItems RoiEvidenceItem[]

  @@index([campaignId, brandId])
  @@index([reviewStatus])
  @@map("roi_exposures")
}

// 증빙 자료 (캡처/클립)
model RoiEvidenceItem {
  id            String       @id @default(uuid())
  exposureId    String       @map("exposure_id")
  type          EvidenceType
  fileKey       String       @map("file_key")
  fileUrl       String?      @map("file_url")
  thumbnailKey  String?      @map("thumbnail_key")
  startTs       Float?       @map("start_ts")
  endTs         Float?       @map("end_ts")
  fileSizeBytes BigInt?      @map("file_size_bytes")
  createdAt     DateTime     @default(now()) @map("created_at")

  exposure RoiExposure @relation(fields: [exposureId], references: [id], onDelete: Cascade)

  @@index([exposureId])
  @@map("roi_evidence_items")
}

// 2차 미디어 멘션
model MediaMention {
  id           String    @id @default(uuid())
  campaignId   String    @map("campaign_id")
  type         MediaType
  url          String
  title        String?
  description  String?
  thumbnailUrl String?   @map("thumbnail_url")
  publishedAt  DateTime? @map("published_at")
  viewCount    Int?      @map("view_count")
  likeCount    Int?      @map("like_count")
  commentCount Int?      @map("comment_count")
  shareCount   Int?      @map("share_count")
  hasLogo      Boolean   @default(false) @map("has_logo")
  metricsJson  Json?     @map("metrics_json")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([type])
  @@map("media_mentions")
}

// ROI 리포트
model RoiReport {
  id           String          @id @default(uuid())
  campaignId   String          @map("campaign_id")
  periodStart  DateTime        @map("period_start")
  periodEnd    DateTime        @map("period_end")
  type         RoiReportType
  title        String?
  fileKey      String?         @map("file_key")
  fileUrl      String?         @map("file_url")
  status       RoiReportStatus @default(GENERATING)
  metricsJson  Json?           @map("metrics_json") // KPI 스냅샷
  errorMessage String?         @map("error_message")
  generatedAt  DateTime?       @map("generated_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([status])
  @@map("roi_reports")
}

// ============================================
// Full Funnel Data Reporting (스폰픽 풀 퍼널 시스템)
// 선수 연계형 프로모션 코드·트래킹 링크·브랜드 미니스토어 기반 매출 증명
// 문서: sponpik_full_funnel_{api_spec, handoff, wireframe_spec}.docx
// ============================================

enum DiscountType {
  PERCENT // 퍼센트 할인 (예: 20%)
  AMOUNT // 정액 할인 (예: 10000원)
}

enum PromoCodeStatus {
  ACTIVE
  DISABLED
  EXPIRED
  OVERUSED
}

enum MiniStoreStatus {
  DRAFT // 초안
  PUBLISHED // 게시
  HIDDEN // 비게시
}

enum FunnelEventType {
  IMPRESSION_LOGGED // 미디어 노출 증빙 (ROI 시스템 연동)
  LINK_CLICK // 단축링크 클릭
  LANDING_VIEW // 랜딩 페이지 진입
  PRODUCT_VIEW // 상품 조회
  CTA_CLICK // CTA 버튼 클릭
  ADD_TO_CART // 장바구니 담기
  BEGIN_CHECKOUT // 결제 시작
  PROMO_APPLY // 프로모션 코드 적용
  PURCHASE // 결제 완료
  REFUND // 환불
  CANCEL // 취소
}

enum AttributionStatus {
  ATTRIBUTED // 귀속 완료
  PENDING // 대기
  UNATTRIBUTED // 미귀속
}

enum FunnelOrderStatus {
  PENDING // 결제 진행 중 (wireframe TABLE 22)
  PAID
  REFUNDED
  CANCELLED
  PARTIAL_REFUND
}

enum CampaignPricingModel {
  FIXED // 정액 (기본)
  CPA // 행동당 (Cost Per Action)
  CPS // 매출당 (Cost Per Sale)
  HYBRID // 혼합형
}

enum AttributionModel {
  FIRST_TOUCH
  LAST_TOUCH
  LINEAR
  TIME_DECAY
  POSITION_BASED // 40-20-40
}

// ============================================
// PromoCode (프로모션 코드)
// 선수-캠페인 단위 고유 코드. 결제 시 우선 귀속 기준
// ============================================

model PromoCode {
  id            String          @id @default(uuid())
  campaignId    String          @map("campaign_id")
  brandId       String          @map("brand_id")
  athleteId     String          @map("athlete_id")
  code          String          @unique // 예: KLPGA_KIM20
  discountType  DiscountType    @map("discount_type")
  discountValue Decimal         @map("discount_value") @db.Decimal(18, 4)
  validFrom     DateTime?       @map("valid_from")
  validTo       DateTime?       @map("valid_to")
  status        PromoCodeStatus @default(ACTIVE)
  usageCount    Int             @default(0) @map("usage_count")
  maxUsage      Int?            @map("max_usage")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])
  brand    Brand    @relation(fields: [brandId], references: [id])
  athlete  Athlete  @relation(fields: [athleteId], references: [id])

  @@index([campaignId, status])
  @@index([code])
  @@index([brandId])
  @@map("promo_codes")
}

// ============================================
// TrackingLink (선수/콘텐츠별 단축 링크 + QR)
// ============================================

model TrackingLink {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  brandId     String   @map("brand_id")
  athleteId   String   @map("athlete_id")
  contentId   String?  @map("content_id") // SNS 게시물 등
  contentType String?  @map("content_type") // INSTAGRAM | YOUTUBE | BLOG | TIKTOK | OTHER (wireframe TABLE 11)
  shortCode   String   @unique @map("short_code") // nanoid 6자
  longUrl     String   @map("long_url") // 실제 랜딩 URL (미니스토어 + UTM)
  qrUrl       String?  @map("qr_url") // QR PNG CDN URL
  clickCount  Int      @default(0) @map("click_count")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])
  brand    Brand    @relation(fields: [brandId], references: [id])
  athlete  Athlete  @relation(fields: [athleteId], references: [id])

  @@index([campaignId, athleteId])
  @@index([shortCode])
  @@map("tracking_links")
}

// ============================================
// MiniStore (브랜드 전용 미니스토어)
// 캠페인당 1개. 선수 추천 혜택을 보여주는 랜딩 페이지
// ============================================

model MiniStore {
  id              String          @id @default(uuid())
  campaignId      String          @unique @map("campaign_id")
  brandId         String          @map("brand_id")
  slug            String          @unique // /store/brand/:slug
  template        String          @default("default-v1")
  brandLogoUrl    String?         @map("brand_logo_url")
  themeColor      String?         @map("theme_color") // 테마 컬러 hex (#10b981 등) - wireframe TABLE 14
  heroImageUrl    String?         @map("hero_image_url")
  athleteImageUrl String?         @map("athlete_image_url")
  mainCopy        String?         @map("main_copy")
  benefitBadge    String?         @map("benefit_badge") // "OO선수 추천 혜택"
  ctaText         String?         @map("cta_text")
  status          MiniStoreStatus @default(DRAFT)
  publishedAt     DateTime?       @map("published_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  campaign Campaign       @relation(fields: [campaignId], references: [id])
  brand    Brand          @relation(fields: [brandId], references: [id])
  products StoreProduct[]

  @@index([brandId])
  @@map("mini_stores")
}

// ============================================
// StoreProduct (미니스토어 상품)
// ============================================

model StoreProduct {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  name          String
  description   String?
  imageUrl      String?  @map("image_url")
  images        Json? // 추가 이미지/썸네일 배열 (wireframe TABLE 35)
  price         Decimal  @db.Decimal(18, 0)
  discountPrice Decimal? @map("discount_price") @db.Decimal(18, 0)
  stock         Int      @default(0)
  soldOut       Boolean  @default(false) @map("sold_out")
  sortOrder     Int      @default(0) @map("sort_order")
  options       Json? // 색상/사이즈 등 [{name:"색상",values:["블랙","화이트"]}] (wireframe TABLE 36)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  store MiniStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, sortOrder])
  @@map("store_products")
}

// ============================================
// FunnelEvent (풀 퍼널 모든 이벤트 적재)
// 모든 이벤트는 campaign_id, athlete_id, brand_id 공통키 보유 (handoff.docx)
// ============================================

model FunnelEvent {
  id          String          @id @default(uuid())
  eventName   FunnelEventType @map("event_name")
  campaignId  String          @map("campaign_id")
  brandId     String          @map("brand_id")
  athleteId   String          @map("athlete_id")
  contentId   String?         @map("content_id")
  sessionId   String?         @map("session_id")
  anonymousId String?         @map("anonymous_id")
  userId      String?         @map("user_id")
  promoCode   String?         @map("promo_code")
  payload     Json // event-specific data (product_id, qty, amount 등)
  ipAddress   String?         @map("ip_address")
  userAgent   String?         @map("user_agent")
  referrer    String?
  deviceType  String?         @map("device_type") // mobile | desktop
  // UTM 파라미터 (handoff TABLE 6 - 향후 외부 유입 구분)
  utmSource   String?         @map("utm_source")
  utmMedium   String?         @map("utm_medium")
  utmCampaign String?         @map("utm_campaign")
  utmContent  String?         @map("utm_content")
  utmTerm     String?         @map("utm_term")
  occurredAt  DateTime        @default(now()) @map("occurred_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])
  brand    Brand    @relation(fields: [brandId], references: [id])
  athlete  Athlete  @relation(fields: [athleteId], references: [id])

  @@index([campaignId, eventName, occurredAt])
  @@index([athleteId, occurredAt])
  @@index([brandId, eventName, occurredAt])
  @@index([sessionId])
  @@index([anonymousId])
  @@index([utmSource, utmCampaign])
  @@map("funnel_events")
}

// ============================================
// FunnelOrderAuditLog (운영자 주문 보정·귀속 수정 감사 로그)
// handoff "8조 권한, 보안" + "로그성 데이터 = 화면성 데이터 일치 (감사 대응)"
// ============================================

model FunnelOrderAuditLog {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  adminUserId String   @map("admin_user_id")
  action      String // ADJUST_AMOUNT | REATTRIBUTE | STATUS_CHANGE | NOTE
  beforeJson  Json     @map("before_json")
  afterJson   Json     @map("after_json")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@index([adminUserId, createdAt])
  @@map("funnel_order_audit_logs")
}

// ============================================
// FunnelOrder (구매 주문 - 풀 퍼널 매출 증명 기록)
// 트랜잭션 + 멱등성 (CLAUDE.md 불변식)
// ============================================

model FunnelOrder {
  id                String            @id @default(uuid())
  externalOrderId   String?           @map("external_order_id") // 외부몰 주문번호
  campaignId        String            @map("campaign_id")
  brandId           String            @map("brand_id")
  athleteId         String            @map("athlete_id")
  promoCode         String?           @map("promo_code")
  grossAmount       Decimal           @map("gross_amount") @db.Decimal(18, 0)
  discountAmount    Decimal           @default(0) @map("discount_amount") @db.Decimal(18, 0)
  netAmount         Decimal           @map("net_amount") @db.Decimal(18, 0)
  refundedAmount    Decimal           @default(0) @map("refunded_amount") @db.Decimal(18, 0)
  isNewCustomer     Boolean           @default(false) @map("is_new_customer")
  attributionStatus AttributionStatus @default(PENDING) @map("attribution_status")
  attributionReason String?           @map("attribution_reason") // promo_code | link_click | session
  status            FunnelOrderStatus @default(PAID)
  items             Json // [{product_id, qty, unit_price}]
  customerHash      String?           @map("customer_hash") // 개인정보 보호 해시
  paidAt            DateTime          @default(now()) @map("paid_at")
  refundedAt        DateTime?         @map("refunded_at")
  refundReason      String?           @map("refund_reason") // 환불 사유 (BRD-03 표시)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])
  brand    Brand    @relation(fields: [brandId], references: [id])
  athlete  Athlete  @relation(fields: [athleteId], references: [id])

  @@unique([brandId, externalOrderId]) // 외부몰 주문 멱등성
  @@index([campaignId, paidAt])
  @@index([brandId, paidAt])
  @@index([athleteId, paidAt])
  @@index([promoCode])
  @@map("funnel_orders")
}

// ============================================
// SessionRollup (세션별 어트리뷰션 롤업)
// 어트리뷰션 우선순위 2순위: 최근 클릭된 트래킹 링크
// ============================================

model SessionRollup {
  sessionId      String    @id @map("session_id")
  anonymousId    String?   @map("anonymous_id")
  userId         String?   @map("user_id")
  lastCampaignId String?   @map("last_campaign_id")
  lastAthleteId  String?   @map("last_athlete_id")
  lastBrandId    String?   @map("last_brand_id")
  lastPromoCode  String?   @map("last_promo_code")
  lastClickId    String?   @map("last_click_id")
  lastShortCode  String?   @map("last_short_code")
  lastClickAt    DateTime? @map("last_click_at")
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([anonymousId])
  @@index([userId])
  @@index([lastCampaignId])
  @@map("session_rollups")
}

// ============================================
// PixelInstall (Phase 2: 외부몰 JS 픽셀 설치)
// HMAC 서명 검증을 위한 secret 보유
// ============================================

model PixelInstall {
  id          String    @id @default(uuid())
  brandId     String    @unique @map("brand_id")
  pixelKey    String    @unique @map("pixel_key") // 공개 키 (스크립트에 노출)
  secretKey   String    @map("secret_key") // HMAC 서명 검증용 (비공개)
  domains     String[] // 허용 도메인 화이트리스트
  status      String    @default("ACTIVE")
  installedAt DateTime? @map("installed_at") // 첫 호출 시각
  lastSeenAt  DateTime? @map("last_seen_at") // 마지막 호출 시각
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([pixelKey])
  @@map("pixel_installs")
}

// ============================================
// AttributionTouch (Phase 3: 멀티터치 어트리뷰션)
// 한 세션의 모든 터치 포인트 추적 → 모델별 가중치 계산
// ============================================

model AttributionTouch {
  id                String   @id @default(uuid())
  sessionId         String   @map("session_id")
  anonymousId       String?  @map("anonymous_id")
  userId            String?  @map("user_id")
  campaignId        String   @map("campaign_id")
  athleteId         String   @map("athlete_id")
  brandId           String   @map("brand_id")
  contentId         String?  @map("content_id")
  touchOrder        Int      @map("touch_order") // 세션 내 순서 (1, 2, 3...)
  touchType         String   @map("touch_type") // click | landing | engagement
  touchAt           DateTime @map("touch_at")
  conversionOrderId String?  @map("conversion_order_id") // 최종 구매와 연결
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([sessionId, touchOrder])
  @@index([conversionOrderId])
  @@index([campaignId, touchAt])
  @@map("attribution_touches")
}

// ============================================
// PerformanceSettlement (Phase 3: CPA/CPS 성과형 정산 기록)
// ============================================

model PerformanceSettlement {
  id              String               @id @default(uuid())
  campaignId      String               @map("campaign_id")
  brandId         String               @map("brand_id")
  athleteId       String               @map("athlete_id")
  periodStart     DateTime             @map("period_start")
  periodEnd       DateTime             @map("period_end")
  pricingModel    CampaignPricingModel @map("pricing_model")
  conversionCount Int                  @default(0) @map("conversion_count")
  totalRevenue    Decimal              @default(0) @map("total_revenue") @db.Decimal(18, 0)
  settledAmount   Decimal              @default(0) @map("settled_amount") @db.Decimal(18, 0)
  ledgerTxId      String?              @map("ledger_tx_id")
  status          String               @default("PENDING") // PENDING | SETTLED | FAILED
  settledAt       DateTime?            @map("settled_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  @@unique([campaignId, periodStart, periodEnd])
  @@index([brandId, periodStart])
  @@index([status])
  @@map("performance_settlements")
}

// ============================================
// AthleteEventResult (선수 경기결과/분석 정보)
// docx 3-6: GTOUR 등 외부 대회 결과 노출용
// 연동 방식: 관리자 수기 등록 / 외부 API / 크롤링 (source 필드로 구분)
// ============================================

model AthleteEventResult {
  id              String   @id @default(uuid())
  athleteId       String   @map("athlete_id")
  // 대회 정보 (외부 데이터 = 우리 Event 모델과 별개로 free-text)
  eventName       String   @map("event_name") // 대회명
  eventDate       DateTime @map("event_date") // 개최일 (정렬·연도 그룹용)
  tour            String? // 투어명 (예: KLPGA, WGTOUR, GTOUR) — docx §9 F 필수 표시 항목
  category        String? // 경기 구분 (예: 정규투어, 챔피언십)
  // 결과
  rank            Int? // 순위 (null = 미공개/예선 탈락)
  score           String? // 스코어 (예: -7, 64-65-67-66)
  totalRounds     Int?     @map("total_rounds")
  // 분석
  summary         String? // 분석 요약 (자유 텍스트)
  // 메타
  source          String   @default("MANUAL") // MANUAL | GTOUR_API | CRAWLER | ATHLETE_SELF
  // 공개 승인 상태 — 선수 자가등록은 PENDING(비공개) → 관리자 승인 시 APPROVED(공개). 관리자/외부수집은 기본 APPROVED.
  status          String   @default("APPROVED") // APPROVED | PENDING | REJECTED
  sourceUpdatedAt DateTime @default(now()) @map("source_updated_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, eventDate(sort: Desc)])
  @@index([athleteId, source])
  @@map("athlete_event_results")
}

// ============================================
// YouTube 채널 연동 (Phase 2 SNS — ROI 자동화 docx §4.3)
// ============================================

model YoutubeChannel {
  id              String    @id @default(uuid())
  athleteId       String    @unique @map("athlete_id")
  channelId       String    @map("channel_id") // YouTube channel ID (UCxxxxx)
  channelHandle   String?   @map("channel_handle") // @username
  title           String
  description     String?
  thumbnailUrl    String?   @map("thumbnail_url")
  subscriberCount Int?      @map("subscriber_count")
  videoCount      Int?      @map("video_count")
  totalViews      BigInt?   @map("total_views")
  lastSyncedAt    DateTime? @map("last_synced_at")
  syncStatus      String    @default("PENDING") @map("sync_status") // PENDING / OK / FAILED
  syncError       String?   @map("sync_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  athlete Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  videos  YoutubeVideo[]

  @@index([channelId])
  @@map("youtube_channels")
}

model YoutubeVideo {
  id           String   @id @default(uuid())
  channelDbId  String   @map("channel_db_id")
  videoId      String   @unique @map("video_id")
  title        String
  description  String?
  thumbnailUrl String?  @map("thumbnail_url")
  publishedAt  DateTime @map("published_at")
  viewCount    Int      @default(0) @map("view_count")
  likeCount    Int      @default(0) @map("like_count")
  commentCount Int      @default(0) @map("comment_count")
  durationSec  Int?     @map("duration_sec")
  lastSyncedAt DateTime @default(now()) @map("last_synced_at")

  channel YoutubeChannel @relation(fields: [channelDbId], references: [id], onDelete: Cascade)

  @@index([channelDbId, publishedAt(sort: Desc)])
  @@map("youtube_videos")
}

// ============================================
// 선수 출연 영상 (3rd-party YouTube 채널 mention)
// SPONPIK Phase 2 SNS — 옵션 B (검색 + 수동 확인 하이브리드)
// ============================================

enum MentionStatus {
  PENDING // 자동 검색으로 발견된 후보 (확정 대기)
  APPROVED // 본인/관리자가 출연 확정
  REJECTED // 무관한 영상으로 판정
}

enum MentionSource {
  AUTO_SEARCH // YouTube search API로 자동 발견
  MANUAL // 운영자가 수동 추가
  SELF_REPORTED // 선수 본인이 URL 붙여넣기
}

model AthleteMention {
  id             String        @id @default(uuid())
  athleteId      String        @map("athlete_id")
  videoId        String        @map("video_id") // YouTube videoId
  // 영상/채널 메타 (캐시)
  channelId      String?       @map("channel_id")
  channelTitle   String?       @map("channel_title")
  videoTitle     String        @map("video_title")
  videoThumbnail String?       @map("video_thumbnail")
  publishedAt    DateTime      @map("published_at")
  // 통계 (cron 갱신)
  viewCount      Int           @default(0) @map("view_count")
  likeCount      Int           @default(0) @map("like_count")
  commentCount   Int           @default(0) @map("comment_count")
  // 큐레이션 메타
  status         MentionStatus @default(PENDING)
  source         MentionSource @default(AUTO_SEARCH)
  approvedBy     String?       @map("approved_by") // userId
  approvedAt     DateTime?     @map("approved_at")
  rejectedReason String?       @map("rejected_reason")
  lastSyncedAt   DateTime      @default(now()) @map("last_synced_at")
  syncStatus     String        @default("OK") @map("sync_status")
  syncError      String?       @map("sync_error")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, videoId])
  @@index([athleteId, status])
  @@index([status, lastSyncedAt])
  @@map("athlete_mentions")
}

// ============================================
// AthleteMediaExposure (docx §6 C-1 미디어노출 - 수동/관리자 입력)
// 자동 수집 미구현 항목 (방송 중계, 패치 노출, 하이라이트 등) 보강
// 시기별로 누적 (월 단위 또는 이벤트 단위 권장)
// ============================================

model AthleteMediaExposure {
  id                    String   @id @default(uuid())
  athleteId             String   @map("athlete_id")
  // docx §6 C-1 표시 항목
  broadcastCount        Int      @default(0) @map("broadcast_count") // 중계 노출 횟수
  broadcastSeconds      Int      @default(0) @map("broadcast_seconds") // 중계 노출 시간(초)
  patchExposureEstimate Int      @default(0) @map("patch_exposure_estimate") // 패치/로고 노출 추정 횟수
  articleMentions       Int      @default(0) @map("article_mentions") // 기사/외부 언급 수 (수동, 자동은 newsArticles 별도)
  highlightCount        Int      @default(0) @map("highlight_count") // 하이라이트 노출 수
  // 메타
  periodStart           DateTime @map("period_start") // 측정 기간 시작
  periodEnd             DateTime @map("period_end") // 측정 기간 종료
  source                String   @default("MANUAL") // MANUAL | GTOUR_API | CRAWLER | AI_VIDEO
  notes                 String? // 관리자 메모
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, periodEnd(sort: Desc)])
  @@map("athlete_media_exposures")
}

// ============================================
// AthleteFollowerSnapshot (docx §6 C-3 팬덤지수 - 최근 증가율 자동 계산용)
// cron job 으로 일 1회 YouTube/Instagram 팔로워 스냅샷 저장
// ============================================

model AthleteFollowerSnapshot {
  id            String   @id @default(uuid())
  athleteId     String   @map("athlete_id")
  source        String // YOUTUBE | INSTAGRAM | TWITTER (확장 가능)
  followerCount Int      @map("follower_count") // 해당 시점 팔로워/구독자 수
  totalViews    BigInt?  @map("total_views") // 해당 시점 누적 조회수 (옵션)
  capturedAt    DateTime @default(now()) @map("captured_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, source, capturedAt])
  @@index([athleteId, source, capturedAt(sort: Desc)])
  @@map("athlete_follower_snapshots")
}

// ============================================
// AthleteNewsArticle (docx §6 C-1 기사/외부 언급 자동 수집)
// 네이버 뉴스 검색 API / 다른 소스에서 수집한 기사 메타
// ============================================

model AthleteNewsArticle {
  id          String   @id @default(uuid())
  athleteId   String   @map("athlete_id")
  title       String
  url         String
  publisher   String? // 매체명 (예: 조선일보, 뉴시스)
  publishedAt DateTime @map("published_at")
  description String?  @db.Text // 본문 일부 (검색 결과 snippet)
  source      String   @default("NAVER_NEWS") // NAVER_NEWS | GOOGLE_NEWS | MANUAL
  language    String?  @default("ko")
  capturedAt  DateTime @default(now()) @map("captured_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, url])
  @@index([athleteId, publishedAt(sort: Desc)])
  @@map("athlete_news_articles")
}

// ═══════════════════════════════════════════════════════════════════
// 2026-07 전면 개편 Phase 1 — 슬롯 인벤토리·후원상품 (핸드오프 §18)
//  기존 SlotInstance/Auction 체계와 병행 운영. slotInstanceId 브릿지로 연동.
// ═══════════════════════════════════════════════════════════════════

// 슬롯 재고 상태 (핸드오프 §9.4)
enum SlotInventoryStatus {
  AVAILABLE // 구매 가능
  AUCTION_ACTIVE // 경매 진행 중
  HELD // 임시 예약 (결제 진행 중)
  SOLD // 계약 완료
  RESTRICTED // 사용 제한
  PENDING_APPROVAL // 승인 대기
  UNAVAILABLE // 해당 기간 판매 안 함
}

// 상품 기간 유형 (핸드오프 §10)
enum ProductDurationType {
  SINGLE_EVENT // 1회 출전 — 단일 출전 후원 캠페인
  DAYS_30 // 30일 브랜드 파트너
  MONTHS_6 // 6개월 시즌 파트너 (경매 금지)
  MONTHS_12 // 12개월 선수 공식 파트너 (경매 금지)
}

// 상품 유형 (핸드오프 §9.5)
enum ProductType {
  APPAREL // 착장 노출형
  SNS // SNS 연계형
  STORE // 매장 홍보형
  EVENT_CONTENT // 행사·콘텐츠형
  BUNDLE // 통합형
}

// 거래 방식 (핸드오프 §2.4 — CTA: 입찰하기/바로 구매/파트너십 제안)
enum ProductTransactionType {
  AUCTION
  BUY_NOW
  PROPOSAL
}

enum ProductApprovalStatus {
  DRAFT
  PENDING_ATHLETE
  PENDING_ADMIN
  APPROVED
  REJECTED
}

// 선수별 슬롯 기본 설정 (핸드오프 §18.4)
model AthleteSlot {
  id               String   @id @default(uuid())
  athleteId        String   @map("athlete_id")
  slotTemplateId   String   @map("slot_template_id")
  customName       String?  @map("custom_name")
  basePrice        Int      @map("base_price")
  baseGrade        String?  @map("base_grade")
  saleEnabled      Boolean  @default(true) @map("sale_enabled")
  approvalRequired Boolean  @default(false) @map("approval_required")
  restrictionNote  String?  @map("restriction_note")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  athlete      Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  slotTemplate SlotTemplate    @relation(fields: [slotTemplateId], references: [id])
  inventories  SlotInventory[]
  productSlots ProductSlot[]
  holds        InventoryHold[]

  @@unique([athleteId, slotTemplateId])
  @@map("athlete_slots")
}

// 기간별 슬롯 재고 (핸드오프 §18.5) — 중복판매 방지의 단일 진실 원천
model SlotInventory {
  id                String              @id @default(uuid())
  athleteSlotId     String              @map("athlete_slot_id")
  startDate         DateTime            @map("start_date")
  endDate           DateTime            @map("end_date")
  status            SlotInventoryStatus @default(AVAILABLE)
  reservedUntil     DateTime?           @map("reserved_until") // HELD 만료 시각
  heldByBrandId     String?             @map("held_by_brand_id") // 임시예약 점유 브랜드 (§13.2)
  contractId        String?             @map("contract_id")
  auctionId         String?             @map("auction_id")
  productId         String?             @map("product_id")
  slotInstanceId    String?             @map("slot_instance_id") // 기존 SlotInstance 연동 브릿지
  restrictionReason String?             @map("restriction_reason")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  athleteSlot AthleteSlot         @relation(fields: [athleteSlotId], references: [id], onDelete: Cascade)
  product     SponsorshipProduct? @relation(fields: [productId], references: [id])

  @@index([athleteSlotId, startDate, endDate])
  @@index([status])
  @@map("slot_inventories")
}

// 후원상품 (핸드오프 §18.6 — 기간 4종 × 유형 5종 × 거래 3종)
model SponsorshipProduct {
  id                  String                 @id @default(uuid())
  athleteId           String                 @map("athlete_id")
  productName         String                 @map("product_name")
  durationType        ProductDurationType    @map("duration_type")
  startDate           DateTime?              @map("start_date")
  endDate             DateTime?              @map("end_date")
  productType         ProductType            @default(APPAREL) @map("product_type")
  transactionType     ProductTransactionType @default(BUY_NOW) @map("transaction_type")
  basePrice           Int                    @default(0) @map("base_price")
  buyNowPrice         Int?                   @map("buy_now_price")
  auctionStartPrice   Int?                   @map("auction_start_price")
  minBidIncrement     Int?                   @map("min_bid_increment")
  reservePrice        Int?                   @map("reserve_price")
  minAppearanceCount  Int?                   @map("min_appearance_count")
  snsDeliverables     Json?                  @map("sns_deliverables")
  storeDeliverables   Json?                  @map("store_deliverables")
  eventDeliverables   Json?                  @map("event_deliverables")
  contentUsageRights  Json?                  @map("content_usage_rights")
  categoryExclusivity String?                @map("category_exclusivity")
  replacementPolicy   String?                @map("replacement_policy")
  approvalStatus      ProductApprovalStatus  @default(APPROVED) @map("approval_status")
  publicationStatus   String                 @default("PUBLIC") @map("publication_status") // PUBLIC | HIDDEN
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  athlete      Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  productSlots ProductSlot[]
  inventories  SlotInventory[]

  @@index([athleteId, publicationStatus])
  @@map("sponsorship_products")
}

// 상품-슬롯 연결 (핸드오프 §18.7)
model ProductSlot {
  id              String  @id @default(uuid())
  productId       String  @map("product_id")
  athleteSlotId   String  @map("athlete_slot_id")
  isPrimary       Boolean @default(false) @map("is_primary")
  additionalPrice Int     @default(0) @map("additional_price")

  product     SponsorshipProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  athleteSlot AthleteSlot        @relation(fields: [athleteSlotId], references: [id], onDelete: Cascade)

  @@unique([productId, athleteSlotId])
  @@map("product_slots")
}

// ============================================
// 개편 Phase 5 — 장기 파트너십 제안 (핸드오프 §14, WF-10)
// 6·12개월 상품은 경매가 금지되므로 제안이 유일한 계약 경로다.
// ============================================

enum ProposalStatus {
  DRAFT // 작성 중
  SUBMITTED // 제안 완료
  ADMIN_REVIEW // 관리자 검토
  ATHLETE_REVIEW // 선수 검토
  REVISION_REQUESTED // 수정 요청 (선수·관리자 → 브랜드)
  BRAND_REVISING // 브랜드 수정 중
  APPROVED // 승인
  REJECTED // 거절
  EXPIRED // 만료
  CONTRACTING // 계약 진행
  CONTRACTED // 계약 완료
}

model Proposal {
  id        String         @id @default(uuid())
  brandId   String         @map("brand_id")
  athleteId String         @map("athlete_id")
  status    ProposalStatus @default(DRAFT)

  // 1단계 기본기간
  startDate    DateTime            @map("start_date")
  endDate      DateTime            @map("end_date")
  durationType ProductDurationType @map("duration_type") // MONTHS_6 / MONTHS_12

  // 2단계 슬롯 (athleteSlotId 배열 + 우선순위)
  desiredSlots     Json?   @map("desired_slots")
  allowAlternative Boolean @default(true) @map("allow_alternative") // 대체 슬롯 허용

  // 3단계 활동
  minAppearances  Int?  @map("min_appearances") // 최소 출전 횟수
  snsActivity     Json? @map("sns_activity")
  storeVisits     Json? @map("store_visits")
  corporateEvents Json? @map("corporate_events")
  contentShoots   Json? @map("content_shoots")

  // 4단계 권리
  imageUsageScope    String? @map("image_usage_scope")
  imageUsageMonths   Int?    @map("image_usage_months")
  allowSecondaryEdit Boolean @default(false) @map("allow_secondary_edit")
  allowPaidMedia     Boolean @default(false) @map("allow_paid_media") // 광고 집행
  categoryExclusive  Boolean @default(false) @map("category_exclusive") // 업종 독점

  // 5단계 예산
  totalBudget     Int     @map("total_budget")
  installmentPlan Json?   @map("installment_plan") // 분할 결제 계획
  additionalCosts Json?   @map("additional_costs")
  brandNote       String? @map("brand_note")

  // 검토 결과
  reviewNote  String?   @map("review_note")
  reviewedBy  String?   @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  submittedAt DateTime? @map("submitted_at")
  expiresAt   DateTime? @map("expires_at")
  contractId  String?   @map("contract_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand   Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  athlete Athlete           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  history ProposalHistory[]

  @@index([brandId, status])
  @@index([athleteId, status])
  @@map("proposals")
}

// §14.3 수정 이력은 모두 저장한다
model ProposalHistory {
  id         String          @id @default(uuid())
  proposalId String          @map("proposal_id")
  fromStatus ProposalStatus? @map("from_status")
  toStatus   ProposalStatus  @map("to_status")
  actorId    String?         @map("actor_id") // 변경한 사용자
  actorRole  String?         @map("actor_role")
  note       String?
  changes    Json? // 변경된 필드 스냅샷
  createdAt  DateTime        @default(now()) @map("created_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
  @@map("proposal_histories")
}

// ============================================
// 개편 Phase 6 — 이행·증빙 (핸드오프 §OPS, 우선순위표 OPS-01~08)
// 계약·제안에서 약속한 활동을 항목 단위로 추적하고 증빙을 검수한다.
// ============================================

enum DeliverableType {
  APPAREL_WEAR // 착장 노출
  APPEARANCE // 대회 출전
  SNS_FEED
  SNS_STORY
  SNS_REELS
  STORE_VISIT // 매장 방문
  CORPORATE_EVENT // 기업 행사
  CONTENT_SHOOT // 콘텐츠 촬영
}

enum DeliverableStatus {
  PENDING // 예정
  IN_PROGRESS // 진행 중 (일부 이행)
  SUBMITTED // 증빙 제출, 검수 대기
  APPROVED // 검수 완료
  REJECTED // 반려 (재제출 필요)
  SUBSTITUTED // 대체이행으로 갈음
  CANCELLED
}

// §26.3 대체이행 수단
enum SubstitutionType {
  CARRY_OVER // 차기 출전 이월
  ALTERNATE_SLOT // 동일 등급 슬롯 변경
  SNS_CONTENT // SNS 콘텐츠 대체
  PARTIAL_REFUND // 부분 환불
  FULL_REFUND // 전액 환불
}

enum SubstitutionStatus {
  REQUESTED
  APPROVED
  REJECTED
}

model Deliverable {
  id             String            @id @default(uuid())
  contractId     String?           @map("contract_id")
  proposalId     String?           @map("proposal_id")
  athleteId      String            @map("athlete_id")
  brandId        String            @map("brand_id")
  type           DeliverableType
  title          String
  targetCount    Int               @default(1) @map("target_count")
  completedCount Int               @default(0) @map("completed_count")
  dueDate        DateTime?         @map("due_date")
  status         DeliverableStatus @default(PENDING)
  note           String?

  // 대체이행 (OPS-07/08)
  substitutionType   SubstitutionType?   @map("substitution_type")
  substitutionStatus SubstitutionStatus? @map("substitution_status")
  substitutionNote   String?             @map("substitution_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  athlete  Athlete               @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  brand    Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  evidence DeliverableEvidence[]

  @@index([athleteId, status])
  @@index([brandId, status])
  @@index([proposalId])
  @@map("deliverables")
}

model DeliverableEvidence {
  id            String    @id @default(uuid())
  deliverableId String    @map("deliverable_id")
  fileUrl       String    @map("file_url")
  fileType      String?   @map("file_type")
  linkUrl       String?   @map("link_url") // SNS 게시물 링크 등
  capturedAt    DateTime? @map("captured_at")
  note          String?
  status        String    @default("SUBMITTED") // SUBMITTED / APPROVED / REJECTED
  reviewNote    String?   @map("review_note")
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId, status])
  @@map("deliverable_evidence")
}

// ── AI 간편 매칭 (핸드오프 v1.0 §10) ──────────────────────────────
// 입력 조건과 추천 결과를 스냅샷으로 함께 저장한다 (§10.1 재현성 원칙).
// 추천 시점의 선수 지표·슬롯 가격이 이후에 바뀌어도 과거 요청/제안서는 당시 값을 유지한다.
model AiMatchRequest {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id") // 로그인 사용자 (비로그인 요청 허용)
  input     Json // 브랜드 유형·목적·선호 방식·선호 선수·예산·옵션
  results   Json? // 추천 스냅샷 { recommendations[], excludedPreferred[], dataAsOf, ruleVersion }
  status    String   @default("COMPLETED") // COMPLETED | EMPTY | ERROR
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("ai_match_requests")
}

// ── AI 심층매칭 v3 (§9) — 브랜드별 선수 선호/제외 피드백 ──────────
// '이 선수 제외'는 이후 모든 요청에서 hard exclude, '선호'는 가점 (§8)
model BrandAthletePreference {
  id         String   @id @default(uuid())
  userId     String   @map("user_id") // 브랜드 계정 userId
  athleteId  String   @map("athlete_id")
  preference String // PREFER | EXCLUDE
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, athleteId])
  @@map("brand_athlete_preferences")
}

// ══════════════════════════════════════════════════════════════
// 추천 PICK 신청·승인 (핸드오프 v1.0 §9 · §14.2)
//   기존 Contract(경매 기반)와 별개로, 복수 선수 조합 신청과
//   선수별 개별 승인을 다루기 위한 모델.
// ══════════════════════════════════════════════════════════════

enum SponsorshipApplicationStatus {
  DRAFT
  SUBMITTED
  PARTIAL_APPROVAL
  APPROVED
  REJECTED
  PAYMENT_PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ApplicationItemStatus {
  PENDING
  APPROVED
  NEEDS_REVISION
  REJECTED
  EXPIRED
}

model SponsorshipApplication {
  id            String                       @id @default(uuid())
  brandUserId   String                       @map("brand_user_id")
  brandId       String?                      @map("brand_id")
  sourceType    String                       @default("RECOMMEND_PICK") @map("source_type") // RECOMMEND_PICK | DIRECT_PICK
  sourceId      String?                      @map("source_id") // AiMatchRequest.id
  planKey       String?                      @map("plan_key") // STABLE | BALANCED | CHALLENGE
  planName      String?                      @map("plan_name")
  status        SponsorshipApplicationStatus @default(SUBMITTED)
  totalAmount   Int                          @default(0) @map("total_amount") // 공급가 합계(월)
  vatAmount     Int                          @default(0) @map("vat_amount")
  durationMonths Int                         @default(1) @map("duration_months")
  snapshot      Json? // 추천 결과·가격·조건 스냅샷 (BR-05 계약 스냅샷 고정)
  submittedAt   DateTime?                    @map("submitted_at")
  approvalDueAt DateTime?                    @map("approval_due_at") // 승인 유효기간 (기본 72h)
  paidAt        DateTime?                    @map("paid_at")
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")

  items   ApplicationItem[]
  reviews ApplicationReview[]

  @@index([brandUserId, createdAt])
  @@index([status])
  @@map("sponsorship_applications")
}

model ApplicationItem {
  id             String                @id @default(uuid())
  applicationId  String                @map("application_id")
  athleteId      String                @map("athlete_id")
  slotInstanceId String?               @map("slot_instance_id")
  slotCode       String?               @map("slot_code")
  slotName       String?               @map("slot_name")
  role           String? // 패치 노출 | SNS 콘텐츠 | 보조 노출·확장
  price          Int                   @default(0)
  status         ApplicationItemStatus @default(PENDING)
  reasonCode     String?               @map("reason_code")
  comment        String?
  reviewedAt     DateTime?             @map("reviewed_at")
  reviewedBy     String?               @map("reviewed_by")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  application SponsorshipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  athlete     Athlete                @relation(fields: [athleteId], references: [id])

  @@index([applicationId])
  @@index([athleteId, status])
  @@map("application_items")
}

model ApplicationReview {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  itemId        String?  @map("item_id")
  actorId       String?  @map("actor_id")
  actorRole     String?  @map("actor_role")
  action        String // SUBMIT | APPROVE | REVISION | REJECT | PAY | CANCEL
  reasonCode    String?  @map("reason_code")
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  application SponsorshipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("application_reviews")
}

// ══════════════════════════════════════════════════════════════
// 디지털 파트너 월 구독 (핸드오프 v1.0 §8.1)
//   경기복 부착 없이 온라인·팬스토어·등록매장에서 12개월 사용하는 상품.
//   신청·승인은 SponsorshipApplication과 별개로 구독 전용 흐름을 쓴다.
// ══════════════════════════════════════════════════════════════

enum DigitalApplicationStatus {
  DRAFT
  SUBMITTED
  NEEDS_REVISION
  ATHLETE_APPROVED
  REJECTED
  PAYMENT_PENDING
  ACTIVE
  PAST_DUE
  CANCEL_SCHEDULED
  EXPIRED
}

model DigitalPlan {
  id           String   @id @default(uuid())
  code         String   @unique // START | GROW | PLUS
  name         String
  monthlyPrice Int      @map("monthly_price")
  termMonths   Int      @default(12) @map("term_months")
  benefits     Json?
  exclusions   Json?
  capacity     Int      @default(10) // 선수당 기본 모집 수량
  sortOrder    Int      @default(0) @map("sort_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  applications DigitalApplication[]

  @@map("digital_plans")
}

model AthleteDigitalInventory {
  id                String   @id @default(uuid())
  athleteId         String   @map("athlete_id")
  planCode          String   @map("plan_code")
  capacity          Int      @default(10)
  reserved          Int      @default(0) // 승인/구독 중 수량
  priceMultiplier   Decimal  @default(1.0) @map("price_multiplier") @db.Decimal(4, 2)
  allowedCategories Json?    @map("allowed_categories")
  isOpen            Boolean  @default(true) @map("is_open")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, planCode])
  @@index([athleteId])
  @@map("athlete_digital_inventories")
}

model DigitalApplication {
  id            String                   @id @default(uuid())
  brandUserId   String                   @map("brand_user_id")
  athleteId     String                   @map("athlete_id")
  planId        String                   @map("plan_id")
  planCode      String                   @map("plan_code")
  status        DigitalApplicationStatus @default(SUBMITTED)
  monthlyAmount Int                      @map("monthly_amount")
  termMonths    Int                      @default(12) @map("term_months")
  category      String?
  region        String?
  homepage      String?
  storeCount    Int?                     @map("store_count")
  logoUrl       String?                  @map("logo_url")
  scopes        Json? // ['WEB_SNS','FANSTORE','STORE_POP']
  brandMessage  String?                  @map("brand_message")
  reasonCode    String?                  @map("reason_code")
  comment       String?
  submittedAt   DateTime?                @map("submitted_at")
  approvalDueAt DateTime?                @map("approval_due_at")
  reviewedAt    DateTime?                @map("reviewed_at")
  reviewedBy    String?                  @map("reviewed_by")
  effectiveFrom DateTime?                @map("effective_from")
  effectiveTo   DateTime?                @map("effective_to")
  nextBillingAt DateTime?                @map("next_billing_at")
  paidAt        DateTime?                @map("paid_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  athlete Athlete     @relation(fields: [athleteId], references: [id])
  plan    DigitalPlan @relation(fields: [planId], references: [id])

  @@index([brandUserId, createdAt])
  @@index([athleteId, status])
  @@map("digital_applications")
}

// ============================================
// 팬 참여 — 커뮤니티 · 팬레터 · 브랜드 추천 · 팬온도 (리디자인 v2.0 §팬 참여)
// ============================================

/// 선수 커뮤니티 글 (선수 소식 / 팬 응원 / 팬레터 / 경기 이야기 / 브랜드 추천)
model AthleteCommunityPost {
  id           String   @id @default(uuid())
  athleteId    String   @map("athlete_id")
  authorUserId String?  @map("author_user_id")
  authorRole   String   @default("FAN") @map("author_role") // ATHLETE | FAN | ADMIN
  type         String   @default("CHEER") // NOTICE | CHEER | LETTER | MATCH_TALK | BRAND
  content      String
  imageUrl     String?  @map("image_url")
  /// 팬레터는 선수와 작성자 본인만 열람
  isPrivate    Boolean  @default(false) @map("is_private")
  likeCount    Int      @default(0) @map("like_count")
  commentCount Int      @default(0) @map("comment_count")
  isHidden     Boolean  @default(false) @map("is_hidden")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  athlete  Athlete            @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  author   User?              @relation(name: "CommunityPosts", fields: [authorUserId], references: [id], onDelete: SetNull)
  comments CommunityComment[]
  likes    CommunityLike[]

  @@index([athleteId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("athlete_community_posts")
}

model CommunityComment {
  id           String   @id @default(uuid())
  postId       String   @map("post_id")
  authorUserId String   @map("author_user_id")
  content      String
  isHidden     Boolean  @default(false) @map("is_hidden")
  createdAt    DateTime @default(now()) @map("created_at")

  post   AthleteCommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User                 @relation(name: "CommunityComments", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("community_comments")
}

model CommunityLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post AthleteCommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User                 @relation(name: "CommunityLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("community_likes")
}

/// 팬이 선수에게 제안하는 협업 브랜드 — 검토 후 브랜드 적합도에 반영
model FanBrandSuggestion {
  id         String    @id @default(uuid())
  athleteId  String    @map("athlete_id")
  fanUserId  String    @map("fan_user_id")
  category   String
  brandName  String?   @map("brand_name")
  reason     String?
  /// 이해관계 자가표시 (§9.1) — NONE | SELF | FAMILY | AFFILIATED
  interest   String    @default("NONE")
  /// 공개범위 — 기본 비공개, 승인된 요약만 공개 (§9.1)
  isPublic   Boolean   @default(false) @map("is_public")
  /// 파이프라인 (§9.1) — RECEIVED | REVIEWING | DELIVERED | INTERESTED | ADOPTED | HOLD | CLOSED
  /// (구 데이터의 PENDING/ACCEPTED/REJECTED 는 화면에서 RECEIVED/ADOPTED/CLOSED 로 읽는다)
  status     String    @default("RECEIVED")
  statusNote String?   @map("status_note")
  reviewedAt DateTime? @map("reviewed_at")
  reviewedBy String?   @map("reviewed_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  fan     User    @relation(name: "FanBrandSuggestions", fields: [fanUserId], references: [id], onDelete: Cascade)

  @@index([athleteId, status])
  @@index([fanUserId, createdAt])
  @@map("fan_brand_suggestions")
}

/// 팬온도 원장 — 활동 1건 = 1행. 온도는 이 행들의 합이며 임의 보정하지 않는다.
/// deltaMilli 는 0.001°C 단위 정수 (부동소수 누적 오차 방지).
/// (athleteId, userId, source, refType, refId) 유니크로 중복 적립을 막는다.
model FanTemperatureEvent {
  id         String   @id @default(uuid())
  athleteId  String   @map("athlete_id")
  userId     String   @map("user_id")
  source     String // VOTE | LETTER | COMMUNITY | STORE | BRAND_SUGGEST | FAVORITE | ATHLETE_REPLY
  deltaMilli Int      @map("delta_milli")
  refType    String   @map("ref_type")
  refId      String   @map("ref_id")
  /// 유효성 (§5.5) — VALID | PENDING_REVIEW | INVALID
  validity   String   @default("VALID")
  /// 어뷰징 위험도 0~100 (§15.1)
  riskScore  Int      @default(0) @map("risk_score")
  /// 금액성 활동의 원값 (스토어 구매액 등) — 로그 스케일 환산에 쓴다
  amount     Int?
  createdAt  DateTime @default(now()) @map("created_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  user    User    @relation(name: "FanTemperatureEvents", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([athleteId, userId, source, refType, refId], name: "unique_temperature_event")
  @@index([athleteId, createdAt])
  @@index([userId, athleteId])
  @@map("fan_temperature_events")
}

// ============================================
// 직접 선택 PICK — 오퍼 · 견적 초안 · 홀드 (핸드오프 v1.0 §4 · §6 · §7 · §12)
// ============================================

/// 선수별 온라인/부가 상품 — 오프라인 착장 슬롯과 별개로 판매하는 오퍼
/// ONLINE_ONLY 는 offlineUse=false 가 강제된다 (§12.3)
model AthleteOfferProduct {
  id           String   @id @default(uuid())
  athleteId    String   @map("athlete_id")
  code         String // ONLINE_PROFILE_PATCH | GROWTH_MARKET_IMAGE | STORE_PRINT | SNS_FEED ...
  name         String
  type         String   @default("ONLINE_ONLY") // ONLINE_ONLY | SOCIAL_CONTENT | STORE_MARKET | APPEARANCE
  description  String?
  price        Int
  unit         String   @default("MONTH") // MONTH | ONCE
  minMonths    Int      @default(1) @map("min_months")
  offlineUse   Boolean  @default(false) @map("offline_use")
  onlineUse    Boolean  @default(true) @map("online_use")
  printUse     Boolean  @default(false) @map("print_use")
  secondaryUse Boolean  @default(false) @map("secondary_use")
  capacity     Int      @default(0) // 0 = 무제한
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  athlete Athlete          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  items   DirectPickItem[]

  @@unique([athleteId, code])
  @@index([athleteId, isActive])
  @@map("athlete_offer_products")
}

/// 견적함(초안) — 복수 선수·복수 상품을 한 건으로 묶는다 (§7)
model DirectPickDraft {
  id             String    @id @default(uuid())
  brandUserId    String    @map("brand_user_id")
  status         String    @default("CONFIGURING") // CONFIGURING | HELD | VALIDATION_REQUIRED | READY_TO_REQUEST | SUBMITTED | CONVERTED | EXPIRED | CANCELLED
  revision       Int       @default(1)
  title          String?
  budget         Int?
  note           String?
  quoteVersion   String?   @map("quote_version")
  quoteExpiresAt DateTime? @map("quote_expires_at")
  applicationId  String?   @map("application_id") // 승인 요청 전환 후 SponsorshipApplication.id
  submittedAt    DateTime? @map("submitted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  items DirectPickItem[]

  @@index([brandUserId, updatedAt])
  @@map("direct_pick_drafts")
}

/// 견적 항목 — 오프라인 슬롯 1개 또는 온라인 상품 1개
model DirectPickItem {
  id             String    @id @default(uuid())
  draftId        String    @map("draft_id")
  athleteId      String    @map("athlete_id")
  kind           String    @default("OFFLINE_SLOT") // OFFLINE_SLOT | ONLINE_PRODUCT
  athleteSlotId  String?   @map("athlete_slot_id")
  slotCode       String?   @map("slot_code")
  slotName       String?   @map("slot_name")
  offerProductId String?   @map("offer_product_id")
  durationCode   String    @default("SINGLE_EVENT") @map("duration_code")
  months         Int       @default(1)
  startDate      DateTime? @map("start_date")
  saleMode       String    @default("BUY_NOW") @map("sale_mode") // BUY_NOW | NEGOTIATED | AUCTION | LONG_TERM
  addOns         Json? // [{code,label,count,price}]
  scopes         Json? // ['OFFLINE','ONLINE','PRINT','SECONDARY']
  basePrice      Int       @default(0) @map("base_price")
  durationAmount Int       @default(0) @map("duration_amount")
  addOnAmount    Int       @default(0) @map("add_on_amount")
  subtotal       Int       @default(0)
  status         String    @default("OK") // OK | NEEDS_CONFIRMATION | CONFLICT
  conflictCode   String?   @map("conflict_code")
  conflictNote   String?   @map("conflict_note")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  draft   DirectPickDraft      @relation(fields: [draftId], references: [id], onDelete: Cascade)
  athlete Athlete              @relation(fields: [athleteId], references: [id])
  offer   AthleteOfferProduct? @relation(fields: [offerProductId], references: [id])
  hold    InventoryHold?

  @@index([draftId])
  @@index([athleteId])
  @@map("direct_pick_items")
}

/// 임시 점유 — 견적함 담기 시 15분, 결제 진입 시 10분 1회 연장 (§6.2)
model InventoryHold {
  id             String    @id @default(uuid())
  draftItemId    String    @unique @map("draft_item_id")
  athleteSlotId  String?   @map("athlete_slot_id")
  brandUserId    String    @map("brand_user_id")
  qty            Int       @default(1)
  expiresAt      DateTime  @map("expires_at")
  extendedAt     DateTime? @map("extended_at")
  releasedAt     DateTime? @map("released_at")
  idempotencyKey String    @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")

  item        DirectPickItem @relation(fields: [draftItemId], references: [id], onDelete: Cascade)
  athleteSlot AthleteSlot?   @relation(fields: [athleteSlotId], references: [id])

  @@index([athleteSlotId, expiresAt])
  @@map("inventory_holds")
}

// ============================================
// 지금 가능한 후원 — 완성형 상품(Offer) · 진열 · 보관함 (핸드오프 v1.0 2026-08-22)
// ============================================

/// 관리자·선수가 사전 구성해 발행하는 완성형 후원상품
model Offer {
  id        String @id @default(uuid())
  code      String @unique // OFFER-0901 등 내부 코드
  slug      String @unique
  title     String
  subtitle  String?
  summary   String?
  type      String @default("EVENT_SLOT") // EVENT_SLOT | READY_NOW | ONLINE_SUBSCRIPTION | CONTENT_PACKAGE | LOCAL_ACTIVATION | FAN_COMMERCE | LIMITED_DROP | AUCTION_LINK | CUSTOM_CURATED
  status    String @default("DRAFT") // DRAFT | REVIEW | SCHEDULED | PUBLISHED | LOW_STOCK | PAUSED | SOLD_OUT | EXPIRED | ARCHIVED
  version   Int    @default(1)

  heroImageUrl String? @map("hero_image_url")
  /// 이 상품이 맞는 브랜드 업종 (타겟 카테고리)
  categories   String[] @default([])
  /// 노출 채널 (대회 현장 · 공식 중계 · 대회 웹사이트 · SNS 등)
  channels     String[] @default([])
  /// 목적 태그 (인지 · 콘텐츠 · 구매 · 지역 · ESG · 팬참여)
  purposes     String[] @default([])

  // 일정
  salesFrom     DateTime? @map("sales_from")
  salesTo       DateTime? @map("sales_to")
  executionFrom DateTime? @map("execution_from")
  executionTo   DateTime? @map("execution_to")
  eventId       String?   @map("event_id")
  leadTimeDays  Int       @default(7) @map("lead_time_days")
  durationCode  String    @default("SINGLE_EVENT") @map("duration_code")
  months        Int       @default(1)

  // 가격 (§9.3)
  priceType      String  @default("FIXED") @map("price_type") // FIXED | SUBSCRIPTION | NEGOTIABLE | AUCTION | DISCOUNTED | MIXED
  supplyAmount   Int     @default(0) @map("supply_amount") // 공급가 (VAT 별도)
  originalPrice  Int?    @map("original_price")
  discountReason String? @map("discount_reason")
  costAmount     Int     @default(0) @map("cost_amount") // 선수 정산 예상 원가
  platformFee    Int     @default(0) @map("platform_fee")

  // 재고 (§9.1)
  stockMode    String @default("CAPACITY") @map("stock_mode") // UNIQUE | CAPACITY | UNLIMITED | DERIVED | MANUAL
  capacity     Int    @default(1)
  reservedQty  Int    @default(0) @map("reserved_qty")
  soldQty      Int    @default(0) @map("sold_qty")
  holdMinutes  Int    @default(15) @map("hold_minutes")

  // 승인 (§9.4)
  approvalMode  String    @default("ATHLETE_APPROVAL") @map("approval_mode") // PRE_APPROVED | ATHLETE_APPROVAL | NEGOTIATION | AUCTION
  preApprovedAt DateTime? @map("pre_approved_at")
  preApprovalTo DateTime? @map("pre_approval_to") // 사전승인 유효기간
  preApprovalMaxQty Int?  @map("pre_approval_max_qty")

  // 권리 (§7.3 · §12.3)
  offlineUse   Boolean @default(true) @map("offline_use")
  onlineUse    Boolean @default(true) @map("online_use")
  printUse     Boolean @default(false) @map("print_use")
  secondaryUse Boolean @default(false) @map("secondary_use")
  territory    String  @default("국내")
  rightsNote   String? @map("rights_note")
  restrictions Json? // string[]

  /// 예상성과 — 범위·근거·기준일·신뢰도를 함께 저장한다 (§5.2). 보장값이 아니다.
  expectedMetrics Json?     @map("expected_metrics") // [{metric,minValue,maxValue,unit,basis}]
  methodology     String?
  methodVersion   String?   @map("method_version")
  confidence      String?   // HIGH | MEDIUM | LIMITED
  dataAsOf        DateTime? @map("data_as_of")
  guaranteed      Boolean   @default(false)
  assumptions     Json?

  // 운영
  ownerName    String?   @map("owner_name")
  reviewerName String?   @map("reviewer_name")
  publishedAt  DateTime? @map("published_at")
  scheduledAt  DateTime? @map("scheduled_at")
  changeReason String?   @map("change_reason")
  pauseReason  String?   @map("pause_reason")

  // 성과 카운터 (§11.4)
  viewCount   Int @default(0) @map("view_count")
  detailCount Int @default(0) @map("detail_count")
  saveCount   Int @default(0) @map("save_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  athletes   OfferAthlete[]
  components OfferComponent[]
  options    OfferOption[]
  placements OfferPlacement[]
  saved      SavedOffer[]
  cartItems  OfferCartItem[]
  audits     OfferAudit[]

  @@index([status, salesTo])
  @@index([type, status])
  @@map("offers")
}

/// 상품에 포함된 선수 (복수 가능)
model OfferAthlete {
  id        String  @id @default(uuid())
  offerId   String  @map("offer_id")
  athleteId String  @map("athlete_id")
  role      String? // 대표 · 참여
  sortOrder Int     @default(0) @map("sort_order")

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@unique([offerId, athleteId])
  @@map("offer_athletes")
}

/// 상품 구성요소 원자 단위 (§3.3)
model OfferComponent {
  id            String @id @default(uuid())
  offerId       String @map("offer_id")
  componentType String @map("component_type") // ATHLETE | SLOT | CONTENT | ONLINE_ASSET | VISIT | MARKET | REPORT | GUARANTEE
  label         String
  athleteId     String? @map("athlete_id")
  athleteSlotId String? @map("athlete_slot_id")
  slotCode      String? @map("slot_code")
  offerProductId String? @map("offer_product_id")
  /// 1건당 필요한 원자재고 수량 (DERIVED 계산용)
  requiredQty   Int    @default(1) @map("required_qty")
  quantity      Int    @default(1)
  unitPrice     Int    @default(0) @map("unit_price")
  note          String?
  sortOrder     Int    @default(0) @map("sort_order")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@map("offer_components")
}

/// 브랜드가 구매 시 바꿀 수 있는 범위 (§3.4)
model OfferOption {
  id        String  @id @default(uuid())
  offerId   String  @map("offer_id")
  kind      String // LOCKED | SELECT_ONE | ADD_ON | QUANTITY | BRAND_INPUT | NEGOTIABLE
  code      String
  label     String
  /// SELECT_ONE 선택지 / QUANTITY 범위 / ADD_ON 단가
  choices   Json?
  minQty    Int?    @map("min_qty")
  maxQty    Int?    @map("max_qty")
  addPrice  Int     @default(0) @map("add_price")
  required  Boolean @default(false)
  sortOrder Int     @default(0) @map("sort_order")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, code])
  @@map("offer_options")
}

/// 진열 배치 (§8.2)
model OfferPlacement {
  id          String    @id @default(uuid())
  offerId     String    @map("offer_id")
  surface     String // MAIN | SPONSOR_LANDING | AVAILABLE_LIST | ATHLETE | DASHBOARD
  sectionKey  String    @map("section_key") // READY_NOW | CLOSING_SOON | NEW | LOW_BUDGET | EVENT | ONLINE_ONLY | LOCAL | AUCTION
  rank        Int       @default(100)
  pinned      Boolean   @default(false)
  activeFrom  DateTime? @map("active_from")
  activeTo    DateTime? @map("active_to")
  audience    Json? // {categories?:string[], budgetMax?:number, regions?:string[]}
  badge       String?
  reason      String? // 운영 · 제휴 · 자동규칙
  isSponsored Boolean   @default(false) @map("is_sponsored") // 유료/제휴 우선노출 표시 (§4.4)
  dailyCap    Int?      @map("daily_cap")
  status      String    @default("ACTIVE") // ACTIVE | PAUSED | EXPIRED
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([surface, sectionKey, rank])
  @@index([offerId])
  @@map("offer_placements")
}

/// 보관함 — 나중에 보기 (hold 없음)
model SavedOffer {
  id          String   @id @default(uuid())
  brandUserId String   @map("brand_user_id")
  offerId     String   @map("offer_id")
  createdAt   DateTime @default(now()) @map("created_at")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([brandUserId, offerId])
  @@index([brandUserId, createdAt])
  @@map("saved_offers")
}

/// 장바구니 line — 주문군은 조회 시 계산한다 (§6.2)
model OfferCartItem {
  id          String   @id @default(uuid())
  brandUserId String   @map("brand_user_id")
  offerId     String   @map("offer_id")
  quantity    Int      @default(1)
  startDate   DateTime? @map("start_date")
  /// 선택한 옵션 {code: value}
  options     Json?
  /// 담은 시점의 안내 금액 — 결제 금액은 항상 서버가 다시 계산한다
  quotedAmount Int     @default(0) @map("quoted_amount")
  quotedAt    DateTime @default(now()) @map("quoted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([brandUserId, createdAt])
  @@map("offer_cart_items")
}

/// 발행·변경·일시정지 감사 로그 (§11.3 · §13.4)
model OfferAudit {
  id        String   @id @default(uuid())
  offerId   String   @map("offer_id")
  actorId   String?  @map("actor_id")
  actorName String?  @map("actor_name")
  action    String // CREATE | UPDATE | VALIDATE | PUBLISH | PAUSE | RESUME | PLACEMENT | PRICE | ARCHIVE
  field     String?
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, createdAt])
  @@map("offer_audits")
}

// ============================================
// 팬 참여 v1.0 — 팬온도 스냅샷 · 기여도 · 응원편지 · 연말 캠페인
// (핸드오프 v1.0 2026-08-22 §6 · §9 · §12)
// ============================================

/// 팬온도 일배치 스냅샷 — 산식 버전과 함께 저장해 과거 리포트를 재현한다 (§12.1)
model FanTemperatureSnapshot {
  id             String   @id @default(uuid())
  athleteId      String   @map("athlete_id")
  /// 0~100 공개 온도 (소수 1자리)
  score          Float
  /// 구성요소별 정규화 점수 {activeFans,vote,community,store,continuity,athleteReply}
  components     Json
  sampleSize     Int      @map("sample_size")
  confidence     Float    @default(1)
  penalties      Float    @default(0)
  formulaVersion String   @map("formula_version")
  /// 계산 기준일 (KST 날짜)
  date           DateTime
  createdAt      DateTime @default(now()) @map("created_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, date, formulaVersion])
  @@index([athleteId, date])
  @@map("fan_temperature_snapshots")
}

/// 팬 개인의 선수별 기여도 (§12) — 구매액이 아니라 활동 다양성·지속성 중심
model FanContribution {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  athleteId      String    @map("athlete_id")
  /// 0~100
  score          Float     @default(0)
  level          Int       @default(1)
  /// 참여한 활동 영역 수 (VOTE / 커뮤니티 / 스토어·후원 / 브랜드추천)
  diversity      Int       @default(0)
  /// 최근 4주 중 활동한 주 수
  streakWeeks    Int       @default(0) @map("streak_weeks")
  letters        Int       @default(0)
  voteCount      Int       @default(0) @map("vote_count")
  postCount      Int       @default(0) @map("post_count")
  storeCount     Int       @default(0) @map("store_count")
  recommendCount Int       @default(0) @map("recommend_count")
  firstActiveAt  DateTime? @map("first_active_at")
  lastActivityAt DateTime? @map("last_activity_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([userId, athleteId])
  @@index([athleteId, score])
  @@map("fan_contributions")
}

/// 응원편지 (§9.2) — 월 2회, 공개/비공개. 선수는 월 1회 감사 메시지로 갈음할 수 있다
model FanLetter {
  id           String    @id @default(uuid())
  athleteId    String    @map("athlete_id")
  userId       String    @map("user_id")
  title        String?
  content      String
  imageUrl     String?   @map("image_url")
  isPublic     Boolean   @default(true) @map("is_public")
  /// AutoMod 결과 (§10.2) — PUBLISHED | PENDING | BLOCKED
  status       String    @default("PUBLISHED")
  moderationNote String? @map("moderation_note")
  /// 선수 감사 메시지 (개별 답장 의무 없음)
  thanksAt     DateTime? @map("thanks_at")
  thanksText   String?   @map("thanks_text")
  createdAt    DateTime  @default(now()) @map("created_at")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, createdAt])
  @@index([userId, createdAt])
  @@map("fan_letters")
}

/// 연말 팬 이름 광고 캠페인 (§9.3) — 시즌형 보상 캠페인
model FanAdCampaign {
  id          String    @id @default(uuid())
  title       String
  description String?
  season      String
  startAt     DateTime  @map("start_at")
  endAt       DateTime  @map("end_at")
  /// 심사 가중치 {activity,continuity,letter,mission}
  criteria    Json?
  status      String    @default("OPEN") // OPEN | JUDGING | CLOSED | CANCELLED
  notice      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("fan_ad_campaigns")
}

// ============================================
// 팬스토어 v1.0 — 외부몰 연결형 (핸드오프 v1.0 2026-08-22 §8)
// MVP는 SPONPIK 내부 결제를 하지 않는다. 협업 스토리·혜택을 보여주고 브랜드몰로 보낸다.
// 외부몰 주문을 SPONPIK 주문처럼 표시하지 않는 것이 이 모델의 핵심 제약이다 (§8.2).
// ============================================

/// 선수 x 브랜드 협업 스토어
model FanStore {
  id            String    @id @default(uuid())
  athleteId     String    @map("athlete_id")
  brandId       String?   @map("brand_id")
  /// 브랜드 표시명 (미등록 브랜드도 협업 가능)
  brandName     String    @map("brand_name")
  slug          String    @unique
  title         String
  summary       String?
  /// 협업 이유 — 팬이 "왜 이 브랜드인지" 이해할 수 있게 (§8.2)
  story         String?
  heroImageUrl  String?   @map("hero_image_url")
  /// 혜택과 제휴코드 (§8.1 제휴코드 모델)
  benefitLabel  String?   @map("benefit_label")
  benefitCode   String?   @map("benefit_code")
  benefitDesc   String?   @map("benefit_desc")
  /// 판매·배송·환불 책임주체. 화면에 반드시 노출한다 (§8.2 · §8.4)
  responsible   String    @default("BRAND") // BRAND | SPONPIK
  sellerName    String?   @map("seller_name")
  sellerContact String?   @map("seller_contact")
  /// 외부몰 기본 이동 주소
  externalUrl   String?   @map("external_url")
  status        String    @default("DRAFT") // DRAFT | PUBLISHED | CLOSED
  startAt       DateTime? @map("start_at")
  endAt         DateTime? @map("end_at")
  viewCount     Int       @default(0) @map("view_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  athlete  Athlete           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  products FanStoreProduct[]
  clicks   FanStoreClick[]

  @@index([status, startAt])
  @@index([athleteId])
  @@map("fan_stores")
}

/// 스토어에 진열되는 상품 — 가격·배송·반품·판매자·광고성 표시가 모두 필수다 (§8.2)
model FanStoreProduct {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  name          String
  imageUrl      String?  @map("image_url")
  description   String?
  price         Int
  originalPrice Int?     @map("original_price")
  /// 외부몰 상품 주소
  externalUrl   String   @map("external_url")
  shippingInfo  String?  @map("shipping_info")
  returnInfo    String?  @map("return_info")
  sellerName    String?  @map("seller_name")
  stockNote     String?  @map("stock_note")
  /// 광고성 표시 (§8.2) — 협찬·유료광고 여부
  isSponsored   Boolean  @default(true) @map("is_sponsored")
  /// 구매확정 후 적립률 (§7.2 STORE_PURCHASE). null 이면 적립 없음
  pointRate     Float?   @map("point_rate")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  store  FanStore        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  clicks FanStoreClick[]

  @@index([storeId, sortOrder])
  @@map("fan_store_products")
}

/// 외부몰 이동 로그 — 익명 click_id 로 전환을 추적한다 (§8.3)
/// 브랜드 postback 또는 월 정산 파일로 구매확정이 회신되면 confirmedAt 이 채워진다.
model FanStoreClick {
  id          String    @id @default(uuid())
  clickId     String    @unique @map("click_id")
  storeId     String    @map("store_id")
  productId   String?   @map("product_id")
  userId      String?   @map("user_id")
  utm         String?
  /// 브랜드 회신 결과
  confirmedAt DateTime? @map("confirmed_at")
  amount      Int?
  createdAt   DateTime  @default(now()) @map("created_at")

  store   FanStore         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product FanStoreProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([userId, createdAt])
  @@map("fan_store_clicks")
}

// ============================================
// 팬 운영 관리자 v1.0 (핸드오프 v1.0 2026-08-22 §18.2 A01~A12)
// 원칙: 점수·잔액을 관리자가 직접 고치지 않는다. 사유·승인자·감사로그가 남는 조치만 허용한다.
// ============================================

/// 콘텐츠 검수 큐 (A04) — AI 1차 판정 결과를 사람이 확인한다 (§10.2)
model FanModerationItem {
  id            String    @id @default(uuid())
  /// POST | COMMENT | LETTER | BRAND_SUGGEST
  targetType    String    @map("target_type")
  targetId      String    @map("target_id")
  authorUserId  String?   @map("author_user_id")
  athleteId     String?   @map("athlete_id")
  excerpt       String?
  /// P0(긴급) | P1(높음) | P2(보통) | P3(낮음)
  risk          String    @default("P2")
  /// AI 판정 0~100 과 적용 정책 코드
  aiScore       Int?      @map("ai_score")
  policies      String[]  @default([])
  /// 자동 판정 결과 — AUTO_APPROVED | AUTO_BLOCKED | PENDING
  autoResult    String    @default("PENDING") @map("auto_result")
  /// PENDING | APPROVED | HIDDEN | EDIT_REQUESTED | SANCTION_REVIEW
  status        String    @default("PENDING")
  /// SLA 마감 시각 — 초과분은 대시보드 예외 큐로 올라간다
  slaDueAt      DateTime? @map("sla_due_at")
  decidedBy     String?   @map("decided_by")
  decidedAt     DateTime? @map("decided_at")
  decisionCode  String?   @map("decision_code")
  decisionNote  String?   @map("decision_note")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([targetType, targetId])
  @@index([status, risk, createdAt])
  @@index([slaDueAt])
  @@map("fan_moderation_items")
}

/// 팬 신고 (A05) — 신고자 정보는 익명 처리한다 (§10.3)
model FanReport {
  id            String    @id @default(uuid())
  code          String    @unique
  reporterId    String    @map("reporter_id")
  targetType    String    @map("target_type") // POST | COMMENT | LETTER | USER
  targetId      String    @map("target_id")
  targetUserId  String?   @map("target_user_id")
  reason        String
  detail        String?
  evidenceUrls  String[]  @default([]) @map("evidence_urls")
  risk          String    @default("P2")
  /// RECEIVED | CLASSIFIED | ACTIONED | CLOSED
  status        String    @default("RECEIVED")
  slaDueAt      DateTime? @map("sla_due_at")
  assignedTo    String?   @map("assigned_to")
  memo          String?
  closedAt      DateTime? @map("closed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sanctions FanSanction[]
  appeals   FanAppeal[]

  @@index([status, risk, createdAt])
  @@index([targetUserId, createdAt])
  @@map("fan_reports")
}

/// 제재 (A05) — 누적 적용. 영구 정지는 관리자 2인 승인이 필요하다
model FanSanction {
  id           String    @id @default(uuid())
  reportId     String?   @map("report_id")
  userId       String    @map("user_id")
  /// WARNING | FEATURE_LIMIT | SUSPEND | PERMANENT
  level        String
  days         Int?
  reason       String
  /// PENDING_APPROVAL | ACTIVE | LIFTED | EXPIRED
  status       String    @default("ACTIVE")
  createdBy    String    @map("created_by")
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  expiresAt    DateTime? @map("expires_at")
  liftedBy     String?   @map("lifted_by")
  liftedAt     DateTime? @map("lifted_at")
  liftReason   String?   @map("lift_reason")
  createdAt    DateTime  @default(now()) @map("created_at")

  report FanReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("fan_sanctions")
}

/// 이의제기 (A05) — 제재를 받은 팬이 소명한다
model FanAppeal {
  id         String    @id @default(uuid())
  code       String    @unique
  reportId   String?   @map("report_id")
  sanctionId String?   @map("sanction_id")
  userId     String    @map("user_id")
  statement  String
  /// RECEIVED | REVIEWING | UPHELD | REDUCED | LIFTED
  status     String    @default("RECEIVED")
  decidedBy  String?   @map("decided_by")
  decidedAt  DateTime? @map("decided_at")
  decision   String?
  createdAt  DateTime  @default(now()) @map("created_at")

  report FanReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("fan_appeals")
}

/// 배치 실행 로그 (A01 · A06) — 팬온도 계산·포인트 정산·만료 등
model FanBatchRun {
  id          String    @id @default(uuid())
  job         String
  status      String    @default("RUNNING") // RUNNING | SUCCESS | FAILED
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  durationMs  Int?      @map("duration_ms")
  processed   Int       @default(0)
  succeeded   Int       @default(0)
  failed      Int       @default(0)
  nextRunAt   DateTime? @map("next_run_at")
  message     String?

  @@index([job, startedAt])
  @@map("fan_batch_runs")
}

/// 팬온도 산식 버전 (A06) — 가중치를 바꾸면 새 버전을 발행한다. 과거 스냅샷은 유지한다
model FanTempFormula {
  id          String    @id @default(uuid())
  version     String    @unique
  /// {activeFans,vote,community,store,continuity,athleteReply} 합계 100
  weights     Json
  minSample   Int       @default(30) @map("min_sample")
  windowDays  Int       @default(30) @map("window_days")
  recentBoost Float     @default(1.3) @map("recent_boost")
  /// DRAFT | ACTIVE | RETIRED
  status      String    @default("DRAFT")
  note        String?
  effectiveAt DateTime? @map("effective_at")
  retiredAt   DateTime? @map("retired_at")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status, effectiveAt])
  @@map("fan_temp_formulas")
}

/// 포인트 정책 버전 (A07) — 적립·사용·만료 규칙을 통째로 버전으로 관리한다
model PointPolicyVersion {
  id          String    @id @default(uuid())
  version     String    @unique
  earnRules   Json      @map("earn_rules")
  spendRules  Json      @map("spend_rules")
  expiry      Json
  summary     String?
  /// DRAFT | PUBLISHED | RETIRED
  status      String    @default("DRAFT")
  publishedAt DateTime? @map("published_at")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status, publishedAt])
  @@map("point_policy_versions")
}

/// 포인트 캠페인 (A07) — 총 예산과 1인 상한을 반드시 둔다
model PointCampaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  totalBudget Int      @map("total_budget")
  perUserCap  Int      @map("per_user_cap")
  spent       Int      @default(0)
  startAt     DateTime @map("start_at")
  endAt       DateTime @map("end_at")
  target      String   @default("ALL")
  status      String   @default("DRAFT") // DRAFT | ACTIVE | PAUSED | CLOSED
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, startAt])
  @@map("point_campaigns")
}

/// 수동 포인트 조정 (A08) — 사유·케이스ID 필수, 10,000P 초과는 2인 승인
model PointAdjustment {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  delta        Int
  reason       String
  caseId       String    @map("case_id")
  evidenceUrl  String?   @map("evidence_url")
  /// PENDING | APPROVED | REJECTED | APPLIED
  status       String    @default("PENDING")
  requestedBy  String    @map("requested_by")
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  appliedTxId  String?   @map("applied_tx_id")
  rejectReason String?   @map("reject_reason")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("point_adjustments")
}

// ============================================
// SPONPIK 소개 · 통합 콘텐츠 v1.0
// (핸드오프 v1.0 2026-08-22 — 소개 허브 / 매칭사례 / 성과보장 / 브랜드 / CMS)
//
// 원칙
//  - 출처 없는 성과 수치는 게시할 수 없다 (§5.4 게시 차단).
//  - 성과보장 정책은 계약 시점 스냅샷으로 고정하고 소급 적용하지 않는다 (§8.2).
//  - 권리(초상·로고·인용)가 만료되면 자동 비노출 큐로 보낸다 (§10.4).
// ============================================

/// 소개 페이지 (CMS) — 블록 조합으로 렌더링한다 (§11.2)
model ContentPage {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  menuLabel   String?   @map("menu_label")
  menuDesc    String?   @map("menu_desc")
  /// DRAFT | IN_REVIEW | APPROVED | SCHEDULED | PUBLISHED | ARCHIVED
  status      String    @default("DRAFT")
  version     Int       @default(1)
  locale      String    @default("KO")
  seoTitle    String?   @map("seo_title")
  seoDesc     String?   @map("seo_desc")
  ogImageUrl  String?   @map("og_image_url")
  sortOrder   Int       @default(0) @map("sort_order")
  scheduledAt DateTime? @map("scheduled_at")
  publishedAt DateTime? @map("published_at")
  publishedBy String?   @map("published_by")
  updatedBy   String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  blocks ContentBlock[]

  @@index([status, sortOrder])
  @@map("content_pages")
}

/// 페이지를 구성하는 블록 (§11.2) — 타입별 허용 페이지와 검증 규칙이 다르다
model ContentBlock {
  id        String   @id @default(uuid())
  pageId    String   @map("page_id")
  /// HERO | FEATURE_GRID | CASE_CAROUSEL | METRIC_STRIP | STEPS | FAQ | BRAND_GRID | INSTAGRAM_CTA | LEGAL_NOTE
  type      String
  name      String?
  /// 블록별 데이터 (제목·설명·CTA·항목 배열 등)
  payload   Json
  visible   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
  @@map("content_blocks")
}

/// 파트너 브랜드 (§10) — 계정이 없는 브랜드도 소개에 노출할 수 있어 Brand 계정과 분리한다
model PartnerBrand {
  id           String    @id @default(uuid())
  slug         String    @unique
  /// 계정이 있는 브랜드면 연결한다
  brandId      String?   @map("brand_id")
  displayName  String    @map("display_name")
  legalName    String?   @map("legal_name")
  category     String
  description  String?
  website      String?
  instagram    String?
  storeUrl     String?   @map("store_url")
  contactEmail String?   @map("contact_email")
  /// 로고 변형 {light,dark,mono} + heroImageUrl
  logoLight    String?   @map("logo_light")
  logoDark     String?   @map("logo_dark")
  heroImageUrl String?   @map("hero_image_url")
  logoAlt      String?   @map("logo_alt")
  /// PROSPECT | ONBOARDING | ACTIVE_PARTNER | PAST_PARTNER | SUSPENDED | ARCHIVED (§10.3)
  status       String    @default("ONBOARDING")
  featured     Boolean   @default(false)
  sortOrder    Int       @default(0) @map("sort_order")
  seoTitle     String?   @map("seo_title")
  seoDesc      String?   @map("seo_desc")
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  cases  MatchingCase[]
  rights RightsGrant[]

  @@index([status, sortOrder])
  @@map("partner_brands")
}

/// 매칭사례 (§6.1) — 계약·성과·권리와 연결되어야 게시할 수 있다
model MatchingCase {
  id              String    @id @default(uuid())
  slug            String    @unique
  code            String    @unique
  title           String
  summary         String?
  /// 브랜드 목표와 당시 과제
  background      String?
  partnerBrandId  String?   @map("partner_brand_id")
  athleteId       String?   @map("athlete_id")
  contractId      String?   @map("contract_id")
  /// 화면에 그대로 쓰는 표시용 이름 (선수/브랜드 삭제 대비)
  athleteName     String?   @map("athlete_name")
  brandName       String?   @map("brand_name")
  sport           String?
  tour            String?
  /// 후원 유형 라벨 (모자 정면 · SNS 콘텐츠 등)
  sponsorTypes    String[]  @default([]) @map("sponsor_types")
  objectiveCodes  String[]  @default([]) @map("objective_codes")
  /// 슬롯·기간·활동·콘텐츠 구성 블록
  executionBlocks Json?     @map("execution_blocks")
  /// 계약-패치-대회-콘텐츠-검증 타임라인
  timeline        Json?
  heroImageUrl    String?   @map("hero_image_url")
  periodFrom      DateTime? @map("period_from")
  periodTo        DateTime? @map("period_to")
  /// DRAFT | IN_REVIEW | AWAITING_PARTY | APPROVED | SCHEDULED | PUBLISHED | ARCHIVED | ON_HOLD (§6.2)
  status          String    @default("DRAFT")
  /// 전체 공개등급 — 개별 지표는 CaseMetric.visibility 를 따른다
  visibility      String    @default("PUBLIC_EXACT")
  verified        Boolean   @default(false)
  featured        Boolean   @default(false)
  sortOrder       Int       @default(0) @map("sort_order")
  assigneeId      String?   @map("assignee_id")
  scheduledAt     DateTime? @map("scheduled_at")
  publishedAt     DateTime? @map("published_at")
  archivedAt      DateTime? @map("archived_at")
  holdReason      String?   @map("hold_reason")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  partnerBrand PartnerBrand?  @relation(fields: [partnerBrandId], references: [id], onDelete: SetNull)
  metrics      CaseMetric[]
  quotes       CaseQuote[]
  approvals    CaseApproval[]

  @@index([status, publishedAt])
  @@index([partnerBrandId])
  @@index([athleteId])
  @@map("matching_cases")
}

/// 사례 성과 지표 (§12.2) — 값 하나마다 출처·기간·공개등급·검증상태를 갖는다
model CaseMetric {
  id                 String    @id @default(uuid())
  caseId             String    @map("case_id")
  /// broadcast_seconds | sns_views | engagement_rate | store_visits ...
  metricCode         String    @map("metric_code")
  label              String
  definition         String?
  definitionVersion  String?   @map("definition_version")
  value              Float
  unit               String
  /// 화면 표기용 (예: +28.6%, 18,420회)
  displayValue       String?   @map("display_value")
  periodStart        DateTime? @map("period_start")
  periodEnd          DateTime? @map("period_end")
  /// API | FILE | MANUAL | PLATFORM
  sourceType         String    @map("source_type")
  sourceName         String?   @map("source_name")
  sourceId           String?   @map("source_id")
  evidenceUri        String?   @map("evidence_uri")
  /// 집계 기준 설명 (중복 제거 규칙 등)
  aggregationNote    String?   @map("aggregation_note")
  /// RAW | VERIFIED | FINAL | REJECTED (§12.2)
  verificationStatus String    @default("RAW") @map("verification_status")
  verifiedAt         DateTime? @map("verified_at")
  verifiedBy         String?   @map("verified_by")
  /// PUBLIC_EXACT | PUBLIC_RANGE | PUBLIC_LABEL | MEMBER_ONLY | PARTY_ONLY | PRIVATE (§5.3)
  visibility         String    @default("MEMBER_ONLY")
  isPrimary          Boolean   @default(false) @map("is_primary")
  sortOrder          Int       @default(0) @map("sort_order")
  observedAt         DateTime? @map("observed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  case MatchingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, sortOrder])
  @@map("case_metrics")
}

/// 사례 인용문 (§5.2) — 당사자 승인 없이는 게시할 수 없다
model CaseQuote {
  id         String    @id @default(uuid())
  caseId     String    @map("case_id")
  /// BRAND | ATHLETE
  speaker    String
  authorName String    @map("author_name")
  authorRole String?   @map("author_role")
  avatarUrl  String?   @map("avatar_url")
  content    String
  approved   Boolean   @default(false)
  approvedAt DateTime? @map("approved_at")
  approvedBy String?   @map("approved_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  case MatchingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_quotes")
}

/// 당사자 승인 (§6.2 AWAITING_PARTY) — 항목별로 브랜드·선수 승인을 받는다
model CaseApproval {
  id          String    @id @default(uuid())
  caseId      String    @map("case_id")
  /// BRAND | ATHLETE
  party       String
  partyId     String?   @map("party_id")
  partyName   String?   @map("party_name")
  /// PENDING | VIEWED | APPROVED | CHANGES_REQUESTED
  status      String    @default("PENDING")
  comment     String?
  /// 항목별 승인 상태 {profileImage,logo,quote,metrics}
  itemStatus  Json?     @map("item_status")
  requestedAt DateTime  @default(now()) @map("requested_at")
  viewedAt    DateTime? @map("viewed_at")
  respondedAt DateTime? @map("responded_at")
  expiresAt   DateTime? @map("expires_at")

  case MatchingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, party])
  @@index([status, expiresAt])
  @@map("case_approvals")
}

/// 초상·로고·인용 사용권 (§10.4 · §13) — 만료되면 게시가 자동 차단된다
model RightsGrant {
  id             String    @id @default(uuid())
  /// PORTRAIT | LOGO | QUOTE | PHOTO | VIDEO
  assetType      String    @map("asset_type")
  assetName      String    @map("asset_name")
  assetUrl       String?   @map("asset_url")
  thumbnailUrl   String?   @map("thumbnail_url")
  /// 권리 보유자
  holderType     String    @map("holder_type") // ATHLETE | BRAND | AGENCY | THIRD_PARTY
  holderName     String    @map("holder_name")
  athleteId      String?   @map("athlete_id")
  partnerBrandId String?   @map("partner_brand_id")
  /// website / social / press / store 등 허용 채널
  allowedScopes  String[]  @default([]) @map("allowed_scopes")
  allowedRegion  String?   @map("allowed_region")
  /// 동의서 등 증빙
  evidenceUrl    String?   @map("evidence_url")
  evidenceName   String?   @map("evidence_name")
  validFrom      DateTime? @map("valid_from")
  validTo        DateTime? @map("valid_to")
  /// VALID | EXPIRING | EXPIRED | MISSING_EVIDENCE | REVOKED | BLOCKED
  status         String    @default("VALID")
  ownerTeam      String?   @map("owner_team")
  managerName    String?   @map("manager_name")
  managerContact String?   @map("manager_contact")
  /// 이 권리에 걸린 게시물 [{type,title,url}]
  usedIn         Json?     @map("used_in")
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  partnerBrand PartnerBrand? @relation(fields: [partnerBrandId], references: [id], onDelete: SetNull)

  @@index([status, validTo])
  @@index([athleteId])
  @@map("rights_grants")
}

/// 성과보장 정책 버전 (§8.1) — ACTIVE 는 수정 불가, 새 버전으로만 바꾼다
model GuaranteePolicy {
  id                  String    @id @default(uuid())
  version             String    @unique
  summary             String?
  /// 적용 상품 유형 (RECOMMENDED_PICK | AVAILABLE_OFFER ...)
  eligibleProductTypes String[] @default([]) @map("eligible_product_types")
  /// 최소 기간·예산·활동·브랜드 의무 조건
  qualificationRules  Json      @map("qualification_rules")
  /// KPI 정의 [{code,label,operator,target,unit,weight,source,required}]
  metricRules         Json      @map("metric_rules")
  /// ALL | ANY | WEIGHTED
  judgeMode           String    @default("ALL") @map("judge_mode")
  /// 가중 판정 시 최소 달성률(%)
  minScore            Float?    @map("min_score")
  /// 보완지원 규칙 {ratio,cap,validMonths,cashRefund:false}
  remedyRules         Json      @map("remedy_rules")
  exclusions          Json?
  appealWindowDays    Int       @default(14) @map("appeal_window_days")
  /// DRAFT | ACTIVE | RETIRED
  status              String    @default("DRAFT")
  effectiveFrom       DateTime? @map("effective_from")
  effectiveTo         DateTime? @map("effective_to")
  legalApprovedBy     String?   @map("legal_approved_by")
  legalApprovedAt     DateTime? @map("legal_approved_at")
  createdBy           String?   @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  snapshots GuaranteeSnapshot[]

  @@index([status, effectiveFrom])
  @@map("guarantee_policies")
}

/// 계약 시점 정책 스냅샷 (§8.2) — 정책이 바뀌어도 기존 계약에는 소급하지 않는다
model GuaranteeSnapshot {
  id              String    @id @default(uuid())
  policyId        String    @map("policy_id")
  policyVersion   String    @map("policy_version")
  contractId      String?   @map("contract_id")
  applicationId   String?   @map("application_id")
  brandId         String?   @map("brand_id")
  athleteId       String?   @map("athlete_id")
  brandName       String?   @map("brand_name")
  athleteName     String?   @map("athlete_name")
  contractAmount  Int?      @map("contract_amount")
  /// 계약에 고정된 KPI 목표 [{code,label,target,unit,weight,source,required}]
  kpiTargets      Json      @map("kpi_targets")
  judgeMode       String    @default("ALL") @map("judge_mode")
  minScore        Float?    @map("min_score")
  remedyRules     Json      @map("remedy_rules")
  exclusions      Json?
  measureStart    DateTime? @map("measure_start")
  measureEnd      DateTime? @map("measure_end")
  appealWindowDays Int      @default(14) @map("appeal_window_days")
  /// NOT_APPLICABLE | ELIGIBLE | ACTIVE | MEASURING | DATA_PENDING | MET | NOT_MET
  /// | REMEDY_ELIGIBLE | REMEDY_ISSUED | APPEALED | FINAL (§8.3)
  status          String    @default("ELIGIBLE")
  judgedAt        DateTime? @map("judged_at")
  judgedBy        String?   @map("judged_by")
  finalizedAt     DateTime? @map("finalized_at")
  /// 최종 확정 결과 사본 (불변)
  finalSnapshot   Json?     @map("final_snapshot")
  lockedAt        DateTime? @map("locked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  policy       GuaranteePolicy      @relation(fields: [policyId], references: [id])
  observations GuaranteeObservation[]
  appeals      GuaranteeAppeal[]
  remedies     RemedyGrant[]

  @@index([status, measureEnd])
  @@index([brandId, status])
  @@map("guarantee_snapshots")
}

/// KPI 실적 관측치 (§7.4) — 미수집은 0이 아니라 DATA_PENDING 이다
model GuaranteeObservation {
  id           String    @id @default(uuid())
  snapshotId   String    @map("snapshot_id")
  metricCode   String    @map("metric_code")
  label        String
  target       Float
  actual       Float?
  unit         String
  weight       Float     @default(0)
  required     Boolean   @default(true)
  sourceName   String?   @map("source_name")
  evidenceUri  String?   @map("evidence_uri")
  /// PENDING | COLLECTED | VERIFIED | REJECTED
  collectStatus String   @default("PENDING") @map("collect_status")
  /// MET | NOT_MET | DATA_PENDING | EXCLUDED
  judgement    String    @default("DATA_PENDING")
  excludeReason String?  @map("exclude_reason")
  excludeApprovedBy String? @map("exclude_approved_by")
  provisional  Boolean   @default(true)
  nextCheckAt  DateTime? @map("next_check_at")
  observedAt   DateTime? @map("observed_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  snapshot GuaranteeSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, metricCode])
  @@map("guarantee_observations")
}

/// 이의제기 (§7.3 · §8.5)
model GuaranteeAppeal {
  id          String    @id @default(uuid())
  code        String    @unique
  snapshotId  String    @map("snapshot_id")
  brandUserId String?   @map("brand_user_id")
  reason      String
  /// 증빙 유형 체크 [CONTENT_LOG, AD_PROOF, EXTERNAL_CAUSE, ETC]
  evidenceTypes String[] @default([]) @map("evidence_types")
  attachments Json?
  attested    Boolean   @default(false)
  /// RECEIVED | UNDER_REVIEW | DECIDED | SUPPORT_ISSUED | REJECTED
  status      String    @default("RECEIVED")
  slaDueAt    DateTime? @map("sla_due_at")
  assigneeId  String?   @map("assignee_id")
  decisionType String?  @map("decision_type") // APPROVE | PARTIAL | REJECT
  decisionCode String?  @map("decision_code")
  decisionNote String?  @map("decision_note")
  decidedBy   String?   @map("decided_by")
  decidedAt   DateTime? @map("decided_at")
  approvedBy  String?   @map("approved_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  snapshot GuaranteeSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([status, slaDueAt])
  @@map("guarantee_appeals")
}

/// 보완지원 원장 (§8.4 · §16.4) — 현금 환급·양도 불가. 발급·사용·소멸을 기록한다
model RemedyGrant {
  id           String    @id @default(uuid())
  code         String    @unique
  snapshotId   String    @map("snapshot_id")
  brandId      String?   @map("brand_id")
  /// 지원 비율(%) 과 금액 상한
  ratio        Float
  capAmount    Int       @map("cap_amount")
  issuedAmount Int       @map("issued_amount")
  usedAmount   Int       @default(0) @map("used_amount")
  /// RESERVED | ISSUED | PARTIALLY_USED | USED | EXPIRED | CANCELLED
  status       String    @default("RESERVED")
  validFrom    DateTime? @map("valid_from")
  validTo      DateTime? @map("valid_to")
  /// 사용처 계약/주문 참조
  referenceIds String[]  @default([]) @map("reference_ids")
  issuedBy     String?   @map("issued_by")
  approvedBy   String?   @map("approved_by")
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  snapshot GuaranteeSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([status, validTo])
  @@index([brandId, status])
  @@map("remedy_grants")
}

/// 소개 영역 분석 이벤트 (§13.1) — 개인 식별자를 저장하지 않는다
model AboutAnalyticsEvent {
  id         String   @id @default(uuid())
  event      String
  pageSlug   String?  @map("page_slug")
  /// pseudonymous id (내부 user_id 아님)
  visitorKey String?  @map("visitor_key")
  role       String?
  params     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([event, createdAt])
  @@index([pageSlug, createdAt])
  @@map("about_analytics_events")
}

