// Screen Golf Sponsor Marketplace - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication
// ============================================

enum UserRole {
  BRAND
  ATHLETE
  ADMIN
  FAN
  FINANCE // 재무/출금 관리 권한
  SUPPORT // 고객지원 (읽기 전용)
  AUDITOR // 감사 (읽기 전용)
  AGENCY // 에이전시 (선수 대리 관리)
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  pointBalance Int      @default(0) @map("point_balance")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  brand                Brand?
  athlete              Athlete?
  admin                Admin?
  fan                  Fan?
  agency               Agency?
  auditLogs            AuditLog[]
  pointLedgers         PointLedger[]
  pointWallet          PointWallet?
  pointLedgerTxs       PointLedgerTx[]   @relation("PointLedgerTxs")
  redemptionOrders     RedemptionOrder[]
  pointTransfersFrom   PointTransfer[]   @relation("PointTransferFrom")
  pointTransfersTo     PointTransfer[]   @relation("PointTransferTo")
  pointTopups          PointTopup[]
  donationsSent        Donation[]        @relation("DonationFrom")
  pointWithdrawals     PointWithdrawal[] @relation("PointWithdrawals")
  processedWithdrawals PointWithdrawal[] @relation("ProcessedPointWithdrawals")

  // 본인인증 정보
  realName               String?   @map("real_name")
  phone                  String?   @unique
  birthDate              DateTime? @map("birth_date")
  certificationUniqueKey String?   @unique @map("cert_unique_key")
  certifiedAt            DateTime? @map("certified_at")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// ============================================
// Brand (Advertiser)
// ============================================

model Brand {
  id           String    @id @default(uuid())
  userId       String    @unique @map("user_id")
  name         String
  bizNo        String?   @map("biz_no")
  category     String
  contactEmail String    @map("contact_email")
  contactPhone String?   @map("contact_phone")
  contactName  String?   @map("contact_name")
  website      String?
  description  String?
  address      String?
  kycStatus    KycStatus @default(NOT_SUBMITTED) @map("kyc_status")
  kycDocuments Json?     @map("kyc_documents")
  penaltyScore Int       @default(0) @map("penalty_score")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user              User                         @relation(fields: [userId], references: [id])
  bids              Bid[]
  contracts         Contract[]
  campaigns         Campaign[]
  payments          Payment[]
  favoritedBy       FavoriteBrand[]
  billingProfile    BillingProfile?
  creativeApprovals BrandEventCreativeApproval[]

  // ROI Settings
  keywords          String[] @default([])
  competitors       String[] @default([])
  blockedCategories String[] @default([]) @map("blocked_categories")

  // ROI Report Dashboard relations
  logoTemplates  LogoTemplate[]
  logoDetections LogoDetection[]
  roiExposures   RoiExposure[]

  // Full Funnel relations
  promoCodes    PromoCode[]
  trackingLinks TrackingLink[]
  miniStores    MiniStore[]
  funnelEvents  FunnelEvent[]
  funnelOrders  FunnelOrder[]
  pixelInstall  PixelInstall?

  @@map("brands")
}

// ============================================
// Athlete (Player)
// ============================================

model Athlete {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  name              String
  realName          String?   @map("real_name")
  tour              String
  profileImageUrl   String?   @map("profile_image_url")
  bio               String?
  socialLinks       Json?     @map("social_links")
  primarySponsors   Json?     @map("primary_sponsors")
  blockedCategories String[]  @map("blocked_categories")
  kycStatus         KycStatus @default(NOT_SUBMITTED) @map("kyc_status")
  kycDocuments      Json?     @map("kyc_documents")
  bankAccount       Json?     @map("bank_account")
  taxInfo           Json?     @map("tax_info")
  agencyId          String?   @map("agency_id")
  agencyAssignedAt  DateTime? @map("agency_assigned_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user                User                   @relation(fields: [userId], references: [id])
  agency              Agency?                @relation(fields: [agencyId], references: [id])
  slotInstances       SlotInstance[]
  contracts           Contract[]
  eventParticipations EventParticipation[]
  payoutItems         PayoutItem[]
  favoritedBy         FavoriteAthlete[]
  withdrawalRequests  WithdrawalRequest[]
  donationsReceived   Donation[]
  agencyRequests      AgencyAthleteRequest[]

  // Full Funnel relations
  promoCodes    PromoCode[]
  trackingLinks TrackingLink[]
  funnelEvents  FunnelEvent[]
  funnelOrders  FunnelOrder[]

  @@map("athletes")
}

// ============================================
// Agency (에이전시 - 선수 대리 관리)
// ============================================

model Agency {
  id           String    @id @default(uuid())
  userId       String    @unique @map("user_id")
  name         String
  bizNo        String?   @map("biz_no")
  contactEmail String    @map("contact_email")
  contactPhone String?   @map("contact_phone")
  contactName  String?   @map("contact_name")
  website      String?
  description  String?
  kycStatus    KycStatus @default(NOT_SUBMITTED) @map("kyc_status")
  kycDocuments Json?     @map("kyc_documents")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user            User                   @relation(fields: [userId], references: [id])
  athletes        Athlete[]
  athleteRequests AgencyAthleteRequest[]

  @@map("agencies")
}

// ============================================
// Agency-Athlete Connection Request
// ============================================

enum AgencyAthleteRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AgencyAthleteRequest {
  id             String                     @id @default(uuid())
  agencyId       String                     @map("agency_id")
  athleteId      String                     @map("athlete_id")
  status         AgencyAthleteRequestStatus @default(PENDING)
  message        String?
  rejectedReason String?                    @map("rejected_reason")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  respondedAt    DateTime?                  @map("responded_at")

  agency  Agency  @relation(fields: [agencyId], references: [id])
  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@index([athleteId, status])
  @@index([agencyId, status])
  @@map("agency_athlete_requests")
}

// ============================================
// Admin
// ============================================

model Admin {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  name        String
  department  String?
  permissions Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("admins")
}

// ============================================
// Fan (General User)
// ============================================

model Fan {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  nickname  String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                      User                       @relation(fields: [userId], references: [id])
  favoriteAthletes          FavoriteAthlete[]
  favoriteBrands            FavoriteBrand[]
  brandRegistrationRequests BrandRegistrationRequest[]

  @@map("fans")
}

// ============================================
// Fan Favorites
// ============================================

model FavoriteAthlete {
  id        String   @id @default(uuid())
  fanId     String   @map("fan_id")
  athleteId String   @map("athlete_id")
  createdAt DateTime @default(now()) @map("created_at")

  fan     Fan     @relation(fields: [fanId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([fanId, athleteId])
  @@map("favorite_athletes")
}

model FavoriteBrand {
  id        String   @id @default(uuid())
  fanId     String   @map("fan_id")
  brandId   String   @map("brand_id")
  createdAt DateTime @default(now()) @map("created_at")

  fan   Fan   @relation(fields: [fanId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([fanId, brandId])
  @@map("favorite_brands")
}

// ============================================
// Brand Registration Request (Fan -> Brand)
// ============================================

enum BrandRegistrationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model BrandRegistrationRequest {
  id           String                  @id @default(uuid())
  fanId        String                  @map("fan_id")
  brandName    String                  @map("brand_name")
  contactEmail String                  @map("contact_email")
  contactPhone String?                 @map("contact_phone")
  website      String?
  note         String?
  status       BrandRegistrationStatus @default(SUBMITTED)
  adminNote    String?                 @map("admin_note")
  reviewedBy   String?                 @map("reviewed_by")
  reviewedAt   DateTime?               @map("reviewed_at")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  fan Fan @relation(fields: [fanId], references: [id])

  @@map("brand_registration_requests")
}

// ============================================
// Event (Tournament/Broadcast)
// ============================================

model Event {
  id               String      @id @default(uuid())
  tour             String
  name             String
  description      String?
  dateStart        DateTime    @map("date_start")
  dateEnd          DateTime    @map("date_end")
  broadcastEpisode String?     @map("broadcast_episode")
  multiplier       Float       @default(1.0)
  venue            String?
  status           EventStatus @default(UPCOMING)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  // v2 Tournament Rules (JSON)
  // {
  //   chestReservedSide: "LEFT"|"RIGHT"|"NONE",
  //   sleeveReservedSide: "LEFT"|"RIGHT"|"NONE",
  //   reservedSlotCodes: string[],
  //   disabledSlotCodes: string[],
  //   phase2UnlockPolicy: "ALL_PHASE1_EFFECTIVE_SLOTS_FILLED",
  //   phase2UnlockMode: "AUTO"|"ADMIN_APPROVE",
  //   phase2EligibleMinDaysBefore: number,
  //   creativeApprovalRequired: boolean,
  //   prohibitedCategories: string[],
  //   maxSlotsPerBrandPerPlayer: number
  // }
  tournamentRules Json? @map("tournament_rules")

  slotInstances     SlotInstance[]
  participations    EventParticipation[]
  creativeApprovals BrandEventCreativeApproval[]
  vodAssets         VodAsset[]

  @@map("events")
}

enum EventStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

model EventParticipation {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  athleteId String   @map("athlete_id")
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  event   Event   @relation(fields: [eventId], references: [id])
  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@unique([eventId, athleteId])
  @@map("event_participations")
}

// ============================================
// Slot Template & Instance
// ============================================

enum BodyPart {
  // CAP (모자)
  CAP_FRONT
  CAP_BRIM_TOP
  CAP_SIDE_L
  CAP_SIDE_R
  CAP_BACK
  // TOP (상의)
  CHEST_L
  CHEST_R
  COLLAR_L
  COLLAR_R
  SLEEVE_L
  SLEEVE_R
  BACK_SHOULDER_L
  BACK_SHOULDER_R
  // PANTS (하의) - Phase 2
  PANTS_HIP_SIDE_FACING
  PANTS_THIGH_SIDE_FACING
  // Legacy (backward compatibility)
  SHIRT_CHEST_LEFT
  SHIRT_CHEST_RIGHT
  SHIRT_SLEEVE_LEFT
  SHIRT_SLEEVE_RIGHT
  CAP_SIDE_LEFT
  PANTS_BELT
  SHIRT_BACK
}

enum SlotGrade {
  S
  A
  B
  C
}

enum SlotCategory {
  CAP
  TOP
  PANTS
}

enum MaterialRule {
  PRINTED_ONLY
  EMBROIDERY_OK
  ANY
}

model SlotTemplate {
  id                         String       @id @default(uuid())
  code                       String       @unique
  name                       String
  bodyPart                   BodyPart     @map("body_part")
  sizeMaxWMm                 Int          @map("size_max_w_mm")
  sizeMaxHMm                 Int          @map("size_max_h_mm")
  perimeterMaxMm             Int          @map("perimeter_max_mm")
  recommendedWMm             Int?         @map("recommended_w_mm")
  recommendedHMm             Int?         @map("recommended_h_mm")
  forbiddenNotes             String?      @map("forbidden_notes")
  materialRules              MaterialRule @default(PRINTED_ONLY) @map("material_rules")
  requiresVerificationPhotos Boolean      @default(true) @map("requires_verification_photos")
  requiredAngles             String[]     @default(["front"]) @map("required_angles")
  categoryExclusivityGroup   String?      @map("category_exclusivity_group")
  defaultReservePrice        Int          @default(100000) @map("default_reserve_price")
  eventOverrideAllowed       Boolean      @default(true) @map("event_override_allowed")
  duration                   Int?         @map("duration") // 노출 시간 (초)
  estimatedImpressions       Int?         @map("estimated_impressions") // 예상 노출 (회)
  isActive                   Boolean      @default(true) @map("is_active")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  // v2 Phase Policy Fields
  phase              Int           @default(1) // 1: 기본 오픈, 2: 조건부 확장
  category           SlotCategory? @map("slot_category") // CAP, TOP, PANTS
  grade              SlotGrade? // S, A, B, C
  nameKr             String?       @map("name_kr") // 한국어 이름
  nameEn             String?       @map("name_en") // 영어 이름
  uiHeadline         String?       @map("ui_headline") // UI 헤드라인 (10-14자)
  uiCopy             String?       @map("ui_copy") // UI 설명 (1문장)
  tags               String[]      @default([]) // 태그 배열
  openRule           String?       @map("open_rule") // 오픈 규칙 설명
  exclusivityGroup   String?       @map("exclusivity_group") // 배타적 그룹 (CHEST, SLEEVE, etc.)
  tournamentReserved Boolean       @default(false) @map("tournament_reserved") // 대회 설정으로 점유 가능 여부
  recSizeMm          String?       @map("rec_size_mm") // 권장 사이즈 (예: "60x30")
  material           String? // 재질 규격
  reserveMinKrw      Int?          @map("reserve_min_krw") // 최소 예약가 (원)
  reserveRecKrw      Int?          @map("reserve_rec_krw") // 권장 예약가 (원)
  reserveReason      String?       @map("reserve_reason") // 예약가 산정 사유

  slotInstances SlotInstance[]

  @@map("slot_templates")
}

enum SlotStatus {
  OPEN
  IN_AUCTION
  RESERVED // 즉시구매 진행 중 (선수 서명 대기)
  SOLD
  CLOSED
}

model SlotInstance {
  id              String     @id @default(uuid())
  eventId         String     @map("event_id")
  athleteId       String     @map("athlete_id")
  slotTemplateId  String     @map("slot_template_id")
  reservePrice    Int        @map("reserve_price")
  status          SlotStatus @default(OPEN)
  overrideSpecs   Json?      @map("override_specs")
  // Sale Mode Fields
  enableAuction   Boolean    @default(true) @map("enable_auction")
  enableDirectBuy Boolean    @default(false) @map("enable_direct_buy")
  directBuyPrice  Decimal?   @map("direct_buy_price") @db.Decimal(18, 0)
  auctionMinBid   Decimal?   @map("auction_min_bid") @db.Decimal(18, 0)
  auctionEndAt    DateTime?  @map("auction_end_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  event        Event        @relation(fields: [eventId], references: [id])
  athlete      Athlete      @relation(fields: [athleteId], references: [id])
  slotTemplate SlotTemplate @relation(fields: [slotTemplateId], references: [id])
  auction      Auction?

  @@unique([eventId, athleteId, slotTemplateId])
  @@map("slot_instances")
}

// ============================================
// Auction & Bidding
// ============================================

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  UNSOLD
}

model Auction {
  id              String        @id @default(uuid())
  slotInstanceId  String        @unique @map("slot_instance_id")
  startAt         DateTime      @map("start_at")
  endAt           DateTime      @map("end_at")
  originalEndAt   DateTime      @map("original_end_at")
  softCloseSec    Int           @default(120) @map("soft_close_sec")
  maxExtensionSec Int           @default(600) @map("max_extension_sec")
  totalExtended   Int           @default(0) @map("total_extended")
  minBidIncrement Int           @default(10000) @map("min_bid_increment")
  currentPrice    Int           @default(0) @map("current_price")
  status          AuctionStatus @default(SCHEDULED)
  winningBidId    String?       @map("winning_bid_id")
  isFeatured      Boolean       @default(false) @map("is_featured")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  slotInstance SlotInstance @relation(fields: [slotInstanceId], references: [id])
  bids         Bid[]
  contract     Contract?

  @@map("auctions")
}

model Bid {
  id           String   @id @default(uuid())
  auctionId    String   @map("auction_id")
  brandId      String   @map("brand_id")
  maxBid       Int      @map("max_bid")
  currentProxy Int      @map("current_proxy")
  autoBid      Boolean  @default(true) @map("auto_bid")
  isWinning    Boolean  @default(false) @map("is_winning")
  frozenAmount Decimal? @map("frozen_amount") @db.Decimal(18, 0) // 동결 금액 (최고 입찰자만)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  auction Auction @relation(fields: [auctionId], references: [id])
  brand   Brand   @relation(fields: [brandId], references: [id])

  @@unique([auctionId, brandId])
  @@map("bids")
}

// ============================================
// Contract & Creative Assets
// ============================================

enum ContractStatus {
  PENDING_SIGNATURE
  ACTIVE
  ASSET_PENDING
  ASSET_APPROVED
  VERIFICATION_PENDING
  VERIFIED
  COMPLETED
  CANCELLED
}

model Contract {
  id              String         @id @default(uuid())
  auctionId       String         @unique @map("auction_id")
  brandId         String         @map("brand_id")
  athleteId       String         @map("athlete_id")
  priceFinal      Int            @map("price_final")
  status          ContractStatus @default(PENDING_SIGNATURE)
  brandSignedAt   DateTime?      @map("brand_signed_at")
  athleteSignedAt DateTime?      @map("athlete_signed_at")
  signedAt        DateTime?      @map("signed_at")
  assetDeadline   DateTime?      @map("asset_deadline")
  reservedUntil   DateTime?      @map("reserved_until") // Direct Buy 예약 만료 시간
  terms           Json?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  auction           Auction              @relation(fields: [auctionId], references: [id])
  brand             Brand                @relation(fields: [brandId], references: [id])
  athlete           Athlete              @relation(fields: [athleteId], references: [id])
  assets            CreativeAsset[]
  verification      Verification?
  settlement        Settlement?
  payments          Payment[]
  escrow            Escrow?
  fulfillment       ContractFulfillment?
  campaignContracts CampaignContract[]
  exposureRecords   ExposureRecord[]

  @@map("contracts")
}

enum AssetStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model CreativeAsset {
  id            String      @id @default(uuid())
  contractId    String      @map("contract_id")
  fileUrl       String      @map("file_url")
  fileName      String?     @map("file_name")
  fileType      String?     @map("file_type")
  fileSizeBytes Int?        @map("file_size_bytes")
  status        AssetStatus @default(SUBMITTED)
  reviewNotes   String?     @map("review_notes")
  reviewedBy    String?     @map("reviewed_by")
  reviewedAt    DateTime?   @map("reviewed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  contract Contract @relation(fields: [contractId], references: [id])

  @@map("creative_assets")
}

// ============================================
// Pre-Bid Creative Approval (v2)
// 입찰 전 사전 크리에이티브 승인
// ============================================

enum PreApprovalStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model BrandEventCreativeApproval {
  id            String            @id @default(uuid())
  brandId       String            @map("brand_id")
  eventId       String            @map("event_id")
  fileUrl       String            @map("file_url")
  fileName      String?           @map("file_name")
  fileType      String?           @map("file_type")
  fileSizeBytes Int?              @map("file_size_bytes")
  status        PreApprovalStatus @default(SUBMITTED)
  reviewNotes   String?           @map("review_notes")
  reviewedBy    String?           @map("reviewed_by")
  reviewedAt    DateTime?         @map("reviewed_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@unique([brandId, eventId])
  @@map("brand_event_creative_approvals")
}

// ============================================
// Verification (Attachment Proof)
// ============================================

enum VerificationStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

model Verification {
  id              String             @id @default(uuid())
  contractId      String             @unique @map("contract_id")
  photoUrls       String[]           @map("photo_urls")
  angles          String[]
  status          VerificationStatus @default(SUBMITTED)
  verifiedBy      String?            @map("verified_by")
  verifiedAt      DateTime?          @map("verified_at")
  rejectionReason String?            @map("rejection_reason")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  contract Contract @relation(fields: [contractId], references: [id])

  @@map("verifications")
}

// ============================================
// Settlement (Payment)
// ============================================

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

model Settlement {
  id              String           @id @default(uuid())
  contractId      String           @unique @map("contract_id")
  grossAmount     Int              @map("gross_amount")
  platformFee     Int              @map("platform_fee")
  platformFeeRate Float            @map("platform_fee_rate")
  payoutAmount    Int              @map("payout_amount")
  status          SettlementStatus @default(PENDING)
  paidAt          DateTime?        @map("paid_at")
  paymentRef      String?          @map("payment_ref")
  invoiceUrl      String?          @map("invoice_url")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  contract Contract @relation(fields: [contractId], references: [id])

  @@map("settlements")
}

// ============================================
// Campaign (Brand Campaign Management)
// ============================================

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id                String         @id @default(uuid())
  brandId           String         @map("brand_id")
  name              String
  description       String?
  budget            Int
  spentAmount       Int            @default(0) @map("spent_amount")
  targetCategories  String[]       @map("target_categories")
  excludedAthletes  String[]       @map("excluded_athletes")
  preferredAthletes String[]       @map("preferred_athletes")
  dateStart         DateTime?      @map("date_start")
  dateEnd           DateTime?      @map("date_end")
  status            CampaignStatus @default(DRAFT)

  // KPI 목표
  goalImpressions Int? @map("goal_impressions")
  goalClicks      Int? @map("goal_clicks")
  goalConversions Int? @map("goal_conversions")

  // 예산 추적
  budgetAllocated  Int  @default(0) @map("budget_allocated")
  dailyBudgetLimit Int? @map("daily_budget_limit")

  // 실적 캐시
  actualImpressions Int @default(0) @map("actual_impressions")
  actualClicks      Int @default(0) @map("actual_clicks")

  // 선호 설정
  preferredTours   String[] @map("preferred_tours")
  minAthleteRating Float?   @map("min_athlete_rating")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand     Brand              @relation(fields: [brandId], references: [id])
  contracts CampaignContract[]

  // ROI Report Dashboard relations
  vodAssets     VodAsset[]
  roiExposures  RoiExposure[]
  mediaMentions MediaMention[]
  roiReports    RoiReport[]

  // Full Funnel relations
  promoCodes    PromoCode[]
  trackingLinks TrackingLink[]
  miniStore     MiniStore?
  funnelEvents  FunnelEvent[]
  funnelOrders  FunnelOrder[]

  // Phase 3: Performance-based pricing
  pricingModel CampaignPricingModel @default(FIXED) @map("pricing_model")
  cpaRate      Decimal?             @map("cpa_rate") @db.Decimal(18, 0)
  cpsRate      Decimal?             @map("cps_rate") @db.Decimal(5, 4)

  @@map("campaigns")
}

model CampaignContract {
  id              String   @id @default(uuid())
  campaignId      String   @map("campaign_id")
  contractId      String   @map("contract_id")
  allocatedBudget Int      @map("allocated_budget")
  createdAt       DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id])

  @@unique([campaignId, contractId])
  @@index([contractId])
  @@map("campaign_contracts")
}

// ============================================
// Exposure & Media Value (노출/미디어밸류)
// ============================================

enum ExposureType {
  BROADCAST // 방송 노출
  EVENT_LIVE // 현장 이벤트
  SOCIAL_MEDIA // 소셜 미디어
  PHOTO_PRESS // 사진/보도
  OTHER // 기타
}

model ExposureRecord {
  id                String       @id @default(uuid())
  contractId        String       @map("contract_id")
  exposureType      ExposureType @map("exposure_type")
  impressions       Int          @default(0)
  viewDurationSec   Int?         @map("view_duration_sec")
  reachCount        Int?         @map("reach_count")
  ratePerImpression Decimal?     @map("rate_per_impression") @db.Decimal(10, 4)
  mediaValue        Decimal?     @map("media_value") @db.Decimal(18, 0)
  sourceUrl         String?      @map("source_url")
  description       String?
  recordedAt        DateTime     @map("recorded_at")
  recordedBy        String?      @map("recorded_by")
  createdAt         DateTime     @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id])

  @@index([contractId, recordedAt])
  @@index([exposureType, recordedAt])
  @@map("exposure_records")
}

model MediaValueRate {
  id                String       @id @default(uuid())
  exposureType      ExposureType @map("exposure_type")
  bodyPart          BodyPart?    @map("body_part")
  ratePerImpression Decimal      @map("rate_per_impression") @db.Decimal(10, 4)
  effectiveFrom     DateTime     @map("effective_from")
  effectiveTo       DateTime?    @map("effective_to")
  description       String?
  createdAt         DateTime     @default(now()) @map("created_at")

  @@unique([exposureType, bodyPart, effectiveFrom])
  @@index([effectiveFrom])
  @@map("media_value_rates")
}

// ============================================
