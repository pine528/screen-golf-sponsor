// Screen Golf Sponsor Marketplace - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication
// ============================================

enum UserRole {
  BRAND
  ATHLETE
  ADMIN
  FAN
  FINANCE   // 재무/출금 관리 권한
  SUPPORT   // 고객지원 (읽기 전용)
  AUDITOR   // 감사 (읽기 전용)
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole
  isActive      Boolean   @default(true) @map("is_active")
  pointBalance  Int       @default(0) @map("point_balance")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  brand         Brand?
  athlete       Athlete?
  admin         Admin?
  fan           Fan?
  auditLogs     AuditLog[]
  votes         Vote[]
  pointLedgers  PointLedger[]
  pointWallet   PointWallet?
  pointLedgerTxs PointLedgerTx[] @relation("PointLedgerTxs")
  fanVoteWins    FanVoteWinner[]
  redemptionOrders RedemptionOrder[]

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String   @map("user_id")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// ============================================
// Brand (Advertiser)
// ============================================

model Brand {
  id              String      @id @default(uuid())
  userId          String      @unique @map("user_id")
  name            String
  bizNo           String?     @map("biz_no")
  category        String
  contactEmail    String      @map("contact_email")
  contactPhone    String?     @map("contact_phone")
  contactName     String?     @map("contact_name")
  website         String?
  description     String?
  address         String?
  kycStatus       KycStatus   @default(NOT_SUBMITTED) @map("kyc_status")
  kycDocuments    Json?       @map("kyc_documents")
  penaltyScore    Int         @default(0) @map("penalty_score")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id])
  bids            Bid[]
  contracts       Contract[]
  campaigns       Campaign[]
  sponsoredVoteEvents VoteEvent[]
  sponsoredFanVotes FanVoteEvent[] @relation("SponsoredVotes")
  payments        Payment[]
  favoritedBy     FavoriteBrand[]
  billingProfile  BillingProfile?

  @@map("brands")
}

// ============================================
// Athlete (Player)
// ============================================

model Athlete {
  id                  String        @id @default(uuid())
  userId              String        @unique @map("user_id")
  name                String
  realName            String?       @map("real_name")
  tour                String
  profileImageUrl     String?       @map("profile_image_url")
  bio                 String?
  socialLinks         Json?         @map("social_links")
  primarySponsors     Json?         @map("primary_sponsors")
  blockedCategories   String[]      @map("blocked_categories")
  kycStatus           KycStatus     @default(NOT_SUBMITTED) @map("kyc_status")
  kycDocuments        Json?         @map("kyc_documents")
  bankAccount         Json?         @map("bank_account")
  taxInfo             Json?         @map("tax_info")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  user                 User          @relation(fields: [userId], references: [id])
  slotInstances        SlotInstance[]
  contracts            Contract[]
  eventParticipations  EventParticipation[]
  votePoints           AthleteVotePoint[]
  payoutItems          PayoutItem[]
  favoritedBy          FavoriteAthlete[]
  withdrawalRequests   WithdrawalRequest[]

  @@map("athletes")
}

// ============================================
// Admin
// ============================================

model Admin {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  name        String
  department  String?
  permissions Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id])

  @@map("admins")
}

// ============================================
// Fan (General User)
// ============================================

model Fan {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  nickname    String?
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user                    User                      @relation(fields: [userId], references: [id])
  favoriteAthletes        FavoriteAthlete[]
  favoriteBrands          FavoriteBrand[]
  brandRegistrationRequests BrandRegistrationRequest[]

  @@map("fans")
}

// ============================================
// Fan Favorites
// ============================================

model FavoriteAthlete {
  id          String   @id @default(uuid())
  fanId       String   @map("fan_id")
  athleteId   String   @map("athlete_id")
  createdAt   DateTime @default(now()) @map("created_at")

  fan         Fan      @relation(fields: [fanId], references: [id], onDelete: Cascade)
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([fanId, athleteId])
  @@map("favorite_athletes")
}

model FavoriteBrand {
  id          String   @id @default(uuid())
  fanId       String   @map("fan_id")
  brandId     String   @map("brand_id")
  createdAt   DateTime @default(now()) @map("created_at")

  fan         Fan      @relation(fields: [fanId], references: [id], onDelete: Cascade)
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([fanId, brandId])
  @@map("favorite_brands")
}

// ============================================
// Brand Registration Request (Fan -> Brand)
// ============================================

enum BrandRegistrationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model BrandRegistrationRequest {
  id              String                    @id @default(uuid())
  fanId           String                    @map("fan_id")
  brandName       String                    @map("brand_name")
  contactEmail    String                    @map("contact_email")
  contactPhone    String?                   @map("contact_phone")
  website         String?
  note            String?
  status          BrandRegistrationStatus   @default(SUBMITTED)
  adminNote       String?                   @map("admin_note")
  reviewedBy      String?                   @map("reviewed_by")
  reviewedAt      DateTime?                 @map("reviewed_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  fan             Fan                       @relation(fields: [fanId], references: [id])

  @@map("brand_registration_requests")
}

// ============================================
// Event (Tournament/Broadcast)
// ============================================

model Event {
  id                String    @id @default(uuid())
  tour              String
  name              String
  description       String?
  dateStart         DateTime  @map("date_start")
  dateEnd           DateTime  @map("date_end")
  broadcastEpisode  String?   @map("broadcast_episode")
  multiplier        Float     @default(1.0)
  venue             String?
  status            EventStatus @default(UPCOMING)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  slotInstances     SlotInstance[]
  participations    EventParticipation[]
  voteEvents        VoteEvent[]

  @@map("events")
}

enum EventStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

model EventParticipation {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  athleteId   String   @map("athlete_id")
  confirmed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  event       Event    @relation(fields: [eventId], references: [id])
  athlete     Athlete  @relation(fields: [athleteId], references: [id])

  @@unique([eventId, athleteId])
  @@map("event_participations")
}

// ============================================
// Slot Template & Instance
// ============================================

enum BodyPart {
  SHIRT_CHEST_LEFT
  SHIRT_CHEST_RIGHT
  SHIRT_SLEEVE_LEFT
  SHIRT_SLEEVE_RIGHT
  CAP_SIDE_LEFT
  CAP_BACK
  PANTS_BELT
  SHIRT_BACK
}

enum MaterialRule {
  PRINTED_ONLY
  EMBROIDERY_OK
  ANY
}

model SlotTemplate {
  id                      String        @id @default(uuid())
  code                    String        @unique
  name                    String
  bodyPart                BodyPart      @map("body_part")
  sizeMaxWMm              Int           @map("size_max_w_mm")
  sizeMaxHMm              Int           @map("size_max_h_mm")
  perimeterMaxMm          Int           @map("perimeter_max_mm")
  recommendedWMm          Int?          @map("recommended_w_mm")
  recommendedHMm          Int?          @map("recommended_h_mm")
  forbiddenNotes          String?       @map("forbidden_notes")
  materialRules           MaterialRule  @default(PRINTED_ONLY) @map("material_rules")
  requiresVerificationPhotos Boolean    @default(true) @map("requires_verification_photos")
  requiredAngles          String[]      @default(["front"]) @map("required_angles")
  categoryExclusivityGroup String?      @map("category_exclusivity_group")
  defaultReservePrice     Int           @default(100000) @map("default_reserve_price")
  eventOverrideAllowed    Boolean       @default(true) @map("event_override_allowed")
  isActive                Boolean       @default(true) @map("is_active")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  slotInstances           SlotInstance[]

  @@map("slot_templates")
}

enum SlotStatus {
  OPEN
  IN_AUCTION
  RESERVED      // 즉시구매 진행 중 (선수 서명 대기)
  SOLD
  CLOSED
}

model SlotInstance {
  id              String        @id @default(uuid())
  eventId         String        @map("event_id")
  athleteId       String        @map("athlete_id")
  slotTemplateId  String        @map("slot_template_id")
  reservePrice    Int           @map("reserve_price")
  status          SlotStatus    @default(OPEN)
  overrideSpecs   Json?         @map("override_specs")
  // Sale Mode Fields
  enableAuction     Boolean       @default(true) @map("enable_auction")
  enableDirectBuy   Boolean       @default(false) @map("enable_direct_buy")
  directBuyPrice    Decimal?      @map("direct_buy_price") @db.Decimal(18, 0)
  auctionMinBid     Decimal?      @map("auction_min_bid") @db.Decimal(18, 0)
  auctionEndAt      DateTime?     @map("auction_end_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  event           Event         @relation(fields: [eventId], references: [id])
  athlete         Athlete       @relation(fields: [athleteId], references: [id])
  slotTemplate    SlotTemplate  @relation(fields: [slotTemplateId], references: [id])
  auction         Auction?

  @@unique([eventId, athleteId, slotTemplateId])
  @@map("slot_instances")
}

// ============================================
// Auction & Bidding
// ============================================

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  UNSOLD
}

model Auction {
  id              String        @id @default(uuid())
  slotInstanceId  String        @unique @map("slot_instance_id")
  startAt         DateTime      @map("start_at")
  endAt           DateTime      @map("end_at")
  originalEndAt   DateTime      @map("original_end_at")
  softCloseSec    Int           @default(120) @map("soft_close_sec")
  maxExtensionSec Int           @default(600) @map("max_extension_sec")
  totalExtended   Int           @default(0) @map("total_extended")
  minBidIncrement Int           @default(10000) @map("min_bid_increment")
  currentPrice    Int           @default(0) @map("current_price")
  status          AuctionStatus @default(SCHEDULED)
  winningBidId    String?       @map("winning_bid_id")
  isFeatured      Boolean       @default(false) @map("is_featured")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  slotInstance    SlotInstance  @relation(fields: [slotInstanceId], references: [id])
  bids            Bid[]
  contract        Contract?

  @@map("auctions")
}

model Bid {
  id              String    @id @default(uuid())
  auctionId       String    @map("auction_id")
  brandId         String    @map("brand_id")
  maxBid          Int       @map("max_bid")
  currentProxy    Int       @map("current_proxy")
  autoBid         Boolean   @default(true) @map("auto_bid")
  isWinning       Boolean   @default(false) @map("is_winning")
  frozenAmount    Decimal?  @map("frozen_amount") @db.Decimal(18, 0)  // 동결 금액 (최고 입찰자만)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  auction         Auction   @relation(fields: [auctionId], references: [id])
  brand           Brand     @relation(fields: [brandId], references: [id])

  @@unique([auctionId, brandId])
  @@map("bids")
}

// ============================================
// Contract & Creative Assets
// ============================================

enum ContractStatus {
  PENDING_SIGNATURE
  ACTIVE
  ASSET_PENDING
  ASSET_APPROVED
  VERIFICATION_PENDING
  VERIFIED
  COMPLETED
  CANCELLED
}

model Contract {
  id              String          @id @default(uuid())
  auctionId       String          @unique @map("auction_id")
  brandId         String          @map("brand_id")
  athleteId       String          @map("athlete_id")
  priceFinal      Int             @map("price_final")
  status          ContractStatus  @default(PENDING_SIGNATURE)
  brandSignedAt   DateTime?       @map("brand_signed_at")
  athleteSignedAt DateTime?       @map("athlete_signed_at")
  signedAt        DateTime?       @map("signed_at")
  assetDeadline   DateTime?       @map("asset_deadline")
  reservedUntil   DateTime?       @map("reserved_until")  // Direct Buy 예약 만료 시간
  terms           Json?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  auction           Auction           @relation(fields: [auctionId], references: [id])
  brand             Brand             @relation(fields: [brandId], references: [id])
  athlete           Athlete           @relation(fields: [athleteId], references: [id])
  assets            CreativeAsset[]
  verification      Verification?
  settlement        Settlement?
  payments          Payment[]
  escrow            Escrow?
  fulfillment       ContractFulfillment?
  campaignContracts CampaignContract[]
  exposureRecords   ExposureRecord[]

  @@map("contracts")
}

enum AssetStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model CreativeAsset {
  id              String      @id @default(uuid())
  contractId      String      @map("contract_id")
  fileUrl         String      @map("file_url")
  fileName        String?     @map("file_name")
  fileType        String?     @map("file_type")
  fileSizeBytes   Int?        @map("file_size_bytes")
  status          AssetStatus @default(SUBMITTED)
  reviewNotes     String?     @map("review_notes")
  reviewedBy      String?     @map("reviewed_by")
  reviewedAt      DateTime?   @map("reviewed_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  contract        Contract    @relation(fields: [contractId], references: [id])

  @@map("creative_assets")
}

// ============================================
// Verification (Attachment Proof)
// ============================================

enum VerificationStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

model Verification {
  id              String              @id @default(uuid())
  contractId      String              @unique @map("contract_id")
  photoUrls       String[]            @map("photo_urls")
  angles          String[]
  status          VerificationStatus  @default(SUBMITTED)
  verifiedBy      String?             @map("verified_by")
  verifiedAt      DateTime?           @map("verified_at")
  rejectionReason String?             @map("rejection_reason")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  contract        Contract            @relation(fields: [contractId], references: [id])

  @@map("verifications")
}

// ============================================
// Settlement (Payment)
// ============================================

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

model Settlement {
  id              String            @id @default(uuid())
  contractId      String            @unique @map("contract_id")
  grossAmount     Int               @map("gross_amount")
  platformFee     Int               @map("platform_fee")
  platformFeeRate Float             @map("platform_fee_rate")
  payoutAmount    Int               @map("payout_amount")
  status          SettlementStatus  @default(PENDING)
  paidAt          DateTime?         @map("paid_at")
  paymentRef      String?           @map("payment_ref")
  invoiceUrl      String?           @map("invoice_url")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  contract        Contract          @relation(fields: [contractId], references: [id])

  @@map("settlements")
}

// ============================================
// Campaign (Brand Campaign Management)
// ============================================

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id                String          @id @default(uuid())
  brandId           String          @map("brand_id")
  name              String
  description       String?
  budget            Int
  spentAmount       Int             @default(0) @map("spent_amount")
  targetCategories  String[]        @map("target_categories")
  excludedAthletes  String[]        @map("excluded_athletes")
  preferredAthletes String[]        @map("preferred_athletes")
  dateStart         DateTime?       @map("date_start")
  dateEnd           DateTime?       @map("date_end")
  status            CampaignStatus  @default(DRAFT)

  // KPI 목표
  goalImpressions   Int?            @map("goal_impressions")
  goalClicks        Int?            @map("goal_clicks")
  goalConversions   Int?            @map("goal_conversions")

  // 예산 추적
  budgetAllocated   Int             @default(0) @map("budget_allocated")
  dailyBudgetLimit  Int?            @map("daily_budget_limit")

  // 실적 캐시
  actualImpressions Int             @default(0) @map("actual_impressions")
  actualClicks      Int             @default(0) @map("actual_clicks")

  // 선호 설정
  preferredTours    String[]        @map("preferred_tours")
  minAthleteRating  Float?          @map("min_athlete_rating")

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  brand             Brand           @relation(fields: [brandId], references: [id])
  contracts         CampaignContract[]

  @@map("campaigns")
}

model CampaignContract {
  id              String    @id @default(uuid())
  campaignId      String    @map("campaign_id")
  contractId      String    @map("contract_id")
  allocatedBudget Int       @map("allocated_budget")
  createdAt       DateTime  @default(now()) @map("created_at")

  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contract        Contract  @relation(fields: [contractId], references: [id])

  @@unique([campaignId, contractId])
  @@index([contractId])
  @@map("campaign_contracts")
}

// ============================================
// Exposure & Media Value (노출/미디어밸류)
// ============================================

enum ExposureType {
  BROADCAST         // 방송 노출
  EVENT_LIVE        // 현장 이벤트
  SOCIAL_MEDIA      // 소셜 미디어
  PHOTO_PRESS       // 사진/보도
  OTHER             // 기타
}

model ExposureRecord {
  id                String       @id @default(uuid())
  contractId        String       @map("contract_id")
  exposureType      ExposureType @map("exposure_type")
  impressions       Int          @default(0)
  viewDurationSec   Int?         @map("view_duration_sec")
  reachCount        Int?         @map("reach_count")
  ratePerImpression Decimal?     @map("rate_per_impression") @db.Decimal(10, 4)
  mediaValue        Decimal?     @map("media_value") @db.Decimal(18, 0)
  sourceUrl         String?      @map("source_url")
  description       String?
  recordedAt        DateTime     @map("recorded_at")
  recordedBy        String?      @map("recorded_by")
  createdAt         DateTime     @default(now()) @map("created_at")

  contract          Contract     @relation(fields: [contractId], references: [id])

  @@index([contractId, recordedAt])
  @@index([exposureType, recordedAt])
  @@map("exposure_records")
}

model MediaValueRate {
  id                String       @id @default(uuid())
  exposureType      ExposureType @map("exposure_type")
  bodyPart          BodyPart?    @map("body_part")
  ratePerImpression Decimal      @map("rate_per_impression") @db.Decimal(10, 4)
  effectiveFrom     DateTime     @map("effective_from")
  effectiveTo       DateTime?    @map("effective_to")
  description       String?
  createdAt         DateTime     @default(now()) @map("created_at")

  @@unique([exposureType, bodyPart, effectiveFrom])
  @@index([effectiveFrom])
  @@map("media_value_rates")
}

// ============================================
// Forbidden Categories
// ============================================

model ForbiddenCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("forbidden_categories")
}

// ============================================
// Category Mapping
// ============================================

model CategoryMapping {
  id              String   @id @default(uuid())
  categoryCode    String   @map("category_code")
  exclusivityGroup String  @map("exclusivity_group")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([categoryCode, exclusivityGroup])
  @@map("category_mappings")
}

// ============================================
// Audit Log
// ============================================

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  metadata    Json?    // 추가 메타데이터 (요청 정보, 변경 사유 등)
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ============================================
// Admin Action Log (운영자 액션 멱등성/감사)
// ============================================

model AdminActionLog {
  id              String   @id @default(uuid())
  actorId         String   @map("actor_id")  // admin user id
  action          String   // ESCROW_RELEASE_MANUAL, ESCROW_REFUND_MANUAL, CONTRACT_CANCEL_MANUAL
  targetType      String   @map("target_type")  // ESCROW, CONTRACT
  targetId        String   @map("target_id")
  idempotencyKey  String?  @unique @map("idempotency_key")
  requestBody     Json?    @map("request_body")
  result          Json?
  reason          String?  // 사유
  ipAddress       String?  @map("ip_address")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_action_logs")
}

// ============================================
// System Settings
// ============================================

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================================
// Notification
// ============================================

enum NotificationType {
  BID_PLACED
  BID_OUTBID
  AUCTION_WON
  AUCTION_LOST
  AUCTION_ENDING_SOON
  CONTRACT_CREATED
  ASSET_SUBMITTED
  ASSET_APPROVED
  ASSET_REJECTED
  VERIFICATION_SUBMITTED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  SETTLEMENT_COMPLETED
  KYC_APPROVED
  KYC_REJECTED
  ADMIN_ALERT
  BRAND_REGISTRATION_SUBMITTED
  BRAND_REGISTRATION_APPROVED
  BRAND_REGISTRATION_REJECTED
  FAN_VOTE_SUBMITTED
  FAN_VOTE_APPROVED
  FAN_VOTE_SETTLED
  FAN_VOTE_WIN
  REDEMPTION_FULFILLED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_PAID
}

model Notification {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  type        NotificationType
  title       String
  message     String
  data        Json?
  payload     Json?             // 추가 페이로드 (링크, 액션 버튼 등)
  isRead      Boolean           @default(false) @map("is_read")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ============================================
// Vote/Point System (팬 참여 시스템)
// ============================================

enum VoteEventStatus {
  DRAFT
  ACTIVE
  CLOSED
  SETTLED
}

enum VoteQuestionType {
  PREDICTION     // 경기 결과 예측
  QUIZ           // 퀴즈
  POLL           // 여론조사
}

model VoteEvent {
  id              String           @id @default(uuid())
  eventId         String?          @map("event_id")
  title           String
  description     String?
  questionType    VoteQuestionType @map("question_type")
  question        String
  options         Json             // [{id: string, label: string, athleteId?: string}]
  correctOptionId String?          @map("correct_option_id")
  pointsPerCorrect Int             @default(100) @map("points_per_correct")
  sponsorBrandId  String?          @map("sponsor_brand_id")
  startAt         DateTime         @map("start_at")
  endAt           DateTime         @map("end_at")
  status          VoteEventStatus  @default(DRAFT)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  event           Event?           @relation(fields: [eventId], references: [id])
  sponsorBrand    Brand?           @relation(fields: [sponsorBrandId], references: [id])
  votes           Vote[]
  athletePoints   AthleteVotePoint[]

  @@map("vote_events")
}

model Vote {
  id              String      @id @default(uuid())
  voteEventId     String      @map("vote_event_id")
  userId          String      @map("user_id")
  selectedOptionId String     @map("selected_option_id")
  isCorrect       Boolean?    @map("is_correct")
  pointsEarned    Int         @default(0) @map("points_earned")
  createdAt       DateTime    @default(now()) @map("created_at")

  voteEvent       VoteEvent   @relation(fields: [voteEventId], references: [id])
  user            User        @relation(fields: [userId], references: [id])

  @@unique([voteEventId, userId])
  @@map("votes")
}

model AthleteVotePoint {
  id              String      @id @default(uuid())
  voteEventId     String      @map("vote_event_id")
  athleteId       String      @map("athlete_id")
  points          Int         @default(0)
  createdAt       DateTime    @default(now()) @map("created_at")

  voteEvent       VoteEvent   @relation(fields: [voteEventId], references: [id])
  athlete         Athlete     @relation(fields: [athleteId], references: [id])

  @@unique([voteEventId, athleteId])
  @@map("athlete_vote_points")
}

// ============================================
// Point System (원장 기반 포인트 시스템)
// ============================================

enum PointTxReason {
  ADMIN_GRANT
  VOTE_ENTRY_FEE
  VOTE_WIN_PAYOUT
  VOTE_CREATE_FEE
  VOTE_POT_REMAINDER
  REDEEM_GOODS
  REDEEM_CANCEL_REFUND
}

model PointWallet {
  id          String      @id @default(uuid())
  userId      String      @unique @map("user_id")
  balance     Decimal     @default(0) @db.Decimal(18, 0)
  version     Int         @default(0)  // 낙관적 락
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_wallets")
}

model PointLedgerTx {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  delta           Decimal         @db.Decimal(18, 0)  // +: 적립, -: 차감
  balanceAfter    Decimal         @db.Decimal(18, 0)
  reason          PointTxReason
  refType         String          @map("ref_type")
  refId           String          @map("ref_id")
  description     String?
  createdAt       DateTime        @default(now()) @map("created_at")

  user            User            @relation(name: "PointLedgerTxs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, refType, refId], name: "unique_point_tx")
  @@index([userId, createdAt])
  @@map("point_ledger_txs")
}

// Legacy model - to be migrated
model PointLedger {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  amount          Int
  balance         Int
  type            String      // VOTE_REWARD, REFERRAL, REDEMPTION, EXPIRED 등
  description     String?
  referenceId     String?     @map("reference_id")
  referenceType   String?     @map("reference_type")
  createdAt       DateTime    @default(now()) @map("created_at")

  user            User        @relation(fields: [userId], references: [id])

  @@map("point_ledgers")
}

// ============================================
// Fan Vote System (팬 투표 시스템)
// ============================================

enum FanVoteStatus {
  DRAFT
  SUBMITTED
  ACTIVE
  CLOSED
  SETTLED
}

model FanVoteEvent {
  id                  String          @id @default(uuid())
  creatorUserId       String          @map("creator_user_id")
  title               String
  question            String
  options             Json            // string[]
  entryFeePoints      Decimal         @default(0) @map("entry_fee_points") @db.Decimal(18, 0)
  createFeePoints     Decimal         @default(0) @map("create_fee_points") @db.Decimal(18, 0)
  winnersCount        Int             @default(1) @map("winners_count")
  status              FanVoteStatus   @default(DRAFT)
  startsAt            DateTime        @map("starts_at")
  endsAt              DateTime        @map("ends_at")
  resultOptionIndex   Int?            @map("result_option_index")
  submittedAt         DateTime?       @map("submitted_at")
  approvedAt          DateTime?       @map("approved_at")
  settledAt           DateTime?       @map("settled_at")

  // Phase G: Sponsor fields
  sponsorBrandId      String?         @map("sponsor_brand_id")
  sponsorContribution Decimal?        @map("sponsor_contribution") @db.Decimal(18, 0)
  sponsorBannerUrl    String?         @map("sponsor_banner_url")
  sponsorLogoUrl      String?         @map("sponsor_logo_url")
  sponsorMessage      String?         @map("sponsor_message")
  sponsorLinkUrl      String?         @map("sponsor_link_url")

  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  entries             FanVoteEntry[]
  settlement          FanVoteSettlement?
  winners             FanVoteWinner[]
  sponsorBrand        Brand?          @relation("SponsoredVotes", fields: [sponsorBrandId], references: [id])
  sponsorEngagement   SponsorEngagement?

  @@index([status, startsAt, endsAt])
  @@index([creatorUserId])
  @@index([sponsorBrandId])
  @@map("fan_vote_events")
}

model SponsorEngagement {
  id                String       @id @default(uuid())
  eventId           String       @unique @map("event_id")
  bannerImpressions Int          @default(0) @map("banner_impressions")
  bannerClicks      Int          @default(0) @map("banner_clicks")
  linkClicks        Int          @default(0) @map("link_clicks")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  event             FanVoteEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("sponsor_engagements")
}

model FanVoteEntry {
  id              String          @id @default(uuid())
  eventId         String          @map("event_id")
  userId          String          @map("user_id")
  optionIndex     Int             @map("option_index")
  paidPoints      Decimal         @map("paid_points") @db.Decimal(18, 0)
  createdAt       DateTime        @default(now()) @map("created_at")

  event           FanVoteEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], name: "unique_fan_vote_entry")
  @@index([userId, createdAt])
  @@map("fan_vote_entries")
}

// ============================================
// Fan Vote Settlement (정산)
// ============================================

model FanVoteSettlement {
  id              String          @id @default(uuid())
  eventId         String          @unique @map("event_id")
  potTotal        Decimal         @map("pot_total") @db.Decimal(18, 0)
  winnersCount    Int             @map("winners_count")
  payoutEach      Decimal         @map("payout_each") @db.Decimal(18, 0)
  remainder       Decimal         @db.Decimal(18, 0)
  decidedByAdminId String         @map("decided_by_admin_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  event           FanVoteEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("fan_vote_settlements")
}

model FanVoteWinner {
  id              String          @id @default(uuid())
  eventId         String          @map("event_id")
  userId          String          @map("user_id")
  payoutPoints    Decimal         @map("payout_points") @db.Decimal(18, 0)
  createdAt       DateTime        @default(now()) @map("created_at")

  event           FanVoteEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])

  @@unique([eventId, userId], name: "unique_fan_vote_winner")
  @@map("fan_vote_winners")
}

// ============================================
// Payment System (결제 시스템)
// ============================================

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  VIRTUAL_ACCOUNT
}

model Payment {
  id              String         @id @default(uuid())
  brandId         String         @map("brand_id")
  contractId      String?        @map("contract_id")
  amount          Int
  method          PaymentMethod
  status          PaymentStatus  @default(PENDING)
  pgProvider      String?        @map("pg_provider")
  pgTransactionId String?        @map("pg_transaction_id")
  pgResponse      Json?          @map("pg_response")
  paidAt          DateTime?      @map("paid_at")
  failedAt        DateTime?      @map("failed_at")
  failReason      String?        @map("fail_reason")
  refundedAt      DateTime?      @map("refunded_at")
  refundAmount    Int?           @map("refund_amount")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  brand           Brand          @relation(fields: [brandId], references: [id])
  contract        Contract?      @relation(fields: [contractId], references: [id])

  @@map("payments")
}

// ============================================
// Wallet & Escrow System (내부 원장/에스크로)
// ============================================

enum WalletOwnerType {
  BRAND
  ATHLETE
  PLATFORM
}

enum PaymentProvider {
  TOSS
  STRIPE
}

enum TopupPaymentStatus {
  CREATED      // Checkout 세션 생성됨
  PENDING      // PG로 리다이렉트됨
  PAID         // 결제 확인 완료
  FAILED       // 결제 실패
  CANCELED     // 사용자 취소
  REFUNDED     // 환불 완료
  CHARGEBACK   // 차지백 발생
}

// Phase 10-2: Refund enums
enum RefundStatus {
  NONE      // 환불 없음
  PARTIAL   // 부분 환불
  FULL      // 전액 환불
}

enum RefundRequestStatus {
  REQUESTED   // 관리자가 환불 요청 생성
  APPROVED    // 승인됨 (PG 호출 대기)
  REJECTED    // 거절됨
  PROCESSING  // PG API 호출 중
  REFUNDED    // 환불 완료
  FAILED      // PG 환불 실패
}

model Wallet {
  id          String          @id @default(uuid())
  ownerType   WalletOwnerType @map("owner_type")
  ownerId     String          @map("owner_id")
  balance     Decimal         @default(0) @db.Decimal(18, 0)  // 원 단위 정수, 최대 10^18
  frozenAmount Decimal        @default(0) @map("frozen_amount") @db.Decimal(18, 0)
  version     Int             @default(0)  // 낙관적 락용 버전
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  ledgerTxs            LedgerTx[]
  withdrawalRequests   WithdrawalRequest[]
  topupPayments        TopupPayment[]
  refundRequests       RefundRequest[]
  // Note: ownerId references Brand or Athlete depending on ownerType
  // No FK constraint - polymorphic relation handled in application code

  @@unique([ownerType, ownerId])
  @@map("wallets")
}

enum LedgerTxType {
  DEPOSIT           // 충전
  WITHDRAW          // 출금
  ESCROW_HOLD       // 에스크로 홀드
  ESCROW_RELEASE    // 에스크로 릴리스 (선수에게)
  ESCROW_REFUND     // 에스크로 환불 (브랜드에게)
  PLATFORM_FEE      // 플랫폼 수수료
  ADJUSTMENT        // 수동 조정
  DIRECT_BUY_RESERVE         // 즉시구매 예약 동결
  DIRECT_BUY_RESERVE_RELEASE // 즉시구매 예약 해제
  AUCTION_BID_RESERVE         // 경매 입찰 동결
  AUCTION_BID_RESERVE_RELEASE // 경매 입찰 해제 (outbid/낙찰/만료)
  TOPUP_DEPOSIT               // 충전 결제 완료 시 CREDIT
  TOPUP_REFUND                // 충전 환불 시 DEBIT
}

enum LedgerTxStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model LedgerTx {
  id          String          @id @default(uuid())
  walletId    String          @map("wallet_id")
  type        LedgerTxType
  amount      Decimal         @db.Decimal(18, 0)  // 양수: 입금, 음수: 출금
  balanceAfter Decimal        @map("balance_after") @db.Decimal(18, 0)
  status      LedgerTxStatus  @default(COMPLETED)
  refType     String?         @map("ref_type")  // CONTRACT, ESCROW, PAYOUT 등
  refId       String?         @map("ref_id")
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")

  wallet      Wallet          @relation(fields: [walletId], references: [id])

  @@unique([walletId, type, refType, refId])  // 동일 ref에 대한 중복 트랜잭션 방지
  @@index([walletId, createdAt])
  @@map("ledger_txs")
}

model TopupPayment {
  id                  String              @id @default(uuid())
  walletId            String              @map("wallet_id")
  brandUserId         String              @map("brand_user_id")
  brandId             String              @map("brand_id")

  amount              Decimal             @db.Decimal(18, 0)
  currency            String              @default("KRW")
  status              TopupPaymentStatus  @default(CREATED)

  provider            PaymentProvider
  providerPaymentKey  String?             @unique @map("provider_payment_key")
  providerOrderId     String?             @unique @map("provider_order_id")

  checkoutUrl         String?             @map("checkout_url")
  checkoutExpiresAt   DateTime?           @map("checkout_expires_at")

  paidAt              DateTime?           @map("paid_at")
  failedAt            DateTime?           @map("failed_at")
  canceledAt          DateTime?           @map("canceled_at")

  failureReason       String?             @map("failure_reason")
  failureCode         String?             @map("failure_code")
  rawPayload          Json?               @map("raw_payload")

  idempotencyKey      String              @map("idempotency_key")

  // Phase 10-2: Refund fields
  refundedAmount      Decimal             @default(0) @map("refunded_amount") @db.Decimal(18, 0)
  refundStatus        RefundStatus        @default(NONE) @map("refund_status")
  lastRefundAt        DateTime?           @map("last_refund_at")
  chargebackAt        DateTime?           @map("chargeback_at")

  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  wallet              Wallet              @relation(fields: [walletId], references: [id])
  refundRequests      RefundRequest[]

  @@unique([walletId, idempotencyKey])
  @@index([brandUserId, status, createdAt])
  @@index([provider, providerPaymentKey])
  @@map("topup_payments")
}

// Phase 10-2: Refund Request Model
model RefundRequest {
  id                String              @id @default(uuid())
  topupPaymentId    String              @map("topup_payment_id")
  walletId          String              @map("wallet_id")

  amount            Decimal             @db.Decimal(18, 0)
  reason            String
  status            RefundRequestStatus @default(REQUESTED)

  providerRefundId  String?             @unique @map("provider_refund_id")

  requestedBy       String              @map("requested_by")
  requestedAt       DateTime            @default(now()) @map("requested_at")
  processedBy       String?             @map("processed_by")
  processedAt       DateTime?           @map("processed_at")

  approvedBy        String?             @map("approved_by")
  approvedAt        DateTime?           @map("approved_at")
  rejectedBy        String?             @map("rejected_by")
  rejectedAt        DateTime?           @map("rejected_at")
  rejectionReason   String?             @map("rejection_reason")

  failureReason     String?             @map("failure_reason")
  rawPayload        Json?               @map("raw_payload")

  idempotencyKey    String              @map("idempotency_key")

  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  topupPayment      TopupPayment        @relation(fields: [topupPaymentId], references: [id])
  wallet            Wallet              @relation(fields: [walletId], references: [id])

  @@unique([topupPaymentId, idempotencyKey])
  @@index([walletId, status, createdAt])
  @@map("refund_requests")
}

// ============================================
// Phase 10-3: Webhook Event Logging & Reconciliation
// ============================================

enum WebhookEventStatus {
  RECEIVED      // Webhook 수신, 처리 시작
  PROCESSED     // 정상 처리 완료
  IGNORED       // 무시 (중복, 관련 없는 이벤트)
  FAILED        // 처리 실패
}

model WebhookEventLog {
  id                  String              @id @default(uuid())
  provider            PaymentProvider
  eventType           String              @map("event_type")
  eventId             String              @map("event_id")
  providerPaymentKey  String?             @map("provider_payment_key")
  status              WebhookEventStatus  @default(RECEIVED)
  errorMessage        String?             @map("error_message")
  rawPayload          Json?               @map("raw_payload")
  receivedAt          DateTime            @default(now()) @map("received_at")
  processedAt         DateTime?           @map("processed_at")
  createdAt           DateTime            @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([provider, eventType, createdAt])
  @@index([status, createdAt])
  @@map("webhook_event_logs")
}

enum ReconciliationScope {
  FULL
  CRITICAL_ONLY
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model ReconciliationRun {
  id              String                    @id @default(uuid())
  scope           ReconciliationScope
  fromDate        DateTime                  @map("from_date")
  toDate          DateTime                  @map("to_date")
  totalChecked    Int                       @default(0) @map("total_checked")
  issuesFound     Int                       @default(0) @map("issues_found")
  status          ReconciliationRunStatus   @default(RUNNING)
  errorMessage    String?                   @map("error_message")
  startedAt       DateTime                  @default(now()) @map("started_at")
  completedAt     DateTime?                 @map("completed_at")
  createdAt       DateTime                  @default(now()) @map("created_at")

  issues          ReconciliationIssue[]

  @@index([status, startedAt])
  @@map("reconciliation_runs")
}

enum ReconciliationIssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReconciliationIssueType {
  TOPUP_PAID_NO_LEDGER          // PAID 인데 LedgerTx 없음
  LEDGER_TOPUP_NO_PAID          // LedgerTx 있는데 PAID 아님
  REFUND_REFUNDED_NO_LEDGER     // REFUNDED 인데 LedgerTx 없음
  LEDGER_REFUND_NO_REQUEST      // LedgerTx 있는데 REFUNDED 아님
  REFUNDED_AMOUNT_MISMATCH      // refundedAmount 불일치
  WALLET_NEGATIVE               // 잔액/동결 음수
  VERSION_CONFLICT_SPIKE        // 버전 충돌 급증
}

enum ReconciliationIssueStatus {
  OPEN
  ACKED       // 확인됨
  RESOLVED
  IGNORED
}

model ReconciliationIssue {
  id              String                        @id @default(uuid())
  runId           String                        @map("run_id")
  severity        ReconciliationIssueSeverity
  issueType       ReconciliationIssueType       @map("issue_type")
  relatedTopupId  String?                       @map("related_topup_id")
  relatedRefundId String?                       @map("related_refund_id")
  relatedWalletId String?                       @map("related_wallet_id")
  detail          Json?
  status          ReconciliationIssueStatus     @default(OPEN)
  resolvedBy      String?                       @map("resolved_by")
  resolvedAt      DateTime?                     @map("resolved_at")
  resolvedNote    String?                       @map("resolved_note")
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")

  run             ReconciliationRun             @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, severity])
  @@index([issueType, status])
  @@index([status, createdAt])
  @@map("reconciliation_issues")
}

enum EscrowStatus {
  HELD              // 브랜드 결제 완료, 홀드 중
  RELEASED          // 선수에게 지급 완료
  REFUNDED          // 브랜드에게 환불 완료
  PARTIALLY_RELEASED // 일부 지급 (분쟁 등)
}

model Escrow {
  id              String        @id @default(uuid())
  contractId      String        @unique @map("contract_id")  // 계약당 1개만
  brandId         String        @map("brand_id")
  athleteId       String        @map("athlete_id")
  grossAmount     Decimal       @map("gross_amount") @db.Decimal(18, 0)      // 총 금액
  platformFee     Decimal       @map("platform_fee") @db.Decimal(18, 0)      // 플랫폼 수수료
  platformFeeRate Decimal       @map("platform_fee_rate") @db.Decimal(5, 4)  // 수수료율 (예: 0.1000 = 10%)
  athletePayout   Decimal       @map("athlete_payout") @db.Decimal(18, 0)    // 선수 지급액
  status          EscrowStatus  @default(HELD)
  heldAt          DateTime      @default(now()) @map("held_at")
  releasedAt      DateTime?     @map("released_at")
  refundedAt      DateTime?     @map("refunded_at")
  refundReason    String?       @map("refund_reason")  // 환불 사유
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  contract        Contract      @relation(fields: [contractId], references: [id])
  payoutItems     PayoutItem[]

  @@index([status])
  @@index([brandId])
  @@index([athleteId])
  @@map("escrows")
}

enum PayoutBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PayoutBatch {
  id              String            @id @default(uuid())
  status          PayoutBatchStatus @default(PENDING)
  totalAmount     Decimal           @map("total_amount") @db.Decimal(18, 0)
  itemCount       Int               @map("item_count")
  processedAt     DateTime?         @map("processed_at")
  bankFileUrl     String?           @map("bank_file_url")
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  items           PayoutItem[]

  @@map("payout_batches")
}

model PayoutItem {
  id              String      @id @default(uuid())
  batchId         String      @map("batch_id")
  escrowId        String      @unique @map("escrow_id")  // 에스크로당 1개 지급만
  athleteId       String      @map("athlete_id")
  amount          Decimal     @db.Decimal(18, 0)
  bankName        String?     @map("bank_name")
  bankAccount     String?     @map("bank_account")
  accountHolder   String?     @map("account_holder")
  status          String      @default("PENDING")
  processedAt     DateTime?   @map("processed_at")
  failReason      String?     @map("fail_reason")
  createdAt       DateTime    @default(now()) @map("created_at")

  batch           PayoutBatch @relation(fields: [batchId], references: [id])
  escrow          Escrow      @relation(fields: [escrowId], references: [id])
  athlete         Athlete     @relation(fields: [athleteId], references: [id])

  @@map("payout_items")
}

// ============================================
// Point Shop (포인트 샵)
// ============================================

enum ShopItemStatus {
  ACTIVE
  PAUSED
  SOLDOUT
}

enum RedemptionStatus {
  REQUESTED
  CANCELED
  FULFILLED
}

model ShopItem {
  id                String          @id @default(uuid())
  title             String
  description       String?
  imageUrl          String?         @map("image_url")
  pricePoints       Decimal         @map("price_points") @db.Decimal(18, 0)
  stock             Int             @default(0)
  status            ShopItemStatus  @default(ACTIVE)
  requiresShipping  Boolean         @default(false) @map("requires_shipping")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  orders            RedemptionOrder[]

  @@map("shop_items")
}

model RedemptionOrder {
  id                String            @id @default(uuid())
  userId            String            @map("user_id")
  itemId            String            @map("item_id")
  quantity          Int               @default(1)
  totalPoints       Decimal           @map("total_points") @db.Decimal(18, 0)
  status            RedemptionStatus  @default(REQUESTED)
  idempotencyKey    String?           @unique @map("idempotency_key")
  shippingName      String?           @map("shipping_name")
  shippingPhone     String?           @map("shipping_phone")
  shippingAddress1  String?           @map("shipping_address1")
  shippingAddress2  String?           @map("shipping_address2")
  memo              String?
  fulfilledAt       DateTime?         @map("fulfilled_at")
  fulfilledBy       String?           @map("fulfilled_by")
  canceledAt        DateTime?         @map("canceled_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user              User              @relation(fields: [userId], references: [id])
  item              ShopItem          @relation(fields: [itemId], references: [id])

  @@index([userId, status, createdAt])
  @@map("redemption_orders")
}

// ============================================
// FAQ System (고객지원/FAQ)
// ============================================

enum FaqCategory {
  GENERAL           // 일반
  ACCOUNT           // 계정
  BIDDING           // 입찰
  CONTRACT          // 계약
  PAYMENT           // 결제
  POINTS            // 포인트
  SHOP              // 포인트샵
  ATHLETE           // 선수 전용
  BRAND             // 브랜드 전용
}

model FaqItem {
  id          String      @id @default(uuid())
  category    FaqCategory
  question    String
  answer      String      @db.Text
  orderIndex  Int         @default(0) @map("order_index")
  isPublished Boolean     @default(true) @map("is_published")
  viewCount   Int         @default(0) @map("view_count")
  createdBy   String      @map("created_by")
  updatedBy   String?     @map("updated_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([category, isPublished, orderIndex])
  @@index([isPublished])
  @@map("faq_items")
}

// ============================================
// Penalty System (페널티/참여 제한)
// ============================================

enum PenaltyType {
  ASSET_DEADLINE_MISSED   // 에셋 마감 미준수
  CONTRACT_VIOLATION      // 계약 위반
  VERIFICATION_FAILURE    // 검수 실패
  INAPPROPRIATE_CONTENT   // 부적절한 콘텐츠
  ADMIN_MANUAL            // 관리자 수동 부여
}

enum PenaltyStatus {
  ACTIVE                  // 유효
  EXPIRED                 // 만료됨
  REMOVED                 // 수동 제거됨
}

model Penalty {
  id              String        @id @default(uuid())
  athleteId       String?       @map("athlete_id")
  brandId         String?       @map("brand_id")
  userId          String        @map("user_id")
  type            PenaltyType
  status          PenaltyStatus @default(ACTIVE)
  points          Int           @default(10)
  reason          String
  refType         String?       @map("ref_type")   // CONTRACT, AUCTION, etc.
  refId           String?       @map("ref_id")     // 관련 엔티티 ID
  expiresAt       DateTime?     @map("expires_at")
  removedAt       DateTime?     @map("removed_at")
  removedBy       String?       @map("removed_by")
  removeReason    String?       @map("remove_reason")
  createdBy       String        @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([athleteId, status])
  @@index([brandId, status])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("penalties")
}

// ============================================
// Report/Dispute System (신고/분쟁 관리)
// ============================================

enum ReportType {
  CONTRACT_DISPUTE      // 계약 분쟁
  INAPPROPRIATE_CONTENT // 부적절한 콘텐츠
  FRAUD_SUSPICION       // 사기 의심
  SERVICE_ISSUE         // 서비스 문제
  OTHER                 // 기타
}

enum ReportStatus {
  OPEN                  // 접수됨
  IN_REVIEW             // 검토 중
  PENDING_INFO          // 정보 대기
  ESCALATED             // 에스컬레이션
  RESOLVED              // 해결됨
  DISMISSED             // 기각됨
}

enum ReportPriority {
  LOW                   // 낮음
  MEDIUM                // 보통
  HIGH                  // 높음
  CRITICAL              // 긴급
}

model Report {
  id              String         @id @default(uuid())
  reporterUserId  String         @map("reporter_user_id")
  type            ReportType
  status          ReportStatus   @default(OPEN)
  priority        ReportPriority @default(MEDIUM)
  targetType      String         @map("target_type")  // CONTRACT, BRAND, ATHLETE, USER
  targetId        String         @map("target_id")
  title           String
  description     String         @db.Text
  evidenceUrls    String[]       @map("evidence_urls")
  assignedTo      String?        @map("assigned_to")
  resolution      String?        @db.Text
  resolvedBy      String?        @map("resolved_by")
  resolvedAt      DateTime?      @map("resolved_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  comments        ReportComment[]
  history         ReportHistory[]

  @@index([status, priority, createdAt])
  @@index([reporterUserId])
  @@index([targetType, targetId])
  @@index([assignedTo, status])
  @@map("reports")
}

model ReportComment {
  id          String   @id @default(uuid())
  reportId    String   @map("report_id")
  userId      String   @map("user_id")
  content     String   @db.Text
  isInternal  Boolean  @default(false) @map("is_internal")
  createdAt   DateTime @default(now()) @map("created_at")

  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@map("report_comments")
}

model ReportHistory {
  id          String   @id @default(uuid())
  reportId    String   @map("report_id")
  userId      String   @map("user_id")
  action      String   // STATUS_CHANGE, PRIORITY_CHANGE, ASSIGNED, COMMENT_ADDED
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  createdAt   DateTime @default(now()) @map("created_at")

  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@map("report_history")
}

// ============================================
// Fulfillment System (이행 추적)
// ============================================

enum FulfillmentStatus {
  NOT_STARTED       // 시작 전
  DESIGNING         // 디자인 중
  PRODUCING         // 제작 중
  SHIPPING          // 배송 중
  DELIVERED         // 배송 완료
  ATTACHED          // 부착 완료
}

model ContractFulfillment {
  id                  String            @id @default(uuid())
  contractId          String            @unique @map("contract_id")
  status              FulfillmentStatus @default(NOT_STARTED)

  // 배송 정보
  carrier             String?           // 택배사
  trackingNumber      String?           @map("tracking_number")
  shippedAt           DateTime?         @map("shipped_at")
  deliveredAt         DateTime?         @map("delivered_at")

  // 부착 증빙
  attachmentPhotoUrls String[]          @map("attachment_photo_urls")
  attachedAt          DateTime?         @map("attached_at")

  // 메모/노트
  notes               String?           @db.Text

  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  contract            Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  history             FulfillmentHistory[]

  @@index([status])
  @@map("contract_fulfillments")
}

model FulfillmentHistory {
  id              String            @id @default(uuid())
  fulfillmentId   String            @map("fulfillment_id")
  fromStatus      FulfillmentStatus? @map("from_status")
  toStatus        FulfillmentStatus @map("to_status")
  changedBy       String            @map("changed_by")
  notes           String?           @db.Text
  photoUrls       String[]          @map("photo_urls")
  createdAt       DateTime          @default(now()) @map("created_at")

  fulfillment     ContractFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  @@index([fulfillmentId, createdAt])
  @@map("fulfillment_history")
}

// ============================================
// Withdrawal System (선수 출금)
// ============================================

enum WithdrawalStatus {
  REQUESTED       // 요청됨 (frozenAmount 증가)
  APPROVED        // 승인됨 (은행 이체 대기)
  REJECTED        // 거부됨 (frozenAmount 해제)
  PAID            // 지급 완료 (은행 이체 완료)
}

enum WithdrawalBatchStatus {
  CREATED         // 배치 생성됨
  EXPORTED        // CSV 내보내기 완료
  COMPLETED       // 일괄 지급 완료
  CANCELED        // 취소됨
}

model WithdrawalBatch {
  id                String                  @id @default(uuid())
  status            WithdrawalBatchStatus   @default(CREATED)
  totalAmount       Decimal                 @map("total_amount") @db.Decimal(18, 0)
  itemCount         Int                     @map("item_count")
  createdByAdminId  String                  @map("created_by_admin_id")
  exportedAt        DateTime?               @map("exported_at")
  completedAt       DateTime?               @map("completed_at")
  proofUrl          String?                 @map("proof_url")
  note              String?
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  withdrawals       WithdrawalRequest[]

  @@index([status, createdAt])
  @@map("withdrawal_batches")
}

model WithdrawalRequest {
  id                String            @id @default(uuid())
  walletId          String            @map("wallet_id")
  athleteId         String            @map("athlete_id")
  amount            Decimal           @db.Decimal(18, 0)
  status            WithdrawalStatus  @default(REQUESTED)

  // 은행 정보 (요청 시점의 스냅샷)
  bankName              String            @map("bank_name")
  bankAccountMasked     String            @map("bank_account_masked")
  accountHolder         String            @map("account_holder")

  // 암호화된 계좌 정보 (AES-256-GCM)
  bankAccountEncrypted  String?           @map("bank_account_encrypted")
  bankAccountIv         String?           @map("bank_account_iv")
  bankAccountTag        String?           @map("bank_account_tag")
  bankAccountLast4      String?           @map("bank_account_last4")

  // 처리 정보
  requestedReason   String?           @map("requested_reason")
  adminNote         String?           @map("admin_note")
  payoutReference   String?           @map("payout_reference")

  // 증빙 정보
  proofUrl          String?           @map("proof_url")
  proofUploadedAt   DateTime?         @map("proof_uploaded_at")

  // 처리 관리자 ID (역할별)
  approvedByAdminId String?           @map("approved_by_admin_id")
  rejectedByAdminId String?           @map("rejected_by_admin_id")
  paidByAdminId     String?           @map("paid_by_admin_id")

  // 배치 연결
  batchId           String?           @map("batch_id")

  // 멱등성
  idempotencyKey    String?           @unique @map("idempotency_key")

  // 타임스탬프
  approvedAt        DateTime?         @map("approved_at")
  rejectedAt        DateTime?         @map("rejected_at")
  paidAt            DateTime?         @map("paid_at")
  processedBy       String?           @map("processed_by")

  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relations
  wallet            Wallet            @relation(fields: [walletId], references: [id])
  athlete           Athlete           @relation(fields: [athleteId], references: [id])
  batch             WithdrawalBatch?  @relation(fields: [batchId], references: [id])

  @@index([walletId, status, createdAt])
  @@index([athleteId, status])
  @@index([status, createdAt])
  @@index([batchId])
  @@map("withdrawal_requests")
}

// ============================================
// Phase H: Season Rewards
// ============================================

enum SeasonStatus {
  DRAFT
  UPCOMING
  ACTIVE
  ENDED
  REWARDS_DISTRIBUTED
}

model Season {
  id                 String         @id @default(uuid())
  name               String
  description        String?
  startsAt           DateTime       @map("starts_at")
  endsAt             DateTime       @map("ends_at")
  status             SeasonStatus   @default(DRAFT)

  // 보상 티어 설정 (JSON: [{rank: 1-3, rewardPoints: 10000}, ...])
  rewardTiers        Json           @map("reward_tiers") @default("[]")
  participationBonus Int            @default(0) @map("participation_bonus")

  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  participants       SeasonParticipant[]
  badges             SeasonBadge[]

  @@index([status, startsAt])
  @@map("seasons")
}

model SeasonParticipant {
  id                   String    @id @default(uuid())
  seasonId             String    @map("season_id")
  userId               String    @map("user_id")

  // 참여 통계
  voteParticipations   Int       @default(0) @map("vote_participations")
  correctPredictions   Int       @default(0) @map("correct_predictions")
  totalPointsEarned    Decimal   @default(0) @map("total_points_earned") @db.Decimal(18, 0)

  // 랭킹
  currentRank          Int?      @map("current_rank")

  // 보상 배포
  rewardDistributedAt  DateTime? @map("reward_distributed_at")
  rewardPoints         Decimal?  @map("reward_points") @db.Decimal(18, 0)

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  season               Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  badgeAwards          SeasonBadgeAward[]

  @@unique([seasonId, userId])
  @@index([seasonId, totalPointsEarned(sort: Desc)])
  @@index([seasonId, currentRank])
  @@map("season_participants")
}

enum BadgeType {
  SEASON_GOLD
  SEASON_SILVER
  SEASON_BRONZE
  SEASON_TOP10
  SEASON_TOP100
  PARTICIPATION
  VOTE_MASTER
  SHOP_VIP
  STREAK
}

model SeasonBadge {
  id          String    @id @default(uuid())
  seasonId    String    @map("season_id")
  badgeType   BadgeType @map("badge_type")
  name        String
  description String?
  iconUrl     String?   @map("icon_url")
  requirement Json?     // 획득 조건 JSON

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  season      Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  awards      SeasonBadgeAward[]

  @@unique([seasonId, badgeType])
  @@map("season_badges")
}

model SeasonBadgeAward {
  id            String            @id @default(uuid())
  participantId String            @map("participant_id")
  badgeId       String            @map("badge_id")
  awardedAt     DateTime          @default(now()) @map("awarded_at")

  // Relations
  participant   SeasonParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  badge         SeasonBadge       @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([participantId, badgeId])
  @@map("season_badge_awards")
}

// ============================================
// Phase 11-2A: Billing / Statements / Tax Invoice
// ============================================

model BillingProfile {
  id                  String    @id @default(uuid())
  brandId             String    @unique @map("brand_id")

  businessName        String    @map("business_name")       // 상호
  businessNumber      String    @map("business_number")     // 사업자등록번호
  representativeName  String    @map("representative_name") // 대표자명
  businessType        String?   @map("business_type")       // 업태
  businessCategory    String?   @map("business_category")   // 업종

  billingEmail        String    @map("billing_email")
  billingPhone        String?   @map("billing_phone")
  address             String
  addressDetail       String?   @map("address_detail")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  brand               Brand     @relation(fields: [brandId], references: [id])
  taxInvoiceRequests  TaxInvoiceRequest[]

  @@map("billing_profiles")
}

enum DocumentExportType {
  STATEMENT_CSV
  STATEMENT_PDF
  TAX_INVOICE_PDF
}

model DocumentExportLog {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  brandId     String              @map("brand_id")
  exportType  DocumentExportType  @map("export_type")
  fromDate    DateTime            @map("from_date")
  toDate      DateTime            @map("to_date")
  itemCount   Int                 @map("item_count")
  ipAddress   String?             @map("ip_address")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([brandId, createdAt])
  @@map("document_export_logs")
}

enum TaxInvoiceStatus {
  REQUESTED
  APPROVED
  ISSUED
  REJECTED
}

model TaxInvoiceRequest {
  id                  String            @id @default(uuid())
  billingProfileId    String            @map("billing_profile_id")
  fromDate            DateTime          @map("from_date")
  toDate              DateTime          @map("to_date")
  supplyAmount        Decimal           @db.Decimal(18, 0) @map("supply_amount")
  taxAmount           Decimal           @db.Decimal(18, 0) @map("tax_amount")
  totalAmount         Decimal           @db.Decimal(18, 0) @map("total_amount")

  status              TaxInvoiceStatus  @default(REQUESTED)
  requestedAt         DateTime          @default(now()) @map("requested_at")
  approvedBy          String?           @map("approved_by")
  approvedAt          DateTime?         @map("approved_at")
  rejectedBy          String?           @map("rejected_by")
  rejectedAt          DateTime?         @map("rejected_at")
  rejectionReason     String?           @map("rejection_reason")
  issuedBy            String?           @map("issued_by")
  issuedAt            DateTime?         @map("issued_at")
  invoiceNumber       String?           @unique @map("invoice_number")

  idempotencyKey      String            @unique @map("idempotency_key")
  createdAt           DateTime          @default(now()) @map("created_at")

  billingProfile      BillingProfile    @relation(fields: [billingProfileId], references: [id])

  @@index([status, requestedAt])
  @@map("tax_invoice_requests")
}
