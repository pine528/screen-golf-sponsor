// ============================================
// System Settings
// ============================================

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================================
// Notification
// ============================================

enum NotificationType {
  BID_PLACED
  BID_OUTBID
  AUCTION_WON
  AUCTION_LOST
  AUCTION_ENDING_SOON
  CONTRACT_CREATED
  ASSET_SUBMITTED
  ASSET_APPROVED
  ASSET_REJECTED
  VERIFICATION_SUBMITTED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  SETTLEMENT_COMPLETED
  KYC_APPROVED
  KYC_REJECTED
  ADMIN_ALERT
  BRAND_REGISTRATION_SUBMITTED
  BRAND_REGISTRATION_APPROVED
  BRAND_REGISTRATION_REJECTED
  FAN_VOTE_SUBMITTED
  FAN_VOTE_APPROVED
  FAN_VOTE_SETTLED
  FAN_VOTE_WIN
  FAN_VOTE_DELETED
  REDEMPTION_FULFILLED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_PAID
  AGENCY_CONNECTION_REQUEST
  AGENCY_CONNECTION_APPROVED
  AGENCY_CONNECTION_REJECTED
  AGENCY_CONNECTION_CANCELLED
}

model Notification {
