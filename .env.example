# ================================================
# Screen Golf Sponsor Marketplace - Environment Variables
# ================================================
# Copy this file to .env and fill in the values

# ------------------------------------------------
# Database
# ------------------------------------------------
POSTGRES_USER=sponsor
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=sponsor_marketplace

# Full database URL (constructed from above or custom)
DATABASE_URL=postgresql://sponsor:your_strong_password_here@postgres:5432/sponsor_marketplace

# ------------------------------------------------
# JWT Secrets (generate with: openssl rand -base64 64)
# ------------------------------------------------
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
JWT_REFRESH_SECRET=your_refresh_secret_here_minimum_32_characters

# ------------------------------------------------
# Application
# ------------------------------------------------
NODE_ENV=production

# API Port (backend)
API_PORT=4000

# Web Port (frontend)
WEB_PORT=3000

# Proxy Port (nginx reverse proxy)
PROXY_PORT=80
PROXY_SSL_PORT=443

# ------------------------------------------------
# CORS
# ------------------------------------------------
# Allowed origins for CORS (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# ------------------------------------------------
# Frontend Build
# ------------------------------------------------
# API URL as seen from the browser
VITE_API_URL=http://localhost:4000/api
# Or for production with reverse proxy:
# VITE_API_URL=/api

# ------------------------------------------------
# Redis (optional - for caching)
# ------------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------------
# File Upload
# ------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10mb

# ------------------------------------------------
# Email (optional - for notifications)
# ------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM=noreply@yourdomain.com

# ------------------------------------------------
# Payment Gateway (optional - for production)
# ------------------------------------------------
# PG_PROVIDER=toss
# PG_CLIENT_KEY=your_pg_client_key
# PG_SECRET_KEY=your_pg_secret_key

# ------------------------------------------------
# AWS S3 (optional - for production file storage)
# ------------------------------------------------
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=ap-northeast-2
# AWS_S3_BUCKET=your-bucket-name

# ------------------------------------------------
# Sentry (error tracking - recommended for production)
# ------------------------------------------------
# Get DSN from https://sentry.io
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Git commit SHA for release tracking
SENTRY_RELEASE=

# ------------------------------------------------
# Seed Control (default: false in production)
# ------------------------------------------------
# Set to 'true' to run seed on container start
RUN_SEED=false
