# ============================================
# 필수 환경변수
# ============================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/screengolf?schema=public"

# JWT (프로덕션에서 반드시 변경!)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"

# ============================================
# 프로덕션 필수 환경변수
# ============================================

# 계좌 암호화 키 (32바이트 base64)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BANK_ACCOUNT_ENC_KEY=

# CORS (프로덕션에서 실제 프론트엔드 URL로 변경)
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ============================================
# 결제 연동 (사용할 Provider만 설정)
# ============================================

# Toss Payments (한국 결제)
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=
TOSS_CLIENT_KEY=

# Stripe (글로벌 결제 - 선택)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# ============================================
# 선택사항 (기본값 있음)
# ============================================

# Server
PORT=3000
NODE_ENV=development

# JWT 만료 시간
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# 경매 설정
DEFAULT_SOFT_CLOSE_SEC=120
DEFAULT_MAX_EXTENSION_SEC=600
DEFAULT_MIN_BID_INCREMENT=10000
DEFAULT_MIN_BID_INCREMENT_PERCENT=1

# 플랫폼 수수료 (20%)
PLATFORM_FEE_RATE=0.20

# 파일 업로드
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# ============================================
# 외부 서비스 (선택)
# ============================================

# Cloudinary (이미지 업로드)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Sentry (에러 모니터링)
# SENTRY_DSN=

# SMTP (이메일)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
