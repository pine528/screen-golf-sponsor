# Database (docker-compose 기준)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/screengolf?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# Auction Settings
DEFAULT_SOFT_CLOSE_SEC=120
DEFAULT_MAX_EXTENSION_SEC=600
DEFAULT_MIN_BID_INCREMENT=10000
DEFAULT_MIN_BID_INCREMENT_PERCENT=1

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Email (Optional - SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@screengolf.com

# Cloudinary (Optional - Image Upload)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
