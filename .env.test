# Test Environment Variables
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/screengolf_test?schema=public
NODE_ENV=test

# JWT (테스트용 고정값)
JWT_SECRET=test-jwt-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=test-refresh-secret-minimum-32-characters

# API Port (테스트 시 사용하지 않음 - supertest가 직접 앱 호출)
API_PORT=4001

# CORS
CORS_ORIGIN=http://localhost:3000

# File Upload
UPLOAD_DIR=./uploads-test
MAX_FILE_SIZE=10mb
